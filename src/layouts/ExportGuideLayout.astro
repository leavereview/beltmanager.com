---
// Export guides (issue #30): the vendor's own documented steps, then the BeltManager import, then dated sources.
import BaseLayout from './BaseLayout.astro';
import BreadcrumbsEnhanced from '../components/seo/BreadcrumbsEnhanced.astro';
import ImportSteps from '../components/ImportSteps.astro';
import { appLink } from '../utils/appLink';
import { exportGuides } from '../utils/exportGuides';

interface Props {
  title: string;
  description: string;
  heading: string;
  crumb: string;
  locale: 'us' | 'uk';
  /** Date shown on the page, in the spelling and order the audience expects. */
  checked: string;
  sources: { label: string; url: string; note: string }[];
  ctaHeading: string;
}

const { title, description, heading, crumb, locale, checked, sources, ctaHeading } = Astro.props;
const others = exportGuides.filter((guide) => guide.href !== Astro.url.pathname);
---
<BaseLayout title={title} description={description} type="article" modifiedDate="2026-11-06">
  <BreadcrumbsEnhanced
    site="beltmanager"
    items={[
      { label: 'Home', href: '/' },
      { label: 'Switching', href: '/switching/' },
      { label: crumb, href: Astro.url.pathname },
    ]}
  />
  <section class="section bg-white">
    <div class="container-custom max-w-3xl">
      <h1 class="text-4xl font-bold text-brand-navy mb-4">{heading}</h1>
      <p class="text-sm text-gray-500 mb-8">Last checked {checked}. Menus change, so check the linked help pages if a step looks different.</p>
      <div class="prose max-w-none export-guide">
        <slot />
        <ImportSteps locale={locale} />
        <h2>Sources</h2>
        <ul>
          {sources.map((source) => (
            <li><a href={source.url} rel="nofollow noopener">{source.label}</a>. {source.note}</li>
          ))}
        </ul>
        <p class="text-sm text-gray-500">
          BeltManager isn't affiliated with the company named on this page. Product names belong to their owners.
        </p>
        <h2>Other export guides</h2>
        <ul>
          {others.map((guide) => <li><a href={guide.href}>{guide.label}</a></li>)}
        </ul>
      </div>
      <div class="mt-10 rounded-xl bg-gray-50 p-8 text-center">
        <h2 class="text-2xl font-bold text-brand-navy mb-4">{ctaHeading}</h2>
        <a href={appLink(Astro.url.pathname, 'guide-bottom')} class="btn-primary">Get started free</a>
        <p class="mt-3 text-sm text-gray-500">Free until 31 March 2027. No credit card.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .export-guide ol { list-style: decimal; padding-left: 1.5rem; }
  .export-guide ul { list-style: disc; padding-left: 1.5rem; }
  .export-guide table { width: 100%; margin: 1.5rem 0; border-collapse: collapse; }
  .export-guide th,
  .export-guide td { padding: 0.5rem 0.75rem; border: 1px solid #e5e7eb; text-align: left; vertical-align: top; }
</style>
