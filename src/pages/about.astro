---
// About page — company/team focused (no individual bio)
import { appLink } from '../utils/appLink';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "JOHN POWELL LTD",
  "alternateName": "BeltManager",
  "url": "https://beltmanager.com",
  "logo": "https://beltmanager.com/logo.svg",
  "foundingDate": "2005-03-31",
  "description": "UK-registered software development company providing vertical SaaS solutions for martial arts schools and dojos",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "124 City Road",
    "addressLocality": "London",
    "postalCode": "EC1V 2NX",
    "addressCountry": "GB"
  },
  "sameAs": [
    "https://find-and-update.company-information.service.gov.uk/company/05408918"
  ]
};
---

<BaseLayout
  title="About BeltManager"
  description="BeltManager is built by the UK software team behind RevelationPets. Learn who we are, what we build for martial arts schools and how to reach us."
>
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} is:inline />

  <div class="bg-gray-100 py-3">
    <div class="container-custom">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'About' }
      ]} />
    </div>
  </div>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-brand-navy to-gray-900 text-white py-16 md:py-24">
    <div class="container-custom">
      <div class="max-w-3xl">
        <span class="badge-primary mb-6">About</span>
        <h1 class="text-4xl md:text-5xl font-bold mb-6">The team behind BeltManager</h1>
        <p class="text-xl text-gray-300 leading-relaxed">
          We are a small UK software team that builds management software for service businesses. BeltManager brings that experience to <a href="/martial-arts-software/" class="text-brand-red hover:underline">martial arts schools</a>: less admin, easier class scheduling and a clear view of every student's belt progress.
        </p>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">

        <!-- Who we are -->
        <div class="mb-16">
          <h2 class="text-3xl font-bold text-brand-navy mb-6">Who we are</h2>
          <div class="space-y-4 text-gray-600 text-lg leading-relaxed">
            <p>
              BeltManager is built and supported by the same team that created <strong class="text-brand-navy">RevelationPets</strong>, a booking and management platform used by pet care facilities in several countries, and <strong class="text-brand-navy">PetCare.Software</strong>.
            </p>
            <p>
              Over that time we learned what small service businesses actually need from software: simple scheduling, reminders that cut no-shows, records that are easy to find, and a supplier that answers when you ask for something. We are applying the same approach to martial arts.
            </p>
          </div>
        </div>

        <!-- Principles -->
        <div class="mb-16">
          <h2 class="text-3xl font-bold text-brand-navy mb-6">How we work</h2>
          <div class="grid md:grid-cols-2 gap-6">
            <div class="card">
              <h3 class="font-bold text-brand-navy mb-2">Built for the instructor's day</h3>
              <p class="text-gray-600 text-sm">Student records, belt progression, class scheduling and communications live in one place, so you are not juggling a spreadsheet, a schedule and a notes app.</p>
            </div>
            <div class="card">
              <h3 class="font-bold text-brand-navy mb-2">Automation that stays out of the way</h3>
              <p class="text-gray-600 text-sm">We automate the admin, such as reminders and follow-ups, while the relationship between instructor and student stays yours.</p>
            </div>
            <div class="card">
              <h3 class="font-bold text-brand-navy mb-2">Responsive support</h3>
              <p class="text-gray-600 text-sm">Real people read every message. If something is missing or does not work the way your school runs, tell us and we will look at it.</p>
            </div>
            <div class="card">
              <h3 class="font-bold text-brand-navy mb-2">Honest about what the product does</h3>
              <p class="text-gray-600 text-sm">We only describe features that exist today and say clearly when something is still coming, such as US card billing, which is coming in 2027.</p>
            </div>
          </div>
        </div>

        <!-- What the platform handles -->
        <div class="mb-16">
          <h2 class="text-3xl font-bold text-brand-navy mb-4">What BeltManager handles</h2>
          <ul class="text-gray-600 space-y-2 list-disc list-inside">
            <li>Student and family records</li>
            <li>Belt progression tracking and belt tests</li>
            <li>Class schedules and online booking</li>
            <li>Automated reminders and communications</li>
            <li>Lead management and follow-up</li>
            <li>Payment tracking and family invoicing (US card billing is coming in 2027)</li>
          </ul>
        </div>

        <!-- Company Information -->
        <div class="mb-16 bg-gray-50 rounded-2xl p-8">
          <h2 class="text-3xl font-bold text-brand-navy mb-6">Company information</h2>
          <p class="text-gray-600 mb-6">
            BeltManager is a trading name of <strong class="text-brand-navy">JOHN POWELL LTD</strong>, a UK-registered software development company established in 2005.
          </p>

          <div class="grid md:grid-cols-2 gap-6 mb-6">
            <div class="bg-white rounded-xl p-4">
              <div class="text-sm text-gray-500 mb-1">Company Number</div>
              <div class="font-bold text-brand-navy">05408918</div>
            </div>
            <div class="bg-white rounded-xl p-4">
              <div class="text-sm text-gray-500 mb-1">Incorporated</div>
              <div class="font-bold text-brand-navy">March 31, 2005</div>
            </div>
            <div class="bg-white rounded-xl p-4">
              <div class="text-sm text-gray-500 mb-1">Registered Office</div>
              <div class="font-bold text-brand-navy">124 City Road, London, EC1V 2NX</div>
            </div>
            <div class="bg-white rounded-xl p-4">
              <div class="text-sm text-gray-500 mb-1">Nature of Business</div>
              <div class="font-bold text-brand-navy">Business & domestic software development</div>
            </div>
          </div>

          <a
            href="https://find-and-update.company-information.service.gov.uk/company/05408918"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-brand-red hover:text-brand-red-dark font-medium"
          >
            View full company details on Companies House
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
          </a>
        </div>

        <!-- Connect -->
        <div class="text-center">
          <h2 class="text-3xl font-bold text-brand-navy mb-6">Get in touch</h2>
          <a href="/contact/" class="btn-primary">Contact us</a>
        </div>

      </div>
    </div>
  </section>

  <!-- Explore Our Platform -->
  <section class="section bg-gray-50">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <h2 class="text-3xl font-bold text-brand-navy mb-4">Explore Our Platform</h2>
        <p class="text-lg text-gray-600">BeltManager is built for every type of martial arts school. Explore the solution that fits your discipline.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a href="/martial-arts-software/" class="block p-5 bg-white rounded-xl border border-gray-200 hover:border-brand-red hover:shadow-md transition-all">
          <h3 class="font-bold text-brand-navy mb-1">Martial Arts Software</h3>
          <p class="text-sm text-gray-600">The complete all-in-one platform for any martial arts school — scheduling, billing, and student management.</p>
        </a>
        <a href="/dojo-management-software/" class="block p-5 bg-white rounded-xl border border-gray-200 hover:border-brand-red hover:shadow-md transition-all">
          <h3 class="font-bold text-brand-navy mb-1">Dojo Management Software</h3>
          <p class="text-sm text-gray-600">Run every aspect of your dojo from a single dashboard — classes, members, payments, and communications.</p>
        </a>
        <a href="/karate-school-software/" class="block p-5 bg-white rounded-xl border border-gray-200 hover:border-brand-red hover:shadow-md transition-all">
          <h3 class="font-bold text-brand-navy mb-1">Karate School Software</h3>
          <p class="text-sm text-gray-600">Kyu/Dan belt tracking, kata management, belt tests, and family account billing for karate schools.</p>
        </a>
        <a href="/mma-gym-software/" class="block p-5 bg-white rounded-xl border border-gray-200 hover:border-brand-red hover:shadow-md transition-all">
          <h3 class="font-bold text-brand-navy mb-1">MMA Gym Software</h3>
          <p class="text-sm text-gray-600">Multi-discipline schedules, a belt ladder per discipline, and membership management for MMA and combat sports gyms.</p>
        </a>
        <a href="/bjj-gym-software/" class="block p-5 bg-white rounded-xl border border-gray-200 hover:border-brand-red hover:shadow-md transition-all">
          <h3 class="font-bold text-brand-navy mb-1">BJJ Gym Software</h3>
          <p class="text-sm text-gray-600">IBJJF belt system, stripe tracking, and competition records for Brazilian Jiu-Jitsu academies.</p>
        </a>
        <a href="/martial-arts-crm/" class="block p-5 bg-white rounded-xl border border-gray-200 hover:border-brand-red hover:shadow-md transition-all">
          <h3 class="font-bold text-brand-navy mb-1">Martial Arts CRM</h3>
          <p class="text-sm text-gray-600">Convert inquiries into enrollments and retain members longer with built-in lead management and follow-up automation.</p>
        </a>
        <a href="/martial-arts-billing-software/" class="block p-5 bg-white rounded-xl border border-gray-200 hover:border-brand-red hover:shadow-md transition-all">
          <h3 class="font-bold text-brand-navy mb-1">Martial Arts Billing Software</h3>
          <p class="text-sm text-gray-600">Family invoices, sibling discounts and failed-payment follow-up for martial arts schools, with US card billing coming in 2027.</p>
        </a>
        <a href="/martial-arts-scheduling-software/" class="block p-5 bg-white rounded-xl border border-gray-200 hover:border-brand-red hover:shadow-md transition-all">
          <h3 class="font-bold text-brand-navy mb-1">Martial Arts Scheduling Software</h3>
          <p class="text-sm text-gray-600">Class schedules, online booking, belt test scheduling, and automated reminders for any school size.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section bg-gradient-to-r from-brand-red to-brand-red-dark text-white">
    <div class="container-custom text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">
        Ready to simplify your martial arts school admin?
      </h2>
      <p class="text-xl text-white/90 mb-8 max-w-2xl mx-auto">
        See how BeltManager handles scheduling, belt progression and reminders in one place.
      </p>
      <a href={appLink(Astro.url.pathname, 'bottom')} class="btn bg-white text-brand-red hover:bg-gray-100 text-lg px-8 py-4">
        Get started free
      </a>
    </div>
  </section>
</BaseLayout>
