---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbsEnhanced from '../../components/seo/BreadcrumbsEnhanced.astro';
import { appLink } from '../../utils/appLink';
import { exportGuides } from '../../utils/exportGuides';
---
<BaseLayout
  title="Switching to BeltManager: Export Guides"
  description="Step-by-step guides to getting your student list out of your current martial arts software and into BeltManager with a CSV file. Free until 31 March 2027."
>
  <BreadcrumbsEnhanced
    site="beltmanager"
    items={[
      { label: 'Home', href: '/' },
      { label: 'Switching', href: '/switching/' },
    ]}
  />
  <section class="section bg-white">
    <div class="container-custom max-w-3xl">
      <h1 class="text-4xl font-bold text-brand-navy mb-4">Switching to BeltManager</h1>
      <p class="text-lg text-gray-600 mb-8">
        BeltManager imports your student list from a CSV file. These guides cover getting that file out of the system you use now,
        using that system's own help pages, and then importing it.
      </p>
      <ul class="space-y-4 mb-8">
        {exportGuides.map((guide) => (
          <li class="card p-6"><a href={guide.href} class="link font-semibold">{guide.label}</a></li>
        ))}
      </ul>
      <p class="text-gray-600 mb-8">
        Using a spreadsheet or another system? The import works with any CSV file. Sign in, go to Students, select Import and
        download the template.
      </p>
      <a href={appLink(Astro.url.pathname, 'switching-bottom')} class="btn-primary">Get started free</a>
    </div>
  </section>
</BaseLayout>
