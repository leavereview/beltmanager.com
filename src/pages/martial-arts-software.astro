  />

  <FAQEnhanced
    site="beltmanager"
    pageUrl="https://beltmanager.com/martial-arts-software/"
    title="Frequently Asked Questions About Martial Arts Software"
    faqs={faqItems}
  />

  <section class="section bg-navy text-white">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">
          Ready to Transform Your Dojo Operations?
        </h2>
        <p class="text-xl mb-8 text-gray-300">
          Belt tracking, gradings, registers and a free parent app, all free until 31 March 2027. Get started free today.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="https://app.beltmanager.com/signin" class="btn-primary">Get started free</a>
          <a href="/pricing/" class="btn-secondary bg-white text-navy hover:bg-gray-100">View Pricing</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

