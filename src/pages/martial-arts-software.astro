---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbsEnhanced from '../components/seo/BreadcrumbsEnhanced.astro';
import FeaturedAnswer from '../components/seo/FeaturedAnswer.astro';
import ComparisonTable from '../components/seo/ComparisonTable.astro';
import FAQEnhanced from '../components/seo/FAQEnhanced.astro';
import AppScreenshot from '../components/AppScreenshot.astro';

const comparisonData = [
  {
    label: 'Belt/Rank Progression Tracking',
    values: [true, false, 'Spreadsheets'],
    highlight: true
  },
  {
    label: 'Techniques and Kata per Belt',
    values: [true, false, false],
    highlight: true
  },
  {
    label: 'Grading Eligibility (time at belt + sessions)',
    values: [true, false, false],
    highlight: true
  },
  {
    label: 'Family Accounts with Guardians',
    values: [true, 'Varies', 'Manual'],
    highlight: true
  },
  {
    label: 'Printable Rank Certificates',
    values: [true, false, 'Hand-written']
  },
  {
    label: 'Recurring Class Timetable',
    values: [true, true, 'Paper calendar']
  },
  {
    label: 'Register and Attendance Report',
    values: [true, true, 'Clipboard']
  },
  {
    label: 'Automatic Class Reminders (Email & App Push)',
    values: [true, 'Varies', false]
  },
  {
    label: 'Free Parent App',
    values: [true, 'Often a paid add-on', false]
  },
  {
    label: 'Recurring Card Billing',
    values: ['Coming April 2027', true, 'Manual collection']
  }
];

const faqItems = [
  {
    question: "What is martial arts software?",
    answer: "Martial arts software is a management platform built for dojos, academies and combat sports gyms. Unlike generic gym software, it understands belts and grades, grading eligibility, families with several children training, and martial arts terminology. BeltManager brings your students, families, belts, timetable, registers and gradings into one system.",
    links: [
      { text: 'View features', url: '/martial-arts-software/' },
      { text: 'See pricing', url: '/pricing/' }
    ]
  },
  {
    question: "How much does martial arts software cost?",
    answer: "When we checked competitors' published pricing in November 2026, the main martial arts platforms ranged from about $49 to $350 a month, depending on student numbers and features, and some charge extra for a branded app. BeltManager is free until 31 March 2027, with no subscription, no commission and no per-student charges.",
    links: [
      { text: 'View pricing', url: '/pricing/' },
      { text: 'Contact us', url: '/contact/' }
    ]
  },
  {
    question: "What features does BeltManager have today?",
    answer: "Student and family records with guardians; student import from a spreadsheet; belt and rank tracking with grading eligibility; grading days with printable rank certificates and a promotion notice to families; a recurring class timetable with term dates and closure notices; offline-safe registers and a PIN-locked tablet kiosk; an attendance report with CSV export; a free parent app with RSVPs and push notifications; leads and an online join form; staff roles; and an insurance compliance report. Automatic card billing is coming in April 2027.",
    links: [
      { text: 'Scheduling features', url: '/martial-arts-scheduling-software/' },
      { text: 'Billing features', url: '/martial-arts-billing-software/' }
    ]
  },
  {
    question: "Can BeltManager track belt progression and gradings?",
    answer: "Yes. You set up your own belt system (Kyu/Dan, coloured belts, stripes), the techniques and kata for each belt, and how long and how many sessions a student needs before grading. BeltManager shows who is ready, lets you run a grading day and record results, prints a rank certificate for each promotion, and tells the family by email and app push.",
    links: [
      { text: 'Karate features', url: '/karate-school-software/' },
      { text: 'BJJ features', url: '/bjj-gym-software/' }
    ]
  },
  {
    question: "How long does it take to get started?",
    answer: "Sign-up is self-serve. Add your classes and belts, then import your students from a spreadsheet: up to 1,000 rows at a time, with their guardians. If something looks wrong, you can undo an import within 24 hours. How long the whole switch takes depends on your school.",
    links: [
      { text: 'Get started free', url: 'https://app.beltmanager.com/signin' },
      { text: 'See pricing', url: '/pricing/' }
    ]
  },
  {
    question: "Does BeltManager work for multiple locations?",
    answer: "Yes. Add as many venues and rooms as you need. Each class belongs to a venue, and you can filter your dashboard by venue. Students and families sit in one database across all of them.",
    links: [
      { text: 'Dojo management', url: '/dojo-management-software/' },
      { text: 'Contact us', url: '/contact/' }
    ]
  },
  {
    question: "What payment methods does BeltManager support?",
    answer: "Today you can set up membership plans and record payments by hand, and export an accountant-ready revenue CSV. Automatic card billing through Stripe is coming in April 2027. Direct Debit isn't available.",
    links: [
      { text: 'Billing features', url: '/martial-arts-billing-software/' },
      { text: 'See pricing', url: '/pricing/' }
    ]
  },
  {
    question: "Can students book classes online?",
    answer: "Not as open booking. You enrol students into their groups, and families then RSVP to those classes with one tap in the free parent app or the web portal. There's no booking calendar or waitlist today.",
    links: [
      { text: 'Scheduling software', url: '/martial-arts-scheduling-software/' },
      { text: 'Get started free', url: 'https://app.beltmanager.com/signin' }
    ]
  },
  {
    question: "What reports are available?",
    answer: "An attendance report by class and student for any date range, with CSV export; a list of at-risk and inactive students; an insurance compliance report (instructor-to-student ratio and insured student count); a dashboard of the last 30 days; and an accountant-ready revenue CSV for any date range.",
    links: [
      { text: 'CRM features', url: '/martial-arts-crm/' },
      { text: 'Contact us', url: '/contact/' }
    ]
  },
  {
    question: "Does BeltManager integrate with other tools?",
    answer: "Families can add your class timetable to Apple Calendar or Google Calendar with a calendar feed, and you can export attendance and revenue as CSV files for your spreadsheet or accountant. There's no Zapier, Xero or QuickBooks connection today.",
    links: [
      { text: 'Overview', url: '/martial-arts-software/' },
      { text: 'Get started free', url: 'https://app.beltmanager.com/signin' }
    ]
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.slice(0, 8).map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};

const breadcrumbItems = [
  { label: 'Home', url: 'https://beltmanager.com/' },
  { label: 'Martial Arts Software', url: 'https://beltmanager.com/martial-arts-software/' }
];
---

<BaseLayout
  title="Martial Arts Management Software for Dojos & Gyms"
  description="Belt progression, gradings, class timetables, registers and a free parent app in one platform built for martial arts schools. Free until 31 March 2027."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <BreadcrumbsEnhanced site="beltmanager" items={breadcrumbItems} />

  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block bg-red-50 text-red-600 px-4 py-2 rounded-full text-sm font-semibold mb-6">
          Complete Platform Guide
        </span>
        <h1 class="text-4xl md:text-5xl font-bold text-navy mb-6">
          Martial Arts Software
        </h1>
        <p class="text-xl text-gray-600 mb-8">
          One management platform for dojos, academies and combat sports gyms. Belt tracking, gradings, timetables, registers and families, all in one system.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="https://app.beltmanager.com/signin" class="btn-primary">Get started free</a>
          <a href="/pricing/" class="btn-secondary">View Pricing</a>
        </div>
      </div>
    </div>
  </section>

  <FeaturedAnswer question="What is martial arts software?">
    Martial arts software is a management platform for dojos and combat sports gyms. It holds student and family records, tracks belt progression and grading eligibility, runs the class timetable and registers, and keeps parents informed through reminders, RSVPs and a parent app.
  </FeaturedAnswer>

  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto prose prose-lg">
        <h2>What Is Martial Arts Software?</h2>
        <p>
          Martial arts software is a management platform designed for dojos, academies and combat sports gyms. Unlike generic gym software or retail point-of-sale systems, it is built around the things that make a martial arts school different: belts and grades, gradings, and families with several children training.
        </p>
        <p>
          Running a martial arts school involves far more than teaching techniques. Between tracking students through their belts, keeping the timetable straight, chasing payments and keeping parents informed, the admin eats into time you'd rather spend on the mat. Good software brings those jobs into one place.
        </p>

        <AppScreenshot src="/images/app/dojo-dashboard.webp" width={1600} height={1220} caption="The BeltManager dashboard: active and trial students, who is ready for their next belt, and attendance over the last 30 days, filterable by venue" />

        <h2>The Problem It Solves</h2>
        <p>
          Without dedicated software, student records end up scattered across paper files and spreadsheets, gradings are tracked by memory, registers live on clipboards that nobody analyses, and parents are kept up to date through personal texts and WhatsApp groups.
        </p>
        <p>
          Each of these creates extra work and room for mistakes. A parent who didn't hear the class was cancelled, or a student who was ready to grade but got missed, wears away trust over time.
        </p>

        <h2>Who Needs Martial Arts Management Software?</h2>
        <p>
          There's no magic number of students. Schools usually look for software when the spreadsheet stops keeping up: when you add a second venue or more classes, take on instructors, run gradings for lots of students at once, or simply want your evenings back.
        </p>

        <AppScreenshot src="/images/app/dojo-belt-progression.webp" width={840} height={1560} caption="A student's training record: readiness for the next belt (days at belt, sessions and techniques), the technique checklist and promotion history" />

        <h2>Belt and Rank Progression Tracking</h2>
        <p>
          Belt tracking is the most martial arts-specific part of any management platform. In BeltManager you set up your own belt system, with colours and stripes, and the techniques and kata for each belt. You set how long a student must spend at a belt and how many sessions they need before grading, and BeltManager shows who is ready, almost ready, or not yet ready.
        </p>
        <p>
          Run a grading day, record the results, and print a rank certificate for each promotion. Families get a promotion notice by email and through the parent app. If you teach more than one style, each style keeps its own belt system while sharing one student database.
        </p>

        <h2>Scheduling and Attendance</h2>
        <p>
          Set up recurring classes by day and time, at as many venues and rooms as you need. Add term dates and closed periods, and families are told automatically when a class is cancelled, moved or closed. Set a minimum and maximum belt and an age range on each group, and BeltManager warns you if you add a student outside it.
        </p>
        <p>
          Take the register on a tablet or phone. It keeps working if the signal drops and syncs later. Add walk-ins on the spot, or set up a PIN-locked tablet kiosk where students check themselves in. The attendance report shows attendance by class and student for any date range, with CSV export, and attendance feeds straight into grading eligibility.
        </p>

        <AppScreenshot src="/images/app/billing-overdue.webp" width={1600} height={769} caption="Card billing, switching on in April 2027: overdue invoices, automatic card retries, failed cards flagged, and an optional late fee" />

        <h2>Billing and Payments: Coming April 2027</h2>
        <p>
          Today you can set up membership plans, record payments by hand, and export an accountant-ready revenue CSV for any date range.
        </p>
        <p>
          Automatic card billing through Stripe is coming in April 2027, with failed-payment reminders, sibling discounts, membership freezes and optional late fees. Until then, BeltManager doesn't take payments for you.
        </p>

        <AppScreenshot src="/images/app/karate-parent-portal.webp" width={1200} height={1700} caption="The parent portal: each child's belt and their classes for the next two weeks, with one-tap attending or not attending" />

        <h2>The Parent Portal and Free Parent App</h2>
        <p>
          Parents get a web portal and a free app for iPhone and Android. They see each child's belt and upcoming classes, answer RSVPs with one tap, sign waivers and contracts online, add classes to their phone's calendar, and see achievements and belt promotions.
        </p>

        <h2>Communication</h2>
        <p>
          BeltManager sends the routine messages for you: class reminders on the day, RSVP requests before class, notices when a class is cancelled or closed, belt-promotion notices and achievement notices. Families get them by email and, if they use the parent app, by push notification. There's no SMS and no bulk or segmented messaging today.
        </p>

        <h2>Leads and Trial Classes</h2>
        <p>
          Put your online join form on your website. Enquiries land in your Leads list, where you can track each one through their trial class and convert them to a student in a few clicks. BeltManager doesn't send automated follow-up messages to enquirers.
        </p>

        <h2>Reporting</h2>
        <p>
          Reports cover attendance (by class and student, with CSV export), at-risk and inactive students, insurance compliance (instructor-to-student ratio and insured student count), and revenue as an accountant-ready CSV. The dashboard shows the last 30 days at a glance.
        </p>

        <h2>Family Accounts</h2>
        <p>
          Family accounts matter for any school with a big kids' programme. Parents see every child from one login. Guardians are linked to each child, so reminders and notices reach the right people. When card billing switches on in April 2027, each household will get one invoice, with sibling discounts if you offer them.
        </p>

        <h2>Multiple Locations</h2>
        <p>
          Add as many venues and rooms as you need. Each class belongs to a venue, your dashboard can be filtered by venue, and all your students sit in one database.
        </p>

        <h2>Safeguarding and Insurance</h2>
        <p>
          Most of your students are probably children. BeltManager can erase a minor's data properly when they leave, asks for photo consent on the online join form, and locks the check-in kiosk with a PIN. The compliance report shows your instructor-to-student ratio and insured student count, ready for your insurer.
        </p>

        <h2>Getting Started</h2>
        <p>
          Sign up yourself, set up your belts and classes, and import your students from a spreadsheet (up to 1,000 rows, with their guardians). If an import goes wrong, you can undo it within 24 hours. Then invite families to the parent app.
        </p>

        <h2>Cost</h2>
        <p>
          When we checked competitors' published pricing in November 2026, the main martial arts platforms ranged from about $49 to $350 a month, and several charge extra for a branded app or SMS. BeltManager is free until 31 March 2027, with no subscription, no commission and no per-student charges. Pricing after that date will be announced with notice.
        </p>

        <h2>Choosing the Right Platform</h2>
        <p>
          Look for software that understands martial arts terms and workflows, not just generic gym operations. Belt tracking should match your own syllabus. Check that the features you need work today, not just on a roadmap.
        </p>
        <p>
          Try the platform with real data before committing. Import some students, set up your real timetable, and have your instructors take a register. Good software feels natural because it matches how your school already runs.
        </p>
      </div>
    </div>
  </section>

  <!-- Related Guides -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl font-bold text-navy mb-6">Related Guides</h2>
        <div class="grid md:grid-cols-3 gap-4">
          <a href="/blog/best-martial-arts-software/" class="block p-4 bg-light-red rounded-lg hover:shadow-md transition-shadow">
            <h3 class="font-semibold text-navy mb-1">Best Martial Arts Software 2026</h3>
            <p class="text-sm text-gray-600">Six platforms compared on published pricing and rank tracking</p>
          </a>
          <a href="/free-martial-arts-software/" class="block p-4 bg-light-red rounded-lg hover:shadow-md transition-shadow">
            <h3 class="font-semibold text-navy mb-1">Free Martial Arts Software</h3>
            <p class="text-sm text-gray-600">Which options are genuinely free, and where the free tiers stop</p>
          </a>
          <a href="/blog/gym-management-software-comparison/" class="block p-4 bg-light-red rounded-lg hover:shadow-md transition-shadow">
            <h3 class="font-semibold text-navy mb-1">Martial Arts Gym Management Software</h3>
            <p class="text-sm text-gray-600">Dojo-specific vs general gym software: the category decision</p>
          </a>
          <a href="/blog/types-of-martial-arts/" class="block p-4 bg-light-red rounded-lg hover:shadow-md transition-shadow">
            <h3 class="font-semibold text-navy mb-1">Types of Martial Arts</h3>
            <p class="text-sm text-gray-600">Choosing which disciplines to offer at your school</p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <ComparisonTable
    title="Martial Arts Software vs Generic Gym Software vs Manual Management"
    headers={['BeltManager (Martial Arts-Specific)', 'Generic Gym Software', 'Manual Management']}
    rows={comparisonData}
  />

  <FAQEnhanced
    site="beltmanager"
    pageUrl="https://beltmanager.com/martial-arts-software/"
    title="Frequently Asked Questions About Martial Arts Software"
    faqs={faqItems}
  />

  <section class="section bg-navy text-white">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">
          Ready to Try BeltManager?
        </h2>
        <p class="text-xl mb-8 text-gray-300">
          Belts, gradings, timetables, registers and a free parent app. Free until 31 March 2027.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="https://app.beltmanager.com/signin" class="btn-primary">Get started free</a>
          <a href="/pricing/" class="btn-secondary bg-white text-navy hover:bg-gray-100">View Pricing</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    padding: 4rem 0;
  }

  @media (min-width: 768px) {
    .section {
      padding: 6rem 0;
    }
  }

  .prose {
    color: #1a1a2e;
  }

  .prose h2 {
    color: #1a1a2e;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose p {
    margin-bottom: 1.25rem;
    line-height: 1.75;
  }

  .prose a {
    color: #e94560;
    text-decoration: none;
  }

  .prose a:hover {
    text-decoration: underline;
  }
</style>
