---
import AppScreenshot from '../components/AppScreenshot.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbsEnhanced from '../components/seo/BreadcrumbsEnhanced.astro';
import FeaturedAnswer from '../components/seo/FeaturedAnswer.astro';
import ComparisonTable from '../components/seo/ComparisonTable.astro';
import FAQEnhanced from '../components/seo/FAQEnhanced.astro';

const comparisonData = [
  {
    label: 'Kyu/Dan Rank Tracking',
    values: [true, true, false],
    highlight: true
  },
  {
    label: 'Techniques and Kata per Belt',
    values: [true, 'Varies', false],
    highlight: true
  },
  {
    label: 'Family Accounts with Guardians',
    values: [true, true, false],
    highlight: true
  },
  {
    label: 'Grading Eligibility (time at grade + sessions)',
    values: [true, 'Varies', false]
  },
  {
    label: 'Traditional Terminology Support',
    values: [true, false, false]
  },
  {
    label: 'Printable Rank Certificates',
    values: [true, 'Varies', false]
  },
  {
    label: 'Promotion Notice to Families (email & app push)',
    values: [true, 'Varies', false]
  },
  {
    label: 'Parent Portal and Free Parent App',
    values: [true, 'Often a paid add-on', false]
  },
  {
    label: 'Sibling Discounts on One Family Invoice',
    values: ['Coming April 2027', 'Varies', 'Manual']
  },
  {
    label: 'Monthly Price',
    values: ['Free until 31 March 2027', 'Varies', '£0']
  }
];

const faqItems = [
  {
    question: "What is dojo management software?",
    answer: "Dojo management software is a platform built for traditional martial arts schools. It keeps student and family records, tracks kyu/dan grades and grading eligibility, runs gradings and the class timetable, and uses dojo terms rather than generic gym language. BeltManager does all of this, with membership billing to follow: automatic card billing is coming in April 2027.",
    links: [
      { text: 'View all features', url: '/martial-arts-software/' },
      { text: 'See pricing', url: '/pricing/' }
    ]
  },
  {
    question: "How is dojo software different from gym software?",
    answer: "Dojo software is built around belts and gradings. It tracks each student's grade, the techniques and kata they need for the next one, and whether they've trained long enough to grade. Generic gym platforms don't do this. It also uses the right words: students rather than members, gradings rather than assessments.",
    links: [
      { text: 'Dojo vs gym software', url: '/martial-arts-software/' },
      { text: 'Karate-specific features', url: '/karate-school-software/' }
    ]
  },
  {
    question: "Can BeltManager track more than one martial art?",
    answer: "Yes. Each style has its own belt system, colours and grading criteria, while students and families sit in one database. A student who trains in two styles has a belt in each.",
    links: [
      { text: 'Multi-discipline tracking', url: '/martial-arts-software/' },
      { text: 'MMA features', url: '/mma-gym-software/' }
    ]
  },
  {
    question: "How do gradings work?",
    answer: "Set how long a student must spend at a grade and how many sessions they need. BeltManager shows who is ready, almost ready or not yet ready. Create a grading session, record a pass or not-passed for each student, and their grade updates. Print a rank certificate for each promotion, and the family gets a promotion notice by email and app push.",
    links: [
      { text: 'Testing features', url: '/martial-arts-software/' },
      { text: 'Karate belt guide', url: '/blog/karate-belts/' }
    ]
  },
  {
    question: "What should dojo software cost?",
    answer: "When we checked competitors' published pricing in November 2026, the main martial arts platforms ranged from about $49 to $350 a month, depending on student numbers and features. BeltManager is free until 31 March 2027, with no subscription and no per-student fees.",
    links: [
      { text: 'View pricing', url: '/pricing/' },
      { text: 'Feature comparison', url: '/martial-arts-software/' }
    ]
  },
  {
    question: "Can I import my existing student records?",
    answer: "Yes. Import students from a spreadsheet (CSV), up to 1,000 rows at a time, with their guardians, groups and current belts. You check every row before anything is saved, and you can undo an import within 24 hours.",
    links: [
      { text: 'Implementation guide', url: '/martial-arts-software/' },
      { text: 'Contact support', url: '/contact/' }
    ]
  },
  {
    question: "Do families get their own login?",
    answer: "Yes. Parents get a web portal and a free app for iPhone and Android. They see each child's belt, techniques and upcoming classes, answer RSVPs, sign waivers, and get reminders and notices.",
    links: [
      { text: 'Student portal features', url: '/martial-arts-software/' }
    ]
  },
  {
    question: "How will family billing work?",
    answer: "From April 2027, when automatic card billing switches on, each household gets one invoice for all its children, with a sibling discount percentage you set. Until then, you can set up memberships and record payments by hand.",
    links: [
      { text: 'Family features', url: '/martial-arts-software/' },
      { text: 'Billing options', url: '/martial-arts-billing-software/' }
    ]
  },
  {
    question: "Does BeltManager connect to my association or federation?",
    answer: "No. BeltManager doesn't connect to governing bodies or track federation licences. You can set up your association's grade structure and grading criteria yourself.",
    links: [
      { text: 'Karate features', url: '/karate-school-software/' }
    ]
  },
  {
    question: "How long does it take to get started?",
    answer: "Sign-up is self-serve. Set up your grades and classes, import your students from a spreadsheet, and invite families to the parent app. How long the full switch takes depends on your dojo.",
    links: [
      { text: 'Implementation guide', url: '/martial-arts-software/' },
      { text: 'Get started free', url: 'https://app.beltmanager.com/signin' }
    ]
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.slice(0, 8).map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<BaseLayout
  title="Dojo Management Software (2026)"
  description="Run your dojo without the admin chaos. Kyu/dan tracking, gradings and certificates, curriculum and family accounts. Free until 31 March 2027."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <!-- Breadcrumbs -->
  <BreadcrumbsEnhanced
    site="beltmanager"
    items={[
      { label: 'Home', href: '/' },
      { label: 'Dojo Management Software', href: '/dojo-management-software/' }
    ]}
  />

  <!-- Hero Section -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block px-4 py-2 mb-4 text-sm font-semibold text-brand-red bg-brand-red-light rounded-full">Complete Guide</span>
        <h1 class="text-4xl md:text-5xl font-bold text-brand-navy mb-4">Dojo Management Software</h1>
        <p class="text-xl text-gray-600">
          Management software for traditional martial arts schools. Handle your timetable, grades, gradings and families while respecting dojo culture and terminology.
        </p>
      </div>
    </div>
  </section>

  <!-- Featured Answer -->
  <FeaturedAnswer question="What is dojo management software?">
    Dojo management software is a specialized platform for traditional martial arts schools. It handles student records, kyu/dan rank tracking, gradings, class scheduling and family accounts, using dojo terminology rather than generic gym language. It tracks progression through belt systems, shows who is eligible to grade, and keeps curriculum records.
  </FeaturedAnswer>

  <!-- Main Content -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto prose prose-lg">

        <h2>Purpose-Built Technology for Traditional Martial Arts Schools</h2>

        <p>
          The traditional dojo operates on principles refined over centuries: respect, discipline, continuous improvement. Yet the administrative demands of running a modern martial arts school bear little resemblance to the straightforward student-teacher relationships of historical training halls.
        </p>

        <p>
          Dojo management software bridges this gap between traditional values and modern operational requirements. These specialized platforms handle the business complexity that would otherwise distract from instruction, enabling senseis and school owners to maintain focus on what matters most: developing their students' skills and character.
        </p>

        <AppScreenshot src="/images/app/dojo-dashboard.webp" width={1600} height={1220} caption="Dashboard: active students, who is ready for their next kyu grade, and attendance over the last 30 days" />

        <h3>Understanding the Dojo Environment</h3>

        <p>
          The word <strong>'dojo'</strong> translates roughly to 'place of the way'—a training hall where students pursue mastery through disciplined practice. This cultural foundation influences every aspect of how a dojo operates, from the hierarchical structure of ranks to the ceremonial elements of class conduct.
        </p>

        <p>
          Effective dojo management software acknowledges these cultural elements rather than imposing generic gym terminology. When software refers to 'members' rather than 'students', 'facilities' rather than 'training halls', or 'fitness levels' rather than 'belt ranks', it creates friction that undermines the training environment.
        </p>

        <AppScreenshot src="/images/app/dojo-belt-progression.webp" width={840} height={1560} caption="A student's training record: readiness for the next belt (days, sessions and techniques), the technique checklist and promotion history" />

        <h3>What Makes Dojo Operations Unique</h3>

        <p>Traditional martial arts schools differ from fitness facilities in several fundamental ways:</p>

        <ul>
          <li><strong>Hierarchical progression systems</strong> with formal testing requirements</li>
          <li><strong>Curriculum-based instruction</strong> rather than freestyle training</li>
          <li><strong>Cultural protocols and terminology</strong> specific to martial tradition</li>
          <li><strong>Student-teacher relationships</strong> that extend beyond transactional service</li>
          <li><strong>Long-term developmental focus</strong> measured in years, not weeks</li>
          <li><strong>Community aspects</strong> including seminars, competitions, and lineage connections</li>
        </ul>

        <p>
          Generic gym software designed for drop-in fitness classes cannot accommodate these distinctive elements.
        </p>

      </div>
    </div>
  </section>

  <!-- Comparison Table -->
  <section class="section bg-gray-50">
    <div class="container-custom">
      <div class="max-w-5xl mx-auto">
        <ComparisonTable
          title="Dojo Software vs General Martial Arts vs Manual Tracking"
          headers={['BeltManager (Traditional)', 'Generic Martial Arts', 'Spreadsheets']}
          rows={comparisonData}
        />
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto prose prose-lg">

        <h2>Essential Features for Dojo Software</h2>

        <h3>1. Kyu and Dan Rank Tracking</h3>
        <ul>
          <li>Complete kyu (color belt) and dan (black belt) tracking</li>
          <li>Time-in-rank requirements with automatic eligibility calculations</li>
          <li>Attendance minimums per rank with real-time progress visibility</li>
          <li>Curriculum checklist tracking for technique requirements</li>
          <li>Stripe and interim achievement recording</li>
          <li>Historical progression showing complete rank history</li>
          <li>Multiple ranking tracks for schools teaching several arts</li>
          <li>Custom rank naming and color configuration</li>
        </ul>

        <AppScreenshot src="/images/app/dojo-grading-event.webp" width={1600} height={1200} caption="A grading session: each student's current and target kyu, with a one-tap pass or not-passed result" />

        <h3>2. Grading and Testing Management</h3>
        <ul>
          <li>Grading sessions with each student's current and target grade</li>
          <li>Readiness shown for every student: ready, almost, or not yet</li>
          <li>One-tap pass or not-passed results</li>
          <li>Printable rank certificates for each promotion</li>
          <li>Promotion notice to the family by email and app push</li>
          <li>Grades update automatically after a pass</li>
        </ul>

        <h3>3. Student and Family Management</h3>
        <ul>
          <li>Family accounts linking related students</li>
          <li>Guardians linked to each child</li>
          <li>Parent portal and free parent app</li>
          <li>Emergency contact and medical information</li>
          <li>Import students and guardians from a spreadsheet</li>
          <li>Coming April 2027: one family invoice with sibling discounts</li>
        </ul>

        <AppScreenshot src="/images/app/dojo-family-account.webp" width={1600} height={1200} caption="A family account: siblings in one household with the family's guardians. The sibling discount and subscription take effect when card billing switches on in April 2027" />

        <h3>4. Class and Schedule Management</h3>
        <ul>
          <li>Recurring classes (beginner, intermediate, advanced, black belt)</li>
          <li>Minimum/maximum belt and age range on each group (warns, doesn't block)</li>
          <li>Seminar, tournament and social events</li>
          <li>Term dates, holidays and closures, with automatic notices to families</li>
          <li>Venues and rooms for multi-room dojos</li>
          <li>Tablet kiosk check-in, locked with a PIN</li>
        </ul>

        <h2>Related Resources</h2>

        <ul>
          <li><a href="/martial-arts-software/">Martial Arts Software</a> — Complete platform overview</li>
          <li><a href="/karate-school-software/">Karate School Software</a> — Karate-specific features</li>
          <li><a href="/blog/karate-belts/">Understanding Karate Belts</a> — Belt system fundamentals</li>
          <li><a href="/martial-arts-billing-software/">Billing Software</a> — Memberships today, card billing from April 2027</li>
          <li><a href="/blog/best-martial-arts-software/">Software Comparison</a> — Detailed reviews</li>
        </ul>

      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <FAQEnhanced
    site="beltmanager"
    pageUrl="https://beltmanager.com/dojo-management-software/"
    title="Frequently Asked Questions About Dojo Management Software"
    faqs={faqItems}
  />

  <!-- CTA Section -->
  <section class="section bg-brand-red text-white">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-bold mb-4">Ready to Honor Tradition While Embracing Efficiency?</h2>
        <p class="text-xl mb-8 opacity-95">
          See how BeltManager respects dojo culture while handling the admin: grades, gradings and certificates, families, and your timetable.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="https://app.beltmanager.com/signin" class="btn-primary-large bg-white text-brand-red hover:bg-gray-100">Get started free</a>
          <a href="/pricing/" class="btn-secondary-large border-white text-white hover:bg-white hover:bg-opacity-10">View Pricing</a>
        </div>
        <p class="mt-6 text-sm opacity-90">Free until 31 March 2027 • No credit card • No contract</p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .section {
    padding: 4rem 0;
  }

  .prose {
    max-width: none;
  }

  .prose h2 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--brand-navy);
    margin-top: 3rem;
    margin-bottom: 1.5rem;
  }

  .prose h3 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--brand-navy);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose p {
    margin-bottom: 1.5rem;
    color: #475569;
    line-height: 1.7;
  }

  .prose ul {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
    color: #475569;
  }

  .prose strong {
    color: var(--brand-navy);
    font-weight: 600;
  }

  .prose a {
    color: var(--brand-red);
    text-decoration: none;
  }

  .prose a:hover {
    text-decoration: underline;
  }

  .btn-primary-large,
  .btn-secondary-large {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    border-radius: 8px;
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-primary-large:hover,
  .btn-secondary-large:hover {
    transform: translateY(-2px);
  }

  .btn-secondary-large {
    border: 2px solid;
  }

  @media (max-width: 768px) {
    .section {
      padding: 3rem 0;
    }

    .prose h2 {
      font-size: 1.5rem;
    }

    .prose h3 {
      font-size: 1.25rem;
    }
  }
</style>
