---
import AppScreenshot from '../components/AppScreenshot.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbsEnhanced from '../components/seo/BreadcrumbsEnhanced.astro';
import FeaturedAnswer from '../components/seo/FeaturedAnswer.astro';
import ComparisonTable from '../components/seo/ComparisonTable.astro';
import FAQEnhanced from '../components/seo/FAQEnhanced.astro';

const comparisonData = [
  {
    label: 'Kyu/Dan Rank Tracking',
    values: [true, true, false],
    highlight: true
  },
  {
    label: 'Curriculum Management',
    values: [true, false, false],
    highlight: true
  },
  {
    label: 'Family Account Linking',
    values: [true, true, false],
    highlight: true
  },
  {
    label: 'Testing & Grading Automation',
    values: [true, false, false]
  },
  {
    label: 'Traditional Terminology Support',
    values: [true, false, false]
  },
  {
    label: 'Sibling Discount Automation',
    values: [true, true, false]
  },
  {
    label: 'Rank Certificate Generation',
    values: [true, false, false]
  },
  {
    label: 'Attendance & Time-in-Rank',
    values: [true, true, false]
  },
  {
    label: 'Parent Portal Access',
    values: [true, true, false]
  },
  {
    label: 'Monthly Price',
    values: ['Free', '£95', '£0']
  }
];

const faqItems = [
  {
    question: "What is dojo management software?",
    answer: "Dojo management software is a specialized platform for traditional martial arts schools. It handles student databases, kyu/dan rank tracking, grading ceremonies, class scheduling, and billing while using terminology and workflows appropriate to the dojo environment rather than generic gym language. Software tracks progression through belt systems, manages testing eligibility, maintains curriculum records, and supports family account relationships common in traditional training environments.",
    links: [
      { text: 'View all features', url: '/martial-arts-software/' },
      { text: 'See pricing', url: '/pricing/' }
    ]
  },
  {
    question: "How is dojo software different from gym software?",
    answer: "Dojo software is purpose-built for martial arts operations. It includes belt rank progression tracking, testing eligibility automation, curriculum management, and grading ceremony coordination—features absent from generic gym platforms. It also uses appropriate terminology (students vs members, dojo vs facility, sensei vs trainer, gi vs uniform) and understands cultural protocols like hierarchical student-teacher relationships, ceremonial aspects of testing, and multi-year developmental timelines.",
    links: [
      { text: 'Dojo vs gym software', url: '/martial-arts-software/' },
      { text: 'Karate-specific features', url: '/karate-school-software/' }
    ]
  },
  {
    question: "Can dojo software track multiple martial arts?",
    answer: "Yes. A school teaching both Karate and Judo sets up a belt ladder for each style, with its own belt names, colours, grading requirements and technique checklists, while each student keeps one profile.",
    links: [
      { text: 'Multi-discipline tracking', url: '/martial-arts-software/' },
      { text: 'MMA features', url: '/mma-gym-software/' }
    ]
  },
  {
    question: "How does testing management work?",
    answer: "In BeltManager, each belt can have a minimum time at the previous belt and a minimum number of sessions. A ready-to-grade list shows who meets them, based on attendance. You create a grading session, add the students, record pass or not passed with one tap, and passing updates their belt. Families are told about the promotion by email and in the parent app, and you can print a rank certificate for each student who passed.",
    links: [
      { text: 'Testing features', url: '/martial-arts-software/' },
      { text: 'Karate belt guide', url: '/blog/karate-belts/' }
    ]
  },
  {
    question: "What should dojo software cost?",
    answer: "Dojo management software typically costs £50-200 per month depending on student count and features. Smaller dojos (under 100 students) often find suitable options at £50-80 monthly. Mid-size schools (100-250 students) pay £80-120. Larger schools with advanced features or multiple locations may pay £120-200. Per-student pricing models charge £1-3 per active student. BeltManager is free until 31 March 2027 — no subscription and no per-student fees.",
    links: [
      { text: 'View pricing', url: '/pricing/' },
      { text: 'Feature comparison', url: '/martial-arts-software/' }
    ]
  },
  {
    question: "Can I import my existing student records?",
    answer: "Yes. Send us your student list as a spreadsheet and we'll help you import it into BeltManager. You can also add students one at a time.",
    links: [
      { text: 'Implementation guide', url: '/martial-arts-software/' },
      { text: 'Contact support', url: '/contact/' }
    ]
  },
  {
    question: "Do students get their own login?",
    answer: "Parents sign in to the parent portal, or the free iPhone app, to see each child's belt and upcoming classes, answer whether they're coming, sign documents such as waivers, and see achievements. Classes can be added to their phone's calendar.",
    links: [
      { text: 'Student portal features', url: '/martial-arts-software/' }
    ]
  },
  {
    question: "How does family billing work?",
    answer: "A household links siblings and their guardians. Set a sibling discount percentage for the household and every child goes on one family invoice, with the discount shown line by line. Card billing switches on in April 2027; until then, you can record payments by hand.",
    links: [
      { text: 'Family features', url: '/martial-arts-software/' },
      { text: 'Billing options', url: '/martial-arts-billing-software/' }
    ]
  },
  {
    question: "Can I set my association's grading requirements?",
    answer: "You can set your own belt ladder, names and colours, plus a minimum time at each belt and a minimum number of sessions, to match your association's rules. BeltManager doesn't connect to governing bodies or track federation licences.",
    links: [
      { text: 'Grading features', url: '/martial-arts-software/' },
      { text: 'Karate federations', url: '/karate-school-software/' }
    ]
  },
  {
    question: "How long does setup take?",
    answer: "Setup is self-serve. Add your belt system, classes and students (or send us your list to import), put students into their groups and take your first register. Schools teaching several styles add a belt ladder for each.",
    links: [
      { text: 'Implementation guide', url: '/martial-arts-software/' },
      { text: 'Get started free', url: 'https://app.beltmanager.com/signin' }
    ]
  }
];
---

<BaseLayout
  title="Dojo Management Software (2026)"
  description="Run your dojo without the admin chaos. Kyu/dan tracking, gradings, curriculum and family accounts. Free until 31 March 2027."
>
  <!-- Breadcrumbs -->
  <BreadcrumbsEnhanced
    site="beltmanager"
    items={[
      { label: 'Home', href: '/' },
      { label: 'Dojo Management Software', href: '/dojo-management-software/' }
    ]}
  />

  <!-- Hero Section -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block px-4 py-2 mb-4 text-sm font-semibold text-brand-red bg-brand-red-light rounded-full">Complete Guide</span>
        <h1 class="text-4xl md:text-5xl font-bold text-brand-navy mb-4">Dojo Management Software</h1>
        <p class="text-xl text-gray-600">
          Complete management software for traditional martial arts schools. Handle scheduling, belt tracking, billing, and student management while respecting dojo culture and terminology.
        </p>
      </div>
    </div>
  </section>

  <!-- Featured Answer -->
  <FeaturedAnswer question="What is dojo management software?">
    Dojo management software is a specialized platform for traditional martial arts schools. It handles student databases, kyu/dan rank tracking, grading ceremonies, class scheduling, and billing while using terminology and workflows appropriate to the dojo environment rather than generic gym language. Software tracks progression through belt systems, manages testing eligibility, maintains curriculum records, and supports family account relationships.
  </FeaturedAnswer>

  <!-- Statistics Section -->
  <!-- Main Content -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto prose prose-lg">

        <h2>Purpose-Built Technology for Traditional Martial Arts Schools</h2>

        <p>
          The traditional dojo operates on principles refined over centuries: respect, discipline, continuous improvement. Yet the administrative demands of running a modern martial arts school bear little resemblance to the straightforward student-teacher relationships of historical training halls.
        </p>

        <p>
          Dojo management software bridges this gap between traditional values and modern operational requirements. These specialized platforms handle the business complexity that would otherwise distract from instruction, enabling senseis and school owners to maintain focus on what matters most: developing their students' skills and character.
        </p>

        <AppScreenshot src="/images/app/dojo-dashboard.webp" width={1600} height={1220} caption="Dashboard: active students, who is ready for their next kyu grade, and attendance over the last 30 days" />

        <h3>Understanding the Dojo Environment</h3>

        <p>
          The word <strong>'dojo'</strong> translates roughly to 'place of the way'—a training hall where students pursue mastery through disciplined practice. This cultural foundation influences every aspect of how a dojo operates, from the hierarchical structure of ranks to the ceremonial elements of class conduct.
        </p>

        <p>
          Effective dojo management software acknowledges these cultural elements rather than imposing generic gym terminology. When software refers to 'members' rather than 'students', 'facilities' rather than 'training halls', or 'fitness levels' rather than 'belt ranks', it creates friction that undermines the training environment.
        </p>

        <AppScreenshot src="/images/app/dojo-belt-progression.webp" width={840} height={1560} caption="A student's training record: readiness for the next belt (days, sessions and techniques), the technique checklist and promotion history" />

        <h3>What Makes Dojo Operations Unique</h3>

        <p>Traditional martial arts schools differ from fitness facilities in several fundamental ways:</p>

        <ul>
          <li><strong>Hierarchical progression systems</strong> with formal testing requirements</li>
          <li><strong>Curriculum-based instruction</strong> rather than freestyle training</li>
          <li><strong>Cultural protocols and terminology</strong> specific to martial tradition</li>
          <li><strong>Student-teacher relationships</strong> that extend beyond transactional service</li>
          <li><strong>Long-term developmental focus</strong> measured in years, not weeks</li>
          <li><strong>Community aspects</strong> including seminars, competitions, and lineage connections</li>
        </ul>

        <p>
          Generic gym software designed for drop-in fitness classes cannot accommodate these distinctive elements.
        </p>

      </div>
    </div>
  </section>

  <!-- Comparison Table -->
  <section class="section bg-gray-50">
    <div class="container-custom">
      <div class="max-w-5xl mx-auto">
        <ComparisonTable
          title="Dojo Software vs General Martial Arts vs Manual Tracking"
          headers={['BeltManager (Traditional)', 'Generic Martial Arts', 'Spreadsheets']}
          rows={comparisonData}
        />
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto prose prose-lg">

        <h2>Essential Features for Dojo Software</h2>

        <h3>1. Kyu and Dan Rank Tracking</h3>
        <ul>
          <li>Complete kyu (color belt) and dan (black belt) tracking</li>
          <li>Time-in-rank requirements with automatic eligibility calculations</li>
          <li>Attendance minimums per rank with real-time progress visibility</li>
          <li>Curriculum checklist tracking for technique requirements</li>
          <li>Stripes on the belt badge, plus achievements and patches</li>
          <li>Historical progression showing complete rank history</li>
          <li>Multiple ranking tracks for schools teaching several arts</li>
          <li>Custom rank naming and color configuration</li>
        </ul>

        <AppScreenshot src="/images/app/dojo-grading-event.webp" width={1600} height={1200} caption="A grading session: each student's current and target kyu, with a one-tap pass or not-passed result" />

        <h3>2. Grading and Testing Management</h3>
        <ul>
          <li>Ready-to-grade list built from attendance and time at belt</li>
          <li>Grading sessions with the students you choose</li>
          <li>One-tap pass or not-passed results</li>
          <li>Printable rank certificates</li>
          <li>Belt updated automatically on a pass</li>
          <li>Promotion notices to families by email and in the parent app</li>
        </ul>

        <h3>3. Student and Family Management</h3>
        <ul>
          <li>Family accounts linking related students</li>
          <li>Sibling discount on the family invoice</li>
          <li>Parent portal access for youth student accounts</li>
          <li>Emergency contact and medical information</li>
          <li>Rank and attendance visibility across family members</li>
          <li>One invoice per family (card billing from April 2027)</li>
          <li>E-signed waivers and contracts in the parent portal</li>
        </ul>

        <AppScreenshot src="/images/app/dojo-family-account.webp" width={1600} height={1200} caption="A family account: siblings in one household, a 10% sibling discount applied to every invoice, and the family's guardians and subscription" />

        <h3>4. Class and Schedule Management</h3>
        <ul>
          <li>Recurring weekly classes (beginner, intermediate, advanced, black belt)</li>
          <li>Age and belt ranges per group (children, teens, adults)</li>
          <li>Seminar and workshop scheduling</li>
          <li>Term dates and closures, with automatic notices to families</li>
          <li>Venues and rooms for multi-room dojos</li>
        </ul>

        <h2>Related Resources</h2>

        <ul>
          <li><a href="/martial-arts-software/">Martial Arts Software</a> — Complete platform overview</li>
          <li><a href="/karate-school-software/">Karate School Software</a> — Karate-specific features</li>
          <li><a href="/blog/karate-belts/">Understanding Karate Belts</a> — Belt system fundamentals</li>
          <li><a href="/martial-arts-billing-software/">Billing Software</a> — Payment processing details</li>
          <li><a href="/blog/best-martial-arts-software/">Software Comparison</a> — Detailed reviews</li>
        </ul>

      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <FAQEnhanced
    site="beltmanager"
    pageUrl="https://beltmanager.com/dojo-management-software/"
    title="Frequently Asked Questions About Dojo Management Software"
    faqs={faqItems}
  />

  <!-- CTA Section -->
  <section class="section bg-brand-red text-white">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-bold mb-4">Ready to Honor Tradition While Embracing Efficiency?</h2>
        <p class="text-xl mb-8 opacity-95">
          See how BeltManager respects dojo culture while streamlining operations with belt tracking, family management, and automated testing workflows.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="https://app.beltmanager.com/signin" class="btn-primary-large bg-white text-brand-red hover:bg-gray-100">Get started free</a>
          <a href="/pricing/" class="btn-secondary-large border-white text-white hover:bg-white hover:bg-opacity-10">View Pricing</a>
        </div>
        <p class="mt-6 text-sm opacity-90">Free until 31 March 2027 • No credit card • No contract</p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .section {
    padding: 4rem 0;
  }

  .prose {
    max-width: none;
  }

  .prose h2 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--brand-navy);
    margin-top: 3rem;
    margin-bottom: 1.5rem;
  }

  .prose h3 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--brand-navy);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose p {
    margin-bottom: 1.5rem;
    color: #475569;
    line-height: 1.7;
  }

  .prose ul {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
    color: #475569;
  }

  .prose strong {
    color: var(--brand-navy);
    font-weight: 600;
  }

  .prose a {
    color: var(--brand-red);
    text-decoration: none;
  }

  .prose a:hover {
    text-decoration: underline;
  }

  .btn-primary-large,
  .btn-secondary-large {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    border-radius: 8px;
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-primary-large:hover,
  .btn-secondary-large:hover {
    transform: translateY(-2px);
  }

  .btn-secondary-large {
    border: 2px solid;
  }

  @media (max-width: 768px) {
    .section {
      padding: 3rem 0;
    }

    .prose h2 {
      font-size: 1.5rem;
    }

    .prose h3 {
      font-size: 1.25rem;
    }
  }
</style>
