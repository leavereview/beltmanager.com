const CHECKED = 'November 22, 2026';
const PAGE_URL = 'https://beltmanager.com/martial-arts-terms/';

interface Term {
  id: string;
  term: string;
  lang?: string;
  /** HTML allowed (links, em). */
  def: string;
  /** Source numbers, or empty for a term described from common usage. */
  src: number[];
}

interface Group {
  id: string;
  title: string;
  intro: string;
  terms: Term[];
}

const groups: Group[] = [
  {
    id: 'rank-terms',
    title: 'Rank Terms: Kyu, Dan, Geup and Poom',
    intro: 'Most Japanese and Korean arts split ranks into two sets: student ranks below black belt, and black belt ranks. The words differ by language, and the numbering runs in opposite directions.',
    terms: [
      {
        id: 'kyu', term: 'Kyu', lang: 'Japanese',
        def: 'A student rank below black belt in judo, karate, aikido and kendo. Kyu ranks count down: the highest number is the beginner and 1st kyu is the last rank before black belt. The International Judo Federation describes the white to brown belts as corresponding to "grades called kyu, ranging from the highest numbered for the white belt, to the \'1st kyu\' for the brown belt". How many kyu there are depends on the organization: the US Aikido Federation tests from 6th kyu, the Aikikai headquarters dojo from 5th kyu, and the International Shotokan Karate Federation starts children under 7 at 10th kyu.',
        src: [1, 8, 10],
      },
      {
        id: 'dan', term: 'Dan', lang: 'Japanese; also used in Korean arts',
        def: 'A black belt rank. Dan ranks count up from 1st dan. The word comes from Japanese and, before that, a Chinese word meaning "step" or "grade". The top of the scale depends on the body: Aikikai dan ranks run from 1st to 8th dan, Kukkiwon taekwondo dan ranks from 1st to 9th, and USA Karate certifies ranks from shodan (1st dan) to 9th dan. In English, "first-degree black belt" means 1st dan.',
        src: [1, 5, 8, 9, 15],
      },
      {
        id: 'shodan', term: 'Shodan, nidan, sandan, yondan, godan', lang: 'Japanese',
        def: 'The names of the first five dan ranks: shodan (1st), nidan (2nd), sandan (3rd), yondan (4th) and godan (5th). The International Judo Federation lists these five as the ranks that wear a black belt in judo. Shodan is the first black belt rank, so it is a starting point in the dan ranks, not the top.',
        src: [1],
      },
      {
        id: 'mudansha-yudansha', term: 'Mudansha and yudansha', lang: 'Japanese',
        def: 'Mudansha are students without a dan rank, that is, everyone below black belt. Yudansha are dan holders. The International Judo Federation quotes judo\'s founder, Jigoro Kano, as naming beginners "mudan-sha", which it glosses as people without dan. USA Judo uses yudansha for black belt rank students.',
        src: [1, 2],
      },
      {
        id: 'black-belt', term: 'Black belt',
        def: 'The belt worn by dan holders, and by extension the rank itself. In judo, 1st to 5th dan wear a black belt. Higher judo ranks wear other belts: USA Judo records that the Kodokan introduced a red and white belt and later a red belt for its highest degrees. In Brazilian jiu-jitsu the black belt is itself divided into six degrees.',
        src: [1, 2, 7],
      },
      {
        id: 'geup', term: 'Geup (also spelled gup or kup)', lang: 'Korean',
        def: 'A taekwondo color belt rank, the Korean counterpart of kyu. Kukkiwon\'s promotion test regulations define gup as "a rank awarded to general trainees" who do not hold a poom or dan, and say gup promotion tests are run by taekwondo masters, meaning the school. Kukkiwon sets no time between gup tests. Like kyu, geup ranks are usually counted down toward 1st geup.',
        src: [4],
      },
      {
        id: 'poom', term: 'Poom', lang: 'Korean',
        def: 'The junior black belt rank in Kukkiwon taekwondo. Kukkiwon\'s regulations define poom as the "certification awarded to persons under the age of 15" and dan as the certification for those "at or above the age of 15". There are four poom ranks. World Taekwondo\'s identification guidelines show a black and red belt as the poom belt and a black belt as the dan belt.',
        src: [4, 5, 6],
      },
      {
        id: 'degree', term: 'Degree',
        def: 'The English word for a step within the black belt ranks ("second-degree black belt" is 2nd dan). In Brazilian jiu-jitsu, the federation also uses "degree" for the steps inside each colored belt. See <a href="#stripe">stripe</a>.',
        src: [7],
      },
    ],
