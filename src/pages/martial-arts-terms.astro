const stripTags = (html: string) => html.replace(/<[^>]*>/g, '');

const termSchema = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  '@id': `${PAGE_URL}#glossary`,
  name: 'Martial Arts Terms: A Glossary for Students, Parents and School Owners',
  url: PAGE_URL,
  inLanguage: 'en-US',
  hasDefinedTerm: groups.flatMap((g) => g.terms.map((t) => ({
    '@type': 'DefinedTerm',
    '@id': `${PAGE_URL}#${t.id}`,
    name: t.term,
    description: stripTags(t.def),
    url: `${PAGE_URL}#${t.id}`,
    inDefinedTermSet: `${PAGE_URL}#glossary`,
  }))),
};

const termCount = groups.reduce((n, g) => n + g.terms.length, 0);

const faqItems = [
