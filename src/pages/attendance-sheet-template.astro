    color: var(--brand-navy);
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }

  .prose th,
  .prose td {
    border: 1px solid #e2e8f0;
    padding: 0.6rem 0.75rem;
    text-align: left;
    color: #475569;
    vertical-align: top;
  }

  .prose th {
    background: #f8fafc;
    color: var(--brand-navy);
    font-weight: 600;
  }

  .btn-primary-large,
  .btn-secondary-large {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    border-radius: 8px;
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-primary-large:hover,
  .btn-secondary-large:hover {
    transform: translateY(-2px);
  }

  .btn-secondary-large {
    border: 2px solid;
  }

  @media (max-width: 768px) {
    .section {
      padding: 3rem 0;
    }

    .prose h2 {
      font-size: 1.5rem;
    }

    .prose h3 {
      font-size: 1.25rem;
    }
  }
</style>
