---
import AppScreenshot from '../components/AppScreenshot.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbsEnhanced from '../components/seo/BreadcrumbsEnhanced.astro';
import FeaturedAnswer from '../components/seo/FeaturedAnswer.astro';
import ComparisonTable from '../components/seo/ComparisonTable.astro';
import FAQEnhanced from '../components/seo/FAQEnhanced.astro';

const comparisonData = [
  {
    label: 'Kyu/Dan Belt Tracking',
    values: [true, true, false],
    highlight: true
  },
  {
    label: 'Kata and Techniques per Grade',
    values: [true, 'Varies', false],
    highlight: true
  },
  {
    label: 'Style-Specific Belt Systems',
    values: [true, 'Varies', false],
    highlight: true
  },
  {
    label: 'Grading Eligibility (time at grade + sessions)',
    values: [true, true, false]
  },
  {
    label: 'Kata Readiness (ready / almost / not yet)',
    values: [true, false, false]
  },
  {
    label: 'Family Accounts with Guardians',
    values: [true, true, false]
  },
  {
    label: 'Stripe/Tip Tracking',
    values: [true, 'Varies', false]
  },
  {
    label: 'Printable Rank Certificates (with your logo)',
    values: [true, 'Varies', false]
  },
  {
    label: 'Monthly Price',
    values: ['Free until 31 March 2027', 'Varies', '£0']
  }
];

const faqItems = [
  {
    question: "What is karate school software?",
    answer: "Karate school software is a management platform built for karate dojos. It keeps student and family records, tracks students through the kyu grades to dan ranks, records kata progress, shows who is eligible to grade, and runs the class timetable, using karate terminology. BeltManager does all of this; automatic card billing is coming in April 2027.",
    links: [
      { text: 'View all features', url: '/martial-arts-software/' },
      { text: 'See pricing', url: '/pricing/' }
    ]
  },
  {
    question: "Can BeltManager track kata progress?",
    answer: "Yes. Build your kata and technique syllabus, map each kata to the grade it's taught at, and link a video if you like. Instructors mark each student's progress from the class register, and BeltManager shows whether they're ready, almost ready or not yet ready for their next grading. Instructors can also add notes on a student after each session.",
    links: [
      { text: 'Curriculum features', url: '/martial-arts-software/' },
      { text: 'Karate belt guide', url: '/blog/karate-belts/' }
    ]
  },
  {
    question: "How do gradings work in BeltManager?",
    answer: "Set the minimum time at grade and number of sessions for each kyu. BeltManager shows who is eligible. Create a grading session, record a pass or not-passed for each student, and their grade updates. Print a rank certificate, with your school's logo, for each promotion, and the family gets a promotion notice by email and app push. Grading fees aren't collected through BeltManager.",
    links: [
      { text: 'Testing management', url: '/martial-arts-software/' },
      { text: 'Belt system explained', url: '/blog/karate-belt-order-complete-guide/' }
    ]
  },
  {
    question: "Does BeltManager support different karate styles?",
    answer: "Yes. Set up your own belt colours, kata list and grading criteria for your style, whether that's Shotokan, Goju-Ryu, Shito-Ryu, Wado-Ryu or Kyokushin. If you teach more than one style, each keeps its own belt system.",
    links: [
      { text: 'Style customisation', url: '/martial-arts-software/' },
      { text: 'Karate styles overview', url: '/blog/types-of-martial-arts/' }
    ]
  },
  {
    question: "Can parents see their children's progress?",
    answer: "Yes. Parents use the web portal or the free parent app to see each child's belt and upcoming classes, answer RSVPs, and get reminders, achievements and promotion notices, all from one login.",
    links: [
      { text: 'Family features', url: '/martial-arts-software/' }
    ]
  },
  {
    question: "How much does karate school software cost?",
    answer: "When we checked competitors' published pricing in November 2026, the main martial arts platforms ranged from about $49 to $350 a month, depending on student numbers and features. BeltManager is free until 31 March 2027, with no subscription and no per-student fees.",
    links: [
      { text: 'View pricing', url: '/pricing/' },
      { text: 'Compare features', url: '/martial-arts-software/' }
    ]
  },
  {
    question: "Can I try it before committing?",
    answer: "BeltManager is free until 31 March 2027, so there's nothing to trial: sign up, import some students from a spreadsheet, and see if it suits your dojo. No credit card needed.",
    links: [
      { text: 'Get started free', url: 'https://app.beltmanager.com/signin' },
      { text: 'Setup guide', url: '/martial-arts-software/' }
    ]
  },
  {
    question: "What's the difference between karate software and general gym software?",
    answer: "Karate software understands kyu/dan grades, kata syllabuses and grading cycles, and uses karate terms (sensei, dojo, gi, kata) instead of generic gym language. General gym software can't track belt progression or tell you who is ready to grade.",
    links: [
      { text: 'Karate vs gym software', url: '/martial-arts-software/' },
      { text: 'Dojo management guide', url: '/dojo-management-software/' }
    ]
  },
  {
    question: "Does BeltManager connect to my association or federation?",
    answer: "No. BeltManager doesn't connect to governing bodies (JKA, SKA, WKF and so on) or track federation licences and dues. You can set up your association's grade structure and grading criteria yourself.",
    links: [
      { text: 'Dojo management', url: '/dojo-management-software/' }
    ]
  },
  {
    question: "How long does it take to get started?",
    answer: "Sign-up is self-serve. Set up your grades and kata, import your students from a spreadsheet (up to 1,000 rows, with guardians and current belts), and invite families to the parent app. How long the full switch takes depends on your dojo.",
    links: [
      { text: 'Implementation guide', url: '/martial-arts-software/' },
      { text: 'Contact support', url: '/contact/' }
    ]
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.slice(0, 7).map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<BaseLayout
  title="Karate School Software (2026)"
  description="Kyu/dan belt tracking, kata progression, gradings with printable certificates, and scheduling built for karate dojos. Free until 31 March 2027."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <!-- Breadcrumbs -->
  <BreadcrumbsEnhanced
    site="beltmanager"
    items={[
      { label: 'Home', href: '/' },
      { label: 'Karate School Software', href: '/karate-school-software/' }
    ]}
  />

  <!-- Hero Section -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block px-4 py-2 mb-4 text-sm font-semibold text-brand-red bg-brand-red-light rounded-full">Complete Guide</span>
        <h1 class="text-4xl md:text-5xl font-bold text-brand-navy mb-4">Karate School Software</h1>
        <p class="text-xl text-gray-600">
          Management software for karate dojos. Kyu-dan belt tracking, kata progression, grading eligibility, and family accounts built for traditional karate instruction.
        </p>
      </div>
    </div>
  </section>

  <!-- Featured Answer -->
  <FeaturedAnswer question="What is karate school software?">
    Karate school software is a management platform designed specifically for karate dojos. It handles student records, kyu-dan belt progression, kata curriculum tracking, class scheduling and gradings, using karate terminology and workflows. It tracks students through the kyu grades to dan ranks, records kata progress, shows who is eligible to grade, and manages family accounts.
  </FeaturedAnswer>

  <!-- Main Content -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto prose prose-lg">

        <h2>Management Solutions Built for Karate Dojos</h2>

        <p>
          Karate instruction follows a structured path developed over generations: the systematic progression through belt ranks, the refinement of kata, the cultivation of both physical technique and mental discipline. Running a karate school in the modern era requires balancing these time-tested traditions with contemporary business demands.
        </p>

        <p>
          Karate school software bridges this divide by handling administrative complexity while respecting the pedagogical structures that define karate education. From tracking students through the kyu ranks to managing kihon, kata, and kumite curriculum requirements, purpose-built software supports rather than disrupts the training methodology you have established.
        </p>

        <AppScreenshot src="/images/app/karate-dashboard.webp" width={1600} height={1000} caption="The dashboard filtered to one dojo: tonight's classes, students ready to grade, and attendance over the last 30 days" />

        <h3>The Kyu-Dan Ranking System</h3>

        <p>
          Karate follows a colored belt progression through kyu grades before reaching dan (black belt) ranks. While belt colors vary by style and organization, the structure remains consistent:
        </p>

        <ul>
          <li><strong>10th-9th Kyu (White/Yellow):</strong> Basic stances, fundamental blocks and strikes</li>
          <li><strong>8th-7th Kyu (Orange/Red):</strong> Basic kata, combination techniques, stance work</li>
          <li><strong>6th-5th Kyu (Green):</strong> Intermediate kata, sparring introduction, timing</li>
          <li><strong>4th-3rd Kyu (Purple/Blue):</strong> Advanced kata, free sparring, self-defense</li>
          <li><strong>2nd-1st Kyu (Brown):</strong> Black belt kata, teaching basics, competition preparation</li>
          <li><strong>1st Dan+ (Black):</strong> Advanced study, teaching responsibilities, style mastery</li>
        </ul>

        <p>
          Software must track not just current rank but progression history, time-in-rank, attendance requirements, and specific technique mastery at each level.
        </p>

        <AppScreenshot src="/images/app/karate-kata-syllabus.webp" width={1600} height={1618} caption="The technique syllabus: Shotokan kata and kumite mapped to the kyu grade they are taught at" />

        <h3>Curriculum Components: Kihon, Kata, and Kumite</h3>

        <p><strong>Kihon (Basics):</strong></p>
        <p>
          Fundamental techniques including stances, blocks, strikes, and kicks practiced in isolation and combination. Mastery at each level requires demonstrating specific kihon elements.
        </p>

        <p><strong>Kata (Forms):</strong></p>
        <p>
          Choreographed sequences representing combat scenarios. Each rank requires learning specific kata. Software should track which kata students have learned and are currently studying. Want to understand the complete belt system? See our <a href="/blog/karate-belts/">karate belt colors and order guide</a>.
        </p>

        <p><strong>Kumite (Sparring):</strong></p>
        <p>
          Partner practice ranging from pre-arranged drills to free sparring. Different ranks introduce different sparring formats with progressive contact levels.
        </p>

        <p>
          Effective karate software provides curriculum tracking across all three areas, ensuring students meet requirements before testing.
        </p>

      </div>
    </div>
  </section>

  <!-- Comparison Table -->
  <section class="section bg-gray-50">
    <div class="container-custom">
      <div class="max-w-5xl mx-auto">
        <ComparisonTable
          title="Karate Software vs General Martial Arts vs Manual Tracking"
          headers={['BeltManager (Karate-Specific)', 'Generic Martial Arts', 'Spreadsheets']}
          rows={comparisonData}
        />
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto prose prose-lg">

        <h2>Essential Features for Karate Schools</h2>

        <h3>1. Belt Progression Tracking</h3>
        <ul>
          <li>Complete kyu and dan tracking with custom belt colors</li>
          <li>Style-specific configurations (Shotokan, Goju-Ryu, Shito-Ryu, Wado-Ryu)</li>
          <li>Time-in-rank counters with minimum requirements</li>
          <li>Attendance thresholds per rank</li>
          <li>Stripe and tip tracking for interim achievements</li>
          <li>Promotion history for every student</li>
        </ul>

        <AppScreenshot src="/images/app/karate-belt-testing.webp" width={1600} height={1000} caption="Students filtered to those eligible for their next grading, with current belt and group" />

        <h3>2. Kata Library and Progress</h3>
        <ul>
          <li>Complete kata list by style and level</li>
          <li>Student progress showing learned vs. current kata</li>
          <li>Kata requirements mapped to belt ranks</li>
          <li>Kata readiness: ready, almost, or not yet</li>
          <li>Video links on each kata or technique</li>
          <li>Per-student session notes from instructors</li>
        </ul>

        <h3>3. Testing and Grading Management</h3>
        <ul>
          <li>Grading sessions with each student's current and target grade</li>
          <li>Eligibility checking (time at grade and sessions attended)</li>
          <li>One-tap pass or not-passed results</li>
          <li>Printable rank certificates with your school's logo</li>
          <li>Promotion notice to the family by email and app push</li>
          <li>Grades updated automatically after a pass</li>
        </ul>

        <AppScreenshot src="/images/app/karate-parent-portal.webp" width={1200} height={1700} caption="The parent portal: each child's belt and their classes for the next two weeks, with one-tap attending or not attending" />

        <h3>4. Family and Youth Focus</h3>
        <ul>
          <li>Family accounts linking parents and children</li>
          <li>Parent portal and free parent app</li>
          <li>Age and belt range on each group (warns, doesn't block)</li>
          <li>Achievements and badges, with a notice to the family</li>
          <li>Safeguarding: minors' data erased properly when they leave</li>
          <li>Coming April 2027: sibling discounts on one family invoice</li>
        </ul>

        <h2>Style-Specific Considerations</h2>

        <h3>Belt Color Variations</h3>
        <p>
          While the kyu-dan structure remains consistent, colors differ across styles. Shotokan traditionally uses white, yellow, orange, green, purple, brown, and black. Other styles may include additional colors or different sequences. Software should allow custom color configuration for each rank.
        </p>

        <h3>Organization Requirements</h3>
        <p>
          Many karate schools affiliate with larger organisations (JKA, SKA, WKF, ISKF and so on) that set their own grading requirements. BeltManager doesn't connect to these bodies, but you can set up their grade structure, minimum time at grade and session requirements yourself.
        </p>

        <h2>Related Resources</h2>

        <ul>
          <li><a href="/martial-arts-software/">Martial Arts Software Overview</a> — Complete platform comparison</li>
          <li><a href="/dojo-management-software/">Dojo Management Software</a> — Traditional dojo features</li>
          <li><a href="/blog/karate-belts/">Karate Belt System Guide</a> — Understanding kyu-dan ranks</li>
          <li><a href="/blog/karate-belt-order-complete-guide/">Complete Karate Belt Order</a> — Detailed progression guide</li>
          <li><a href="/martial-arts-billing-software/">Billing Software Features</a> — Memberships today, card billing from April 2027</li>
        </ul>

      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <FAQEnhanced
    site="beltmanager"
    pageUrl="https://beltmanager.com/karate-school-software/"
    title="Frequently Asked Questions About Karate School Software"
    faqs={faqItems}
  />

  <!-- CTA Section -->
  <section class="section bg-brand-red text-white">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-bold mb-4">Ready to Streamline Your Karate Dojo?</h2>
        <p class="text-xl mb-8 opacity-95">
          See how BeltManager handles your karate school's admin: belt tracking, kata progress, gradings and certificates.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="https://app.beltmanager.com/signin" class="btn-primary-large bg-white text-brand-red hover:bg-gray-100">Get started free</a>
          <a href="/pricing/" class="btn-secondary-large border-white text-white hover:bg-white hover:bg-opacity-10">View Pricing</a>
        </div>
        <p class="mt-6 text-sm opacity-90">Free until 31 March 2027 • No credit card • No contract</p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .section {
    padding: 4rem 0;
  }

  .prose {
    max-width: none;
  }

  .prose h2 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--brand-navy);
    margin-top: 3rem;
    margin-bottom: 1.5rem;
  }

  .prose h3 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--brand-navy);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose p {
    margin-bottom: 1.5rem;
    color: #475569;
    line-height: 1.7;
  }

  .prose ul {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
    color: #475569;
  }

  .prose strong {
    color: var(--brand-navy);
    font-weight: 600;
  }

  .prose a {
    color: var(--brand-red);
    text-decoration: none;
  }

  .prose a:hover {
    text-decoration: underline;
  }

  .btn-primary-large,
  .btn-secondary-large {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    border-radius: 8px;
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-primary-large:hover,
  .btn-secondary-large:hover {
    transform: translateY(-2px);
  }

  .btn-secondary-large {
    border: 2px solid;
  }

  @media (max-width: 768px) {
    .section {
      padding: 3rem 0;
    }

    .prose h2 {
      font-size: 1.5rem;
    }

    .prose h3 {
      font-size: 1.25rem;
    }
  }
</style>
