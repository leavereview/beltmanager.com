---
import { appLink } from '../utils/appLink';
import AppScreenshot from '../components/AppScreenshot.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbsEnhanced from '../components/seo/BreadcrumbsEnhanced.astro';
import FeaturedAnswer from '../components/seo/FeaturedAnswer.astro';
import ComparisonTable from '../components/seo/ComparisonTable.astro';
import FAQEnhanced from '../components/seo/FAQEnhanced.astro';

const comparisonData = [
  {
    label: 'Kyu/Dan Belt Tracking',
    values: [true, true, false],
    highlight: true
  },
  {
    label: 'Kata Library & Progress',
    values: [true, false, false],
    highlight: true
  },
  {
    label: 'Style-Specific Customization',
    values: [true, false, false],
    highlight: true
  },
  {
    label: 'Automated Testing Eligibility',
    values: [true, true, false]
  },
  {
    label: 'Family Account Management',
    values: [true, true, false]
  },
  {
    label: 'Curriculum Tracking (Kihon/Kata/Kumite)',
    values: [true, false, false]
  },
  {
    label: 'Stripe/Tip Tracking',
    values: [true, false, false]
  },
  {
    label: 'Printable Rank Certificates',
    values: [true, true, false]
  },
  {
    label: 'Monthly Price',
    values: ['Free', '£120', '£0']
  }
];

const faqItems = [
  {
    question: "What is karate school software?",
    answer: "Karate school software is a management platform designed specifically for karate dojos. It handles student databases, kyu-dan belt progression, kata curriculum tracking, class scheduling, testing management, and billing while using karate-appropriate terminology and workflows. Software tracks students through 10 kyu grades to black belt dan ranks, monitors kata mastery, automates testing eligibility, and manages family accounts common in traditional karate schools.",
    links: [
      { text: 'View all features', url: '/martial-arts-software/' },
      { text: 'See pricing', url: '/pricing/' }
    ]
  },
  {
    question: "Can karate software track kata progress?",
    answer: "Yes. In BeltManager you build a technique and kata list for each belt, with an optional video link for each. Each student's record shows their readiness on every kata (Ready, Almost or Not ready), and instructors can keep notes on individual students after each class. You can map kata to belts for any style, such as Shotokan, Goju-Ryu, Shito-Ryu or Wado-Ryu.",
    links: [
      { text: 'Curriculum features', url: '/martial-arts-software/' },
      { text: 'Karate belt guide', url: '/blog/karate-belts/' }
    ]
  },
  {
    question: "How does belt testing work in karate software?",
    answer: "BeltManager uses attendance and time at belt to show who is ready to grade, against the minimums you set for each belt. You add students to a grading session and record pass or not passed with one tap. A pass updates their belt, families are told by email and in the parent app, and you can print a rank certificate. Grading fees can be raised as a one-off invoice; online grading registration isn't available yet.",
    links: [
      { text: 'Testing management', url: '/martial-arts-software/' },
      { text: 'Belt system explained', url: '/blog/karate-belt-order-complete-guide/' }
    ]
  },
  {
    question: "Does karate software support different styles?",
    answer: "Yes, configurable systems support various karate styles (Shotokan, Goju-Ryu, Shito-Ryu, Wado-Ryu, Kyokushin) with custom belt colors, kata lists, and testing requirements specific to each style's traditions. You can manage multiple styles within the same dojo, track style-specific curriculum, and maintain separate rank progressions. Many schools teaching both traditional and sport karate use different curriculum tracks within one system.",
    links: [
      { text: 'Style customization', url: '/martial-arts-software/' },
      { text: 'Karate styles overview', url: '/blog/types-of-martial-arts/' }
    ]
  },
  {
    question: "Can parents manage children's accounts?",
    answer: "Yes. Parents sign in once to the parent portal or the free iPhone app and see every child's belt and upcoming classes, answer whether each child is coming, sign waivers, and get promotion and achievement notices. Children's own email addresses are never used; messages go to their guardians.",
    links: [
      { text: 'Family features', url: '/martial-arts-software/' }
    ]
  },
  {
    question: "How much does karate school software cost?",
    answer: "Most karate software costs £50-150 per month depending on student count and features. Smaller schools (under 75 students) typically find options at £50-80 monthly. Mid-size schools (75-200 students) pay £80-120. Larger academies or multi-location operations pay £120-200. Pricing models include flat-rate (unlimited students) or per-student (£1-2 per active student). BeltManager is free until 31 March 2027 — no subscription and no per-student fees.",
    links: [
      { text: 'View pricing', url: '/pricing/' },
      { text: 'Compare features', url: '/martial-arts-software/' }
    ]
  },
  {
    question: "Can I try karate software before committing?",
    answer: "Most karate school software providers offer free trials ranging from 14 to 30 days. This allows you to test features with your actual student data, train your staff on the platform, evaluate how well it fits your dojo operations, and assess whether students and parents adopt the system easily. BeltManager is free until 31 March 2027, so there is nothing to trial — full feature access, no credit card, and onboarding support included.",
    links: [
      { text: 'Get started free', url: appLink(Astro.url.pathname, 'faq') },
      { text: 'Setup guide', url: '/martial-arts-software/' }
    ]
  },
  {
    question: "What's the difference between karate software and general gym software?",
    answer: "Karate-specific software understands kyu-dan rank systems with 10 kyu grades before black belt, tracks kata curriculum progress across kihon/kata/kumite components, manages testing cycles with eligibility automation, and uses appropriate terminology (sensei, dojo, gi, kata) instead of generic gym language (trainer, facility, uniform, workout). General gym software can't track belt progression, doesn't understand age-based dan rank restrictions, and lacks kata library management.",
    links: [
      { text: 'Karate vs gym software', url: '/martial-arts-software/' },
      { text: 'Dojo management guide', url: '/dojo-management-software/' }
    ]
  },
  {
    question: "Can I follow my association's grading rules?",
    answer: "You can set your own kyu and dan ladder, belt colours, minimum time at each belt and minimum sessions to match your association's (JKA, SKA, WKF, ISKF and so on) rules. BeltManager doesn't connect to governing bodies, track federation licences or handle competition registration.",
    links: [
      { text: 'Grading features', url: '/martial-arts-software/' }
    ]
  },
  {
    question: "How long does it take to set up BeltManager?",
    answer: "Setup is self-serve. Add your kyu and dan ladder, kata lists and classes, add your students (or send us your list to import), put them into their groups and take your first register.",
    links: [
      { text: 'Implementation guide', url: '/martial-arts-software/' },
      { text: 'Contact support', url: '/contact/' }
    ]
  }
];
---

<BaseLayout
  title="Karate School Software (2026)"
  description="Kyu/dan belt tracking, kata readiness, gradings and registers built for karate dojos. Free until 31 March 2027."
>
  <!-- Breadcrumbs -->
  <BreadcrumbsEnhanced
    site="beltmanager"
    items={[
      { label: 'Home', href: '/' },
      { label: 'Karate School Software', href: '/karate-school-software/' }
    ]}
  />

  <!-- Hero Section -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block px-4 py-2 mb-4 text-sm font-semibold text-brand-red bg-brand-red-light rounded-full">Complete Guide</span>
        <h1 class="text-4xl md:text-5xl font-bold text-brand-navy mb-4">Karate School Software</h1>
        <p class="text-xl text-gray-600">
          Complete management software for karate dojos. Kyu-dan belt tracking, kata progression, automated testing eligibility, and family account management built specifically for traditional karate instruction.
        </p>
      </div>
    </div>
  </section>

  <!-- Featured Answer -->
  <FeaturedAnswer question="What is karate school software?">
    Karate school software is a management platform designed specifically for karate dojos. It handles student databases, kyu-dan belt progression, kata curriculum tracking, class scheduling, testing management, and billing while using karate-appropriate terminology and workflows. Software tracks students through 10 kyu grades to black belt dan ranks, monitors kata mastery, automates testing eligibility, and manages family accounts.
  </FeaturedAnswer>

  <!-- Statistics Section -->
  <!-- Main Content -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto prose prose-lg">

        <h2>Management Solutions Built for Karate Dojos</h2>

        <p>
          Karate instruction follows a structured path developed over generations: the systematic progression through belt ranks, the refinement of kata, the cultivation of both physical technique and mental discipline. Running a karate school in the modern era requires balancing these time-tested traditions with contemporary business demands.
        </p>

        <p>
          Karate school software bridges this divide by handling administrative complexity while respecting the pedagogical structures that define karate education. From tracking students through the kyu ranks to managing kihon, kata, and kumite curriculum requirements, purpose-built software supports rather than disrupts the training methodology you have established.
        </p>

        <AppScreenshot src="/images/app/karate-dashboard.webp" width={1600} height={1000} caption="The dashboard filtered to one dojo: tonight's classes, students ready to grade, and attendance over the last 30 days" />

        <h3>The Kyu-Dan Ranking System</h3>

        <p>
          Karate follows a colored belt progression through kyu grades before reaching dan (black belt) ranks. While belt colors vary by style and organization, the structure remains consistent:
        </p>

        <ul>
          <li><strong>10th-9th Kyu (White/Yellow):</strong> Basic stances, fundamental blocks and strikes</li>
          <li><strong>8th-7th Kyu (Orange/Red):</strong> Basic kata, combination techniques, stance work</li>
          <li><strong>6th-5th Kyu (Green):</strong> Intermediate kata, sparring introduction, timing</li>
          <li><strong>4th-3rd Kyu (Purple/Blue):</strong> Advanced kata, free sparring, self-defense</li>
          <li><strong>2nd-1st Kyu (Brown):</strong> Black belt kata, teaching basics, competition preparation</li>
          <li><strong>1st Dan+ (Black):</strong> Advanced study, teaching responsibilities, style mastery</li>
        </ul>

        <p>
          Software must track not just current rank but progression history, time-in-rank, attendance requirements, and specific technique mastery at each level.
        </p>

        <AppScreenshot src="/images/app/karate-kata-syllabus.webp" width={1600} height={1618} caption="The technique syllabus: Shotokan kata and kumite mapped to the kyu grade they are taught at" />

        <h3>Curriculum Components: Kihon, Kata, and Kumite</h3>

        <p><strong>Kihon (Basics):</strong></p>
        <p>
          Fundamental techniques including stances, blocks, strikes, and kicks practiced in isolation and combination. Mastery at each level requires demonstrating specific kihon elements.
        </p>

        <p><strong>Kata (Forms):</strong></p>
        <p>
          Choreographed sequences representing combat scenarios. Each rank requires learning specific kata. Software should track which kata students have learned and are currently studying. Want to understand the complete belt system? See our <a href="/blog/karate-belts/">karate belt colors and order guide</a>.
        </p>

        <p><strong>Kumite (Sparring):</strong></p>
        <p>
          Partner practice ranging from pre-arranged drills to free sparring. Different ranks introduce different sparring formats with progressive contact levels.
        </p>

        <p>
          Effective karate software provides curriculum tracking across all three areas, ensuring students meet requirements before testing.
        </p>

      </div>
    </div>
  </section>

  <!-- Comparison Table -->
  <section class="section bg-gray-50">
    <div class="container-custom">
      <div class="max-w-5xl mx-auto">
        <ComparisonTable
          title="Karate Software vs General Martial Arts vs Manual Tracking"
          headers={['BeltManager (Karate-Specific)', 'Generic Martial Arts', 'Spreadsheets']}
          rows={comparisonData}
        />
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto prose prose-lg">

        <h2>Essential Features for Karate Schools</h2>

        <h3>1. Belt Progression Tracking</h3>
        <ul>
          <li>Complete kyu and dan tracking with custom belt colors</li>
          <li>Style-specific configurations (Shotokan, Goju-Ryu, Shito-Ryu, Wado-Ryu)</li>
          <li>Time-in-rank counters with minimum requirements</li>
          <li>Attendance thresholds per rank</li>
          <li>Stripes and tips on the belt badge</li>
          <li>Your association's minimums, set per belt</li>
        </ul>

        <AppScreenshot src="/images/app/karate-belt-testing.webp" width={1600} height={1000} caption="Students filtered to those eligible for their next grading, with current belt and group" />

        <h3>2. Kata Library and Progress</h3>
        <ul>
          <li>Complete kata list by style and level</li>
          <li>Student progress showing learned vs. current kata</li>
          <li>Kata requirements mapped to belt ranks</li>
          <li>Readiness on each kata: Ready, Almost or Not ready</li>
          <li>Video links for each kata</li>
          <li>Per-student notes after each class</li>
        </ul>

        <h3>3. Testing and Grading Management</h3>
        <ul>
          <li>Ready-to-grade list from attendance and time at belt</li>
          <li>Grading sessions with the students you choose</li>
          <li>One-tap pass or not-passed results</li>
          <li>Printable rank certificates</li>
          <li>Belt updated automatically on a pass</li>
          <li>Promotion notices to families by email and in the parent app</li>
        </ul>

        <AppScreenshot src="/images/app/karate-parent-portal.webp" width={1200} height={1700} caption="The parent portal: each child's belt and their classes for the next two weeks, with one-tap attending or not attending" />

        <h3>4. Family and Youth Focus</h3>
        <ul>
          <li>Family accounts linking parents and children</li>
          <li>Sibling discount on the family invoice</li>
          <li>Parent portal for youth student management</li>
          <li>Age-appropriate program assignment</li>
          <li>Messages to a single class or the whole school</li>
          <li>Report cards and achievements for parents</li>
        </ul>

        <h2>Style-Specific Considerations</h2>

        <h3>Belt Color Variations</h3>
        <p>
          While the kyu-dan structure remains consistent, colors differ across styles. Shotokan traditionally uses white, yellow, orange, green, purple, brown, and black. Other styles may include additional colors or different sequences. Software should allow custom color configuration for each rank.
        </p>

        <h3>Organization Requirements</h3>
        <p>
          Many karate schools affiliate with larger organizations (JKA, SKA, WKF, ISKF, etc.) that impose specific testing requirements. In BeltManager you set the minimum time and sessions for each belt to match your association's rules. BeltManager doesn't connect to governing bodies or track federation licences.
        </p>

        <h2>Related Resources</h2>

        <ul>
          <li><a href="/martial-arts-software/">Martial Arts Software Overview</a> — Complete platform comparison</li>
          <li><a href="/dojo-management-software/">Dojo Management Software</a> — Traditional dojo features</li>
          <li><a href="/blog/karate-belts/">Karate Belt System Guide</a> — Understanding kyu-dan ranks</li>
          <li><a href="/blog/karate-belt-order-complete-guide/">Complete Karate Belt Order</a> — Detailed progression guide</li>
          <li><a href="/martial-arts-billing-software/">Billing Software Features</a> — Payment processing details</li>
        </ul>

      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <FAQEnhanced
    site="beltmanager"
    pageUrl="https://beltmanager.com/karate-school-software/"
    title="Frequently Asked Questions About Karate School Software"
    faqs={faqItems}
  />

  <!-- CTA Section -->
  <section class="section bg-brand-red text-white">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-bold mb-4">Ready to Streamline Your Karate Dojo?</h2>
        <p class="text-xl mb-8 opacity-95">
          Belt tracking, kata readiness and a ready-to-grade list built from your registers. Free until 31 March 2027.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={appLink(Astro.url.pathname, 'bottom')} class="btn-primary-large bg-white text-brand-red hover:bg-gray-100">Get started free</a>
          <a href="/pricing/" class="btn-secondary-large border-white text-white hover:bg-white hover:bg-opacity-10">View Pricing</a>
        </div>
        <p class="mt-6 text-sm opacity-90">Free until 31 March 2027 • No credit card • No contract</p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .section {
    padding: 4rem 0;
  }

  .prose {
    max-width: none;
  }

  .prose h2 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--brand-navy);
    margin-top: 3rem;
    margin-bottom: 1.5rem;
  }

  .prose h3 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--brand-navy);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose p {
    margin-bottom: 1.5rem;
    color: #475569;
    line-height: 1.7;
  }

  .prose ul {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
    color: #475569;
  }

  .prose strong {
    color: var(--brand-navy);
    font-weight: 600;
  }

  .prose a {
    color: var(--brand-red);
    text-decoration: none;
  }

  .prose a:hover {
    text-decoration: underline;
  }

  .btn-primary-large,
  .btn-secondary-large {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    border-radius: 8px;
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-primary-large:hover,
  .btn-secondary-large:hover {
    transform: translateY(-2px);
  }

  .btn-secondary-large {
    border: 2px solid;
  }

  @media (max-width: 768px) {
    .section {
      padding: 3rem 0;
    }

    .prose h2 {
      font-size: 1.5rem;
    }

    .prose h3 {
      font-size: 1.25rem;
    }
  }
</style>
