---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbsEnhanced from '../components/seo/BreadcrumbsEnhanced.astro';
import FeaturedAnswer from '../components/seo/FeaturedAnswer.astro';
import ComparisonTable from '../components/seo/ComparisonTable.astro';
import FAQEnhanced from '../components/seo/FAQEnhanced.astro';

const comparisonData = [
  {
    label: 'Automatic class reminders (email and app push)',
    values: [true, 'Varies', false],
    highlight: true
  },
  {
    label: 'Pre-class RSVP with one-tap answers',
    values: [true, 'Varies', false],
    highlight: true
  },
  {
    label: 'Minimum/maximum belt and age on a group (warns)',
    values: [true, false, false],
    highlight: true
  },
  {
    label: 'Recurring weekly timetable',
    values: [true, true, 'Manual']
  },
  {
    label: 'Term dates, closures and cancellation notices to families',
    values: [true, 'Varies', 'Manual']
  },
  {
    label: 'Instructor-to-student ratio warnings',
    values: [true, false, 'Manual']
  },
  {
    label: 'Family accounts with guardians',
    values: [true, 'Varies', false]
  },
  {
    label: 'Attendance report with CSV export',
    values: [true, 'Varies', 'Manual']
  }
];

const faqItems = [
  {
    question: "What is martial arts scheduling software?",
    answer: "Martial arts scheduling software runs your class timetable around the way a martial arts school works: classes grouped by age and belt, families with more than one child training, gradings, and term dates. In BeltManager you set up your recurring classes once, families get reminders and answer an RSVP before class, and your register and attendance report come from the same timetable.",
    links: [
      { text: 'View all features', url: '/martial-arts-software/' },
      { text: 'See pricing', url: '/pricing/' }
    ]
  },
  {
    question: "How do class reminders work?",
    answer: "On the day of a class, BeltManager emails families (and sends a push notification to the free parent app) about three hours before it starts. You can also switch on an RSVP request for a class: families are asked between 1 and 14 days ahead whether their child is coming, and answer with one tap. If they can't make it, they give a reason, so you know who to expect tonight.",
    links: [
      { text: 'CRM features', url: '/martial-arts-crm/' },
      { text: 'Contact us', url: '/contact/' }
    ]
  },
  {
    question: "Can students book their own classes?",
    answer: "Not yet. You add students to the classes (groups) they train in, and families then RSVP to those classes from the parent app or portal. There's no open booking calendar or waitlist today.",
    links: [
      { text: 'Dojo management', url: '/dojo-management-software/' },
      { text: 'Get started free', url: 'https://app.beltmanager.com/signin' }
    ]
  },
  {
    question: "Can I restrict a class by belt?",
    answer: "Yes. You can set a minimum and maximum belt (and an age range) on a group. If you add a student outside that range, BeltManager warns you. It doesn't block you, so you can still let a student try the next level up.",
    links: [
      { text: 'Karate school features', url: '/karate-school-software/' },
      { text: 'BJJ features', url: '/bjj-gym-software/' }
    ]
  },
  {
    question: "Can I manage more than one instructor?",
    answer: "Yes. You can invite staff with their own sign-in as head instructor, assistant or front desk, and name the instructor on each class. BeltManager also checks your instructor-to-student ratio against your insurer's rules. It doesn't keep separate instructor calendars, cover rotas or teaching-hour totals.",
    links: [
      { text: 'Overview', url: '/martial-arts-software/' },
      { text: 'See pricing', url: '/pricing/' }
    ]
  },
  {
    question: "How do recurring classes work?",
    answer: "Set the days of the week and the time for each class, for example \"Kids Karate, Monday and Wednesday at 4pm\", and BeltManager creates the sessions for you. Add term dates and closed periods (bank holidays, summer break) and families are told automatically when a class is cancelled, moved or closed.",
    links: [
      { text: 'Karate features', url: '/karate-school-software/' },
      { text: 'Get started free', url: 'https://app.beltmanager.com/signin' }
    ]
  },
  {
    question: "Can I schedule private lessons?",
    answer: "Not at the moment. BeltManager is built around group classes. You can add a one-off event, but there are no bookable private-lesson slots or lesson packages.",
    links: [
      { text: 'Overview', url: '/martial-arts-software/' },
      { text: 'Contact us', url: '/contact/' }
    ]
  },
  {
    question: "How does it work for families?",
    answer: "Parents see all their children's classes in one place, in the free parent app or the web portal, and can add the timetable to their phone's calendar. Reminders, RSVP requests and closure notices go to every guardian on the account.",
    links: [
      { text: 'Dojo management', url: '/dojo-management-software/' },
      { text: 'Get started free', url: 'https://app.beltmanager.com/signin' }
    ]
  },
  {
    question: "What attendance reports are available?",
    answer: "The attendance report shows attendance by class and by student for any date range, and you can export it as a CSV file. Your dashboard also shows the last 30 days at a glance.",
    links: [
      { text: 'Overview', url: '/martial-arts-software/' },
      { text: 'Contact us', url: '/contact/' }
    ]
  }
];

const breadcrumbItems = [
  { label: 'Home', url: 'https://beltmanager.com/' },
  { label: 'Scheduling Software', url: 'https://beltmanager.com/martial-arts-scheduling-software/' }
];
---

<BaseLayout
  title="Martial Arts Scheduling & Class Timetable Software"
  description="Recurring classes, reminders, one-tap RSVPs, belt and age bands on groups, and term dates with automatic closure notices. Built for martial arts schools. Free until 31 March 2027."
>
  <BreadcrumbsEnhanced site="beltmanager" items={breadcrumbItems} />

  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block bg-red-50 text-red-600 px-4 py-2 rounded-full text-sm font-semibold mb-6">
          Complete Guide to Scheduling Software
        </span>
        <h1 class="text-4xl md:text-5xl font-bold text-navy mb-6">
          Martial Arts Scheduling Software
        </h1>
        <p class="text-xl text-gray-600 mb-8">
          Set up your timetable once, remind families automatically, and know who's coming tonight before you unlock the doors. Scheduling built for martial arts schools.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="https://app.beltmanager.com/signin" class="btn-primary">Get started free</a>
          <a href="/pricing/" class="btn-secondary">View Pricing</a>
        </div>
      </div>
    </div>
  </section>

  <FeaturedAnswer question="What is martial arts scheduling software?">
    Martial arts scheduling software runs a school's recurring class timetable, reminds families before class, collects RSVPs, and flags students who are outside a class's belt or age range. BeltManager also handles term dates and closures, telling families automatically when a class is cancelled or moved.
  </FeaturedAnswer>

  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto prose prose-lg">
        <h2>Why Martial Arts Schools Need Specialised Scheduling</h2>
        <p>
          A martial arts timetable isn't just a list of time slots. Classes are split by age and belt, parents often have two or three children training, gradings and competitions come round every few months, and many clubs follow school term dates. Generic booking tools don't know any of that.
        </p>
        <p>
          With paper or a spreadsheet, the same questions come round every week: is the class on during half term, who's coming tonight, and is that new white belt really in the right group? BeltManager is built to answer those questions for you.
        </p>

        <h2>Automatic Class Reminders</h2>
        <p>
          On the day of each class, BeltManager emails families about three hours before it starts, and sends a push notification to anyone using the free parent app. Families can also add your timetable to Apple Calendar or Google Calendar.
        </p>

        <h2>Know Who's Coming: One-Tap RSVP</h2>
        <p>
          Switch on an RSVP request for a class and families are asked, between 1 and 14 days ahead, whether their child is coming. They answer with one tap: "Coming" or "Can't make it". If they can't make it, they give a reason. You see the answers before the class starts.
        </p>

        <h2>Belt and Age Bands on Groups</h2>
        <p>
          Set a minimum and maximum belt and an age range on each group. If you add a student who's outside that range, BeltManager warns you before you save. It's a warning, not a block, so you can still move a talented student up early.
        </p>

        <h2>Recurring Classes, Term Dates and Closures</h2>
        <p>
          Most schools run the same timetable every week. Set the days and time for each class once and BeltManager creates the sessions. Add your venues and rooms if you train in more than one place.
        </p>
        <p>
          Add term dates and closed periods, such as bank holidays or the summer break, and families are told automatically when a class is cancelled, moved or closed. No more group texts on a Sunday night.
        </p>

        <h2>Staff and Instructor Ratios</h2>
        <p>
          Invite staff with their own sign-in as head instructor, assistant or front desk, and name the instructor on each class. BeltManager checks the instructor-to-student ratio and your insured student count, so you can show your insurer you're within the rules.
        </p>

        <h2>Registers and Attendance</h2>
        <p>
          Take the register from a tablet or phone, even when the signal in the hall drops out: it syncs when you're back online. Add walk-ins on the spot. Or set up a tablet kiosk at the door, locked with a PIN, where students check themselves in.
        </p>
        <p>
          The attendance report shows attendance by class and by student for any date range, and exports to CSV for your insurer, your gradings or your own records.
        </p>

        <h2>The Free Parent App</h2>
        <p>
          Parents get a free app for iPhone and Android. They can see their children's classes, answer RSVPs, get reminders and closure notices, and see belt progress and achievements.
        </p>

        <h2>What BeltManager Doesn't Do (Yet)</h2>
        <p>
          We'd rather you know before you sign up. Today there's no open booking calendar, no class waitlist, no private-lesson booking or packages, and no SMS reminders. You enrol students into their groups, and families RSVP to those classes.
        </p>

        <h2>Getting Started with BeltManager Scheduling</h2>
        <p>
          Sign up, add your classes and groups, and import your students from a spreadsheet (up to 1,000 rows, with their guardians). If an import goes wrong, you can undo it within 24 hours. Then invite families to the parent app.
        </p>
      </div>
    </div>
  </section>

  <ComparisonTable
    title="BeltManager vs Generic Booking Tools vs Spreadsheets"
    headers={['BeltManager (Martial Arts-Specific)', 'Generic Booking Tools', 'Spreadsheets/Paper']}
    rows={comparisonData}
  />

  <FAQEnhanced
    site="beltmanager"
    pageUrl="https://beltmanager.com/martial-arts-scheduling-software/"
    title="Frequently Asked Questions About Martial Arts Scheduling Software"
    faqs={faqItems}
  />

  <section class="section bg-navy text-white">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">
          Ready to Sort Out Your Timetable?
        </h2>
        <p class="text-xl mb-8 text-gray-300">
          Recurring classes, reminders, RSVPs and closure notices in one place. Free until 31 March 2027.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="https://app.beltmanager.com/signin" class="btn-primary">Get started free</a>
          <a href="/pricing/" class="btn-secondary bg-white text-navy hover:bg-gray-100">View Pricing</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    padding: 4rem 0;
  }

  @media (min-width: 768px) {
    .section {
      padding: 6rem 0;
    }
  }

  .prose {
    color: #1a1a2e;
  }

  .prose h2 {
    color: #1a1a2e;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose p {
    margin-bottom: 1.25rem;
    line-height: 1.75;
  }

  .prose a {
    color: #e94560;
    text-decoration: none;
  }

  .prose a:hover {
    text-decoration: underline;
  }
</style>
