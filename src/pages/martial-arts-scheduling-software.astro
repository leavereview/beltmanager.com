---
import { appLink } from '../utils/appLink';
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbsEnhanced from '../components/seo/BreadcrumbsEnhanced.astro';
import FeaturedAnswer from '../components/seo/FeaturedAnswer.astro';
import ComparisonTable from '../components/seo/ComparisonTable.astro';
import FAQEnhanced from '../components/seo/FAQEnhanced.astro';

const comparisonData = [
  {
    label: 'Automated Class Reminders (email & app push)',
    values: [true, true, false],
    highlight: true
  },
  {
    label: 'One-Tap RSVP Before Class',
    values: [true, false, false],
    highlight: true
  },
  {
    label: 'Students Join a Group Once, Expected at Every Class',
    values: [true, false, 'Manual'],
    highlight: true
  },
  {
    label: 'Belt and Age Range Warnings per Group',
    values: [true, false, false],
    highlight: true
  },
  {
    label: 'Recurring Weekly Timetable',
    values: [true, true, false]
  },
  {
    label: 'Term Dates, Closures & Automatic Notices',
    values: [true, 'Limited', 'Manual']
  },
  {
    label: 'Multiple Venues & Rooms',
    values: [true, true, 'Manual']
  },
  {
    label: 'Family View of Every Child\'s Classes',
    values: [true, false, false]
  },
  {
    label: 'Instructor Ratio & Insurance Warnings',
    values: [true, false, false]
  },
  {
    label: 'Attendance Report with CSV Export',
    values: [true, 'Limited', false]
  }
];

const faqItems = [
  {
    question: "What is martial arts scheduling software?",
    answer: "Martial arts scheduling software runs a school's class timetable: recurring classes, who belongs in each class, term dates and closures, reminders to families and the register. Unlike a generic booking tool, it understands groups, belt ranks and families with more than one child training.",
    links: [
      { text: 'View all features', url: '/martial-arts-software/' },
      { text: 'See pricing', url: '/pricing/' }
    ]
  },
  {
    question: "How does BeltManager know who is coming to class?",
    answer: "You put each student in a group once, for example Kids Karate. From then on they are expected at every class of that group, so the register is already filled in. The evening before, families can be asked whether their child is coming and answer Coming or Can't make it in one tap. If they can't make it, they give a reason, so you know before you open the doors.",
    links: [
      { text: 'Dojo management', url: '/dojo-management-software/' },
      { text: 'Get started free', url: appLink(Astro.url.pathname, 'faq') }
    ]
  },
  {
    question: "Does BeltManager send class reminders?",
    answer: "Yes, by email and by push notification in the free parent app. You choose whether to switch class-day reminders on for your school. BeltManager doesn't send text messages (SMS).",
    links: [
      { text: 'CRM features', url: '/martial-arts-crm/' },
      { text: 'Contact us', url: '/contact/' }
    ]
  },
  {
    question: "Can students book their own classes?",
    answer: "Not as open booking. Families see their child's classes for the next two weeks in the parent portal or the free iPhone app, answer whether they're coming and can add the classes to their phone's calendar. Open booking with class capacity and waitlists isn't available yet.",
    links: [
      { text: 'Dojo management', url: '/dojo-management-software/' },
      { text: 'Get started free', url: appLink(Astro.url.pathname, 'faq') }
    ]
  },
  {
    question: "Can I restrict a class by belt?",
    answer: "You can give a group a minimum and maximum belt, as well as an age range. If you add a student whose belt is outside the range, BeltManager asks you to confirm first. It's a warning, not a lock, so you can still let a student train up a level.",
    links: [
      { text: 'Karate school features', url: '/karate-school-software/' },
      { text: 'BJJ features', url: '/bjj-gym-software/' }
    ]
  },
  {
    question: "How do recurring schedules work?",
    answer: "Set a class to run on the same days and time every week, for example Kids Karate on Monday and Wednesday at 4pm, at a venue and room. BeltManager creates each week's classes for you. Add your term dates and closed periods, and classes in those weeks don't run.",
    links: [
      { text: 'Karate features', url: '/karate-school-software/' },
      { text: 'Get started free', url: appLink(Astro.url.pathname, 'faq') }
    ]
  },
  {
    question: "What happens when I cancel or move a class?",
    answer: "Families of the students in that class get a notice automatically, by email and in the parent app, so you don't have to message everyone yourself. The same happens when you add a closure, such as a bank holiday.",
    links: [
      { text: 'Dojo management', url: '/dojo-management-software/' },
      { text: 'Contact us', url: '/contact/' }
    ]
  },
  {
    question: "Can I schedule private lessons?",
    answer: "Not yet. BeltManager runs group classes, gradings and events. Private lessons and lesson packages aren't available.",
    links: [
      { text: 'Overview', url: '/martial-arts-software/' },
      { text: 'See pricing', url: '/pricing/' }
    ]
  },
  {
    question: "How does family scheduling work?",
    answer: "Parents sign in once and see every child's classes for the next two weeks in one place, with each child's belt. They answer whether each child is coming and can subscribe to a calendar feed so classes appear in their phone's calendar.",
    links: [
      { text: 'Dojo management', url: '/dojo-management-software/' },
      { text: 'Get started free', url: appLink(Astro.url.pathname, 'faq') }
    ]
  },
  {
    question: "What scheduling reports are available?",
    answer: "An attendance report by class and by student, with CSV export; a list of students who have missed their recent classes; and an insurance compliance report showing instructor-to-student ratios and insured student counts.",
    links: [
      { text: 'Overview', url: '/martial-arts-software/' },
      { text: 'Contact us', url: '/contact/' }
    ]
  }
];

const breadcrumbItems = [
  { label: 'Home', url: 'https://beltmanager.com/' },
  { label: 'Scheduling Software', url: 'https://beltmanager.com/martial-arts-scheduling-software/' }
];
---

<BaseLayout
  title="Martial Arts Scheduling & Class Timetable Software"
  description="A weekly timetable where students join a group once, families RSVP in one tap and reminders go out automatically. Built for martial arts schools. Free for up to 25 students. Paid plans from £29 a month."
>
  <BreadcrumbsEnhanced site="beltmanager" items={breadcrumbItems} />

  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block bg-brand-50 text-brand-700 px-4 py-2 rounded-full text-sm font-semibold mb-6">
          Complete Guide to Scheduling Software
        </span>
        <h1 class="text-4xl md:text-5xl font-bold text-navy mb-6">
          Martial Arts Scheduling Software
        </h1>
        <p class="text-xl text-gray-600 mb-8">
          Students join a group once and every class knows who's coming. Families RSVP in one tap, reminders and closure notices go out automatically, and you take the register on your phone.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href={appLink(Astro.url.pathname, 'hero')} class="btn-primary">Get started free</a>
          <a href="/pricing/" class="btn-secondary">View Pricing</a>
        </div>
      </div>
    </div>
  </section>

  <FeaturedAnswer question="What is martial arts scheduling software?">
    Martial arts scheduling software runs a school's weekly timetable: recurring classes, who belongs in each group, term dates and closures, reminders to families and the register. In BeltManager, students join a group once and are expected at every class, families answer Coming or Can't make it in one tap, and reminders go out by email and app push.
  </FeaturedAnswer>

  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto prose prose-lg">
        <h2>Why Martial Arts Schools Need Specialized Scheduling</h2>
        <p>
          A martial arts timetable isn't a gym's open booking calendar. Most of your students train in the same group every week: the Monday and Wednesday kids' class, the adult beginners, the squad. What you need to know before each class is simple: who should be here, who isn't coming, and whether you have enough instructors on the mat for the numbers.
        </p>
        <p>
          Paper registers and group chats answer those questions badly. Names get missed, parents message at the last minute, and you only find out who was absent when you count heads. BeltManager is built around the way dojos already run.
        </p>

        <h2>Join a Group Once, Expected at Every Class</h2>
        <p>
          Add a student to a group once and they are a regular. Every class of that group already knows who is coming, so the register fills itself. You open the class on your phone and tap who's there. Walk-ins can be added on the spot, and the register keeps working if the hall's signal drops.
        </p>

        <h2>One-Tap RSVP and Reminders</h2>
        <p>
          The evening before class, BeltManager can ask families whether their child is coming. They answer Coming or Can't make it in one tap from the email, the parent portal or the free iPhone app, and give a reason if they can't make it. You see the answers on the class before you arrive.
        </p>
        <p>
          You can also switch on class-day reminders, sent by email and as a push notification in the parent app a few hours before the class starts. BeltManager doesn't send text messages.
        </p>

        <h2>Recurring Timetable, Venues and Rooms</h2>
        <p>
          Set each class to run on the same days and time every week, at a venue and room. BeltManager creates each week's classes for you. Run as many venues and rooms as you like at no extra cost, and filter the dashboard by venue.
        </p>

        <h2>Term Dates, Closures and Automatic Notices</h2>
        <p>
          Add your term dates and closed periods once, and classes in those weeks don't run. When you cancel or move a class, or close for a bank holiday, the families affected get a notice automatically by email and in the parent app.
        </p>

        <h2>Belt and Age Ranges per Group</h2>
        <p>
          Give a group an age range and a minimum and maximum belt. When you add a student who sits outside the range, BeltManager names them and their belt and asks you to confirm. It's a warning rather than a lock, so you can still move a strong student up early.
        </p>

        <h2>Instructor Ratios and Insurance</h2>
        <p>
          Your insurer cares how many students each instructor is responsible for, and how many of your students are insured. BeltManager warns you when a class goes over your instructor-to-student ratio, and the compliance report shows both figures. Staff can have their own sign-in as head instructor, assistant or front desk.
        </p>

        <h2>Families: Every Child in One Place</h2>
        <p>
          Parents sign in once and see each child's belt and their classes for the next two weeks, with one-tap attending or not attending. They can subscribe to a calendar feed so classes appear in their phone's calendar, and the free iPhone app sends push notifications for reminders and notices.
        </p>

        <h2>Gradings and Events</h2>
        <p>
          Gradings, tournaments, seminars and socials sit alongside the weekly timetable. Attendance feeds grading eligibility, so BeltManager can show who is ready to grade based on time at their belt and sessions attended.
        </p>

        <h2>Attendance Reporting</h2>
        <p>
          The attendance report shows attendance by class and by student, and exports to CSV. A retention list flags students who have missed their recent group classes (the last three, by default), so you can get in touch before they drift away. Lesson plans and per-student notes can be kept against each class.
        </p>

        <h2>What BeltManager Doesn't Do Yet</h2>
        <p>
          We'd rather you know before you sign up. BeltManager doesn't yet offer open class booking with capacity limits and waitlists, private lessons or lesson packages, instructor availability calendars, or text-message reminders.
        </p>

        <h2>Getting Started with BeltManager Scheduling</h2>
        <p>
          Sign up, add your classes, venues and term dates, add your students (or send us your list and we'll help import it) and put them in their groups. Your first register is ready as soon as the first class comes round.
        </p>
      </div>
    </div>
  </section>

  <ComparisonTable
    title="Martial Arts Scheduling vs General Booking vs Manual Tracking"
    headers={['BeltManager (Martial Arts-Specific)', 'Generic Booking Tools', 'Spreadsheets/Paper']}
    rows={comparisonData}
  />

  <FAQEnhanced
    site="beltmanager"
    pageUrl="https://beltmanager.com/martial-arts-scheduling-software/"
    title="Frequently Asked Questions About Martial Arts Scheduling Software"
    faqs={faqItems}
  />

  <section class="section bg-navy text-white">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">
          Ready to Stop Chasing Who's Coming?
        </h2>
        <p class="text-xl mb-8 text-gray-300">
          A register that fills itself, one-tap RSVPs and automatic closure notices. Free for up to 25 students. Paid plans from £29 a month. Get started free today.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href={appLink(Astro.url.pathname, 'bottom')} class="btn-primary">Get started free</a>
          <a href="/pricing/" class="btn-secondary bg-white text-navy hover:bg-gray-100">View Pricing</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    padding: 4rem 0;
  }

  @media (min-width: 768px) {
    .section {
      padding: 6rem 0;
    }
  }

  .prose {
    color: #14161F;
  }

  .prose h2 {
    color: #14161F;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose p {
    margin-bottom: 1.25rem;
    line-height: 1.75;
  }

  .prose a {
    color: #C0420B;
    text-decoration: none;
  }

  .prose a:hover {
    text-decoration: underline;
  }
</style>
