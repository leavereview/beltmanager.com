---
// Pricing Page
//
// MyDojo is free until 31 March 2027: no subscription and no commission. There
// is no free trial — there is nothing to trial, the product is free. After that
// date pricing will be announced with notice. Do not state a notice period, a
// billing interval, a pricing model or a currency for future pricing: none has
// been set, and the only committed notice period lives in terms.astro.
//
// The DATE is the point. "Free while in early access" is open-ended, and an
// open-ended free reads as a hobby project that might vanish — fatal when a
// dojo owner is deciding where to keep their student records. A stated end
// date says this is a business with a plan. Keep it in step with
// FOUNDING_PLAN_EXPIRES_AT / planExpiresAt in the product app.
//
// States "no commission" for the free launch period only. This supersedes the
// no-commission-claim rule in
// docs/superpowers/specs/2026-07-12-free-pricing-model-design.md; it still makes
// no claim about commission after 31 March 2027.
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQEnhanced from '../components/seo/FAQEnhanced.astro';

const offerSchema = {
  "@context": "https://schema.org",
  "@type": "Offer",
  "@id": "https://mydojo.software/pricing/#free",
  "name": "MyDojo — free until 31 March 2027",
  "description": "MyDojo is free to use until 31 March 2027 — no subscription, no commission, no setup fee, and no per-student charges. Every feature is included during the launch period.",
  "price": "0",
  "priceCurrency": "GBP",
  // Kept at 0 rather than removed: it is accurate, and it is what makes this
  // page eligible for free-tier rich results. `priceValidUntil` is the
  // structured-data expression of the same promise the copy makes.
  "priceValidUntil": "2027-03-31",
  "availability": "https://schema.org/InStock",
  "url": "https://mydojo.software/pricing/",
  "seller": {
    "@type": "Organization",
    "name": "MyDojo.Software"
  },
  "itemOffered": {
    "@type": "SoftwareApplication",
    "name": "MyDojo.Software",
    "applicationCategory": "BusinessApplication"
  },
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "Subscription", "value": "No" },
    { "@type": "PropertyValue", "name": "Commission", "value": "No" },
    { "@type": "PropertyValue", "name": "Setup Fee", "value": "No" },
    { "@type": "PropertyValue", "name": "Per-Student Fees", "value": "No" },
    { "@type": "PropertyValue", "name": "Credit Card Required", "value": "No" }
  ]
};

const featureGroups = [
  {
    icon: '🥋',
    title: 'Core Management',
    features: ['Belt & rank tracking', 'Class scheduling', 'Attendance tracking', 'Unlimited locations', 'Unlimited staff users']
  },
  {
    icon: '💳',
    title: 'Billing & Payments',
    features: ['Automated recurring billing', 'Family discounts', 'Failed payment recovery', 'Stripe integration', 'Payment reminders']
  },
  {
    icon: '📱',
    title: 'Student Experience',
    features: ['Mobile student app', 'Parent portal (24/7 access)', 'Progress tracking', 'Schedule viewing', 'Belt promotion notifications']
  },
  {
    icon: '📊',
    title: 'Business Tools',
    features: ['CRM & lead management', 'Automated follow-ups', 'Unlimited emails', 'Reporting & analytics', 'Revenue tracking']
  },
  {
    icon: '✅',
    title: 'Check-In Methods',
    features: ['Tablet kiosk mode', 'Mobile check-in', 'QR code scanning', 'Manual attendance', 'Attendance reports']
  },
  {
    icon: '🛟',
    title: 'Support & Training',
    features: ['Email support', 'Free onboarding', 'Training videos', 'Knowledge base', 'Help importing your students']
  }
];

// FAQEnhanced generates the FAQPage JSON-LD from this array, so the rendered
// questions and the structured data cannot drift apart.
const faqs = [
  {
    question: "Is MyDojo really free?",
    answer: "Yes. MyDojo is free until 31 March 2027 — no subscription, no commission, no setup fee, no per-student charges, and no credit card. Every feature is included during the launch period, including belt tracking, billing, and reporting.",
    links: [
      { text: 'Get started free', url: 'https://app.mydojo.software/signin' }
    ]
  },
  {
    question: "How do you make money?",
    answer: "Right now, we don't. MyDojo is free until 31 March 2027, with no subscription and no commission. Pricing for after that date will be announced with notice before anything changes.",
    links: [
      { text: 'Read our terms', url: '/terms/' }
    ]
  },
  {
    question: "What's the catch?",
    answer: "There isn't one, but there is a trade. We want martial arts schools actually running on MyDojo and telling us what's missing or broken before we set pricing, so it's free until 31 March 2027. You get the software for nothing; we get honest feedback from real dojos. That's the deal.",
    links: []
  },
  {
    question: "Will you start charging me without warning?",
    answer: "No. MyDojo is free until 31 March 2027. Pricing for after that date will be announced with notice before any charge. Nothing will start billing you by surprise.",
    links: [
      { text: 'Read our terms', url: '/terms/' }
    ]
  },
  {
    question: "How many students and locations can I have?",
    answer: "Unlimited students, unlimited locations, and unlimited staff users. There are no capacity limits while MyDojo is free until 31 March 2027.",
    links: [
      { text: 'Compare features', url: '/martial-arts-software/' }
    ]
  },
  {
    question: "What happens to my data if I don't continue after 31 March 2027?",
    answer: "Your records are yours. If you decide not to continue once pricing is announced, get in touch and we'll help you get your student data out. We're not going to hold your dojo's records hostage.",
    links: [
      { text: 'Contact us', url: '/contact/' },
      { text: 'Privacy policy', url: '/privacy-policy/' }
    ]
  }
];
---

<BaseLayout
  title="Pricing — Free Martial Arts School Software"
  description="MyDojo is free until 31 March 2027 — no subscription, no setup fee, no per-student charges. Belt tracking, scheduling, attendance and CRM all included."
>
  <script type="application/ld+json" set:html={JSON.stringify(offerSchema)} />

  <!-- Breadcrumbs -->
  <div class="bg-gray-100 py-3">
    <div class="container-custom">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Pricing' }
      ]} />
    </div>
  </div>

  <section class="relative overflow-hidden bg-gradient-to-br from-brand-navy to-gray-900 text-white py-16">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0" style="background-image: url('/images/hero-pricing.jpg'); background-size: cover; background-position: center;"></div>
    </div>
    <div class="container-custom relative">
      <div class="max-w-3xl text-center mx-auto">
        <span class="inline-block bg-brand-red/20 text-brand-red-light px-3 py-1 rounded-full text-sm mb-4">Pricing</span>
        <h1 class="text-4xl md:text-5xl font-bold mb-4">MyDojo is free</h1>
        <p class="text-xl text-gray-300 mb-8">
          No subscription. No commission. No per-student fees. Free until 31 March 2027.
        </p>
        <a href="https://app.mydojo.software/signin" class="btn-primary text-lg px-8 py-4">Get started free</a>
        <p class="mt-4 text-sm text-gray-400">Free until 31 March 2027 • No credit card • Every feature included</p>
      </div>
    </div>
  </section>

  <!-- The offer, stated plainly -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-bold text-brand-navy mb-6">Free for the launch period</h2>
        <p class="text-lg text-gray-600 mb-6">
          MyDojo is launching free. Until <strong>31 March 2027</strong> there is no subscription and no commission,
          no setup fee and no per-student charge — and no student caps or feature lockouts while it's free.
        </p>
        <p class="text-lg text-gray-600">
          We're being straight with you about what happens next: pricing for after 31 March 2027 hasn't been set.
          It will be announced <strong>with notice</strong> before any charge. Nothing will start billing you by surprise.
        </p>
      </div>
    </div>
  </section>

  <!-- Everything included -->
  <section class="section bg-gray-50">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="text-3xl font-bold text-brand-navy mb-4">Everything's included</h2>
        <p class="text-lg text-gray-600">
          No feature lockouts, no upsells, no "contact sales for that one". Every school gets the whole product.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {featureGroups.map(group => (
          <div class="card">
            <h3 class="text-xl font-bold text-brand-navy mb-4">
              <span aria-hidden="true">{group.icon}</span> {group.title}
            </h3>
            <ul class="space-y-2">
              {group.features.map(feature => (
                <li class="flex items-start gap-2 text-gray-700">
                  <span class="text-brand-red font-bold" aria-hidden="true">✓</span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQs (FAQPage schema is generated from the same array that renders them) -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <FAQEnhanced
          faqs={faqs}
          site="mydojo"
          pageUrl="https://mydojo.software/pricing/"
          initiallyExpanded={0}
        />
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="section bg-brand-navy text-white">
    <div class="container-custom">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl font-bold mb-4">Ready to simplify your school?</h2>
        <p class="text-lg text-gray-300 mb-8">
          Belt tracking, scheduling, attendance, and CRM — free until 31 March 2027.
        </p>
        <a href="https://app.mydojo.software/signin" class="btn-primary text-lg px-8 py-4">Get started free</a>
        <p class="mt-4 text-sm text-gray-400">Free until 31 March 2027 • No credit card • No contract</p>
      </div>
    </div>
  </section>
</BaseLayout>
