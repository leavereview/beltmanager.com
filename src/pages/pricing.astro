---
// Pricing Page
//
// MyDojo is free while in early access. There is no subscription, no per-student
// fee, and no free trial — there is nothing to trial, the product is free.
// Paid monthly plans come later, with at least 30 days' notice.
//
// Deliberately makes NO commission claim. See
// docs/superpowers/specs/2026-07-12-free-pricing-model-design.md for why.
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQEnhanced from '../components/seo/FAQEnhanced.astro';

const offerSchema = {
  "@context": "https://schema.org",
  "@type": "Offer",
  "@id": "https://mydojo.software/pricing/#free",
  "name": "MyDojo — free while in early access",
  "description": "MyDojo is free to use. No subscription, no setup fee, and no per-student charges. Every feature is included.",
  "price": "0",
  "priceCurrency": "GBP",
  "availability": "https://schema.org/InStock",
  "url": "https://mydojo.software/pricing/",
  "seller": {
    "@type": "Organization",
    "name": "MyDojo.Software"
  },
  "itemOffered": {
    "@type": "SoftwareApplication",
    "name": "MyDojo.Software",
    "applicationCategory": "BusinessApplication"
  },
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "Setup Fee", "value": "No" },
    { "@type": "PropertyValue", "name": "Per-Student Fees", "value": "No" },
    { "@type": "PropertyValue", "name": "Credit Card Required", "value": "No" }
  ]
};

const featureGroups = [
  {
    icon: '🥋',
    title: 'Core Management',
    features: ['Belt & rank tracking', 'Class scheduling', 'Attendance tracking', 'Unlimited locations', 'Unlimited staff users']
  },
  {
    icon: '💳',
    title: 'Billing & Payments',
    features: ['Automated recurring billing', 'Family discounts', 'Failed payment recovery', 'Stripe integration', 'Payment reminders']
  },
  {
    icon: '📱',
    title: 'Student Experience',
    features: ['Mobile student app', 'Parent portal (24/7 access)', 'Progress tracking', 'Schedule viewing', 'Belt promotion notifications']
  },
  {
    icon: '📊',
    title: 'Business Tools',
    features: ['CRM & lead management', 'Automated follow-ups', 'Unlimited emails', 'Reporting & analytics', 'Revenue tracking']
  },
  {
    icon: '✅',
    title: 'Check-In Methods',
    features: ['Tablet kiosk mode', 'Mobile check-in', 'QR code scanning', 'Manual attendance', 'Attendance reports']
  },
  {
    icon: '🛟',
    title: 'Support & Training',
    features: ['Email support', 'Free onboarding', 'Training videos', 'Knowledge base', 'Help importing your students']
  }
];

// FAQEnhanced generates the FAQPage JSON-LD from this array, so the rendered
// questions and the structured data cannot drift apart.
const faqs = [
  {
    question: "Is MyDojo really free?",
    answer: "Yes. MyDojo is free while we're in early access — no subscription, no setup fee, no per-student charges, and no credit card. Every feature is included: we don't lock belt tracking, billing, or reporting behind a higher tier, because there are no tiers.",
    links: [
      { text: 'Get started free', url: 'https://app.mydojo.software/signup' }
    ]
  },
  {
    question: "How do you make money?",
    answer: "Right now, we don't. MyDojo is free while we're in early access. We'll introduce paid monthly plans in future, and we'll give you at least 30 days' notice before anything changes.",
    links: [
      { text: 'Read our terms', url: '/terms/' }
    ]
  },
  {
    question: "What's the catch?",
    answer: "There isn't one, but there is a trade. We want martial arts schools actually running on MyDojo and telling us what's missing or broken before we launch paid plans. You get the software for nothing; we get honest feedback from real dojos. That's the deal.",
    links: []
  },
  {
    question: "Will you start charging me without warning?",
    answer: "No. When we introduce paid monthly plans you'll get at least 30 days' notice before any charge, and you'll be able to decide then whether to continue. Nothing will start billing you by surprise.",
    links: [
      { text: 'Read our terms', url: '/terms/' }
    ]
  },
  {
    question: "How many students and locations can I have?",
    answer: "Unlimited students, unlimited locations, and unlimited staff users. There are no capacity limits, because there are no plans to police — a school with 20 students and a multi-site academy with 400 get exactly the same software.",
    links: [
      { text: 'Compare features', url: '/martial-arts-software/' }
    ]
  },
  {
    question: "What happens to my data if I don't take a paid plan later?",
    answer: "Your records are yours. If you decide not to continue when paid plans launch, get in touch and we'll help you get your student data out. We're not going to hold your dojo's records hostage.",
    links: [
      { text: 'Contact us', url: '/contact/' },
      { text: 'Privacy policy', url: '/privacy-policy/' }
    ]
  }
];
---

<BaseLayout
  title="Pricing — Free Martial Arts School Software"
  description="MyDojo is free — no subscription, no setup fee, no per-student charges. Belt tracking, scheduling, attendance and CRM all included. Get started free."
>
  <script type="application/ld+json" set:html={JSON.stringify(offerSchema)} />

  <!-- Breadcrumbs -->
  <div class="bg-gray-100 py-3">
    <div class="container-custom">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Pricing' }
      ]} />
    </div>
  </div>

  <section class="relative overflow-hidden bg-gradient-to-br from-brand-navy to-gray-900 text-white py-16">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0" style="background-image: url('/images/hero-pricing.jpg'); background-size: cover; background-position: center;"></div>
    </div>
    <div class="container-custom relative">
      <div class="max-w-3xl text-center mx-auto">
        <span class="inline-block bg-brand-red/20 text-brand-red-light px-3 py-1 rounded-full text-sm mb-4">Pricing</span>
        <h1 class="text-4xl md:text-5xl font-bold mb-4">MyDojo is free</h1>
        <p class="text-xl text-gray-300 mb-8">
          No subscription. No per-student fees. No setup cost. Free while we're in early access.
        </p>
        <a href="https://app.mydojo.software/signup" class="btn-primary text-lg px-8 py-4">Get started free</a>
        <p class="mt-4 text-sm text-gray-400">No credit card • No contract • Every feature included</p>
      </div>
    </div>
  </section>

  <!-- The offer, stated plainly -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-bold text-brand-navy mb-6">One plan. It costs nothing.</h2>
        <p class="text-lg text-gray-600 mb-6">
          Most martial arts software charges £50–£200 a month, and then charges you more as your school grows.
          MyDojo doesn't. There are no tiers, no student caps, and no feature lockouts — a school with 20 students
          and a multi-site academy with 400 get exactly the same software, for exactly the same price. Nothing.
        </p>
        <p class="text-lg text-gray-600">
          This is early access, and we're being straight with you about what that means: MyDojo is free now, and
          we'll introduce paid monthly plans in future. When we do, you'll get <strong>at least 30 days' notice</strong>
          before any charge. Nothing will start billing you by surprise.
        </p>
      </div>
    </div>
  </section>

  <!-- Everything included -->
  <section class="section bg-gray-50">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="text-3xl font-bold text-brand-navy mb-4">Everything's included</h2>
        <p class="text-lg text-gray-600">
          No feature lockouts, no upsells, no "contact sales for that one". Every school gets the whole product.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {featureGroups.map(group => (
          <div class="card">
            <h3 class="text-xl font-bold text-brand-navy mb-4">
              <span aria-hidden="true">{group.icon}</span> {group.title}
            </h3>
            <ul class="space-y-2">
              {group.features.map(feature => (
                <li class="flex items-start gap-2 text-gray-700">
                  <span class="text-brand-red font-bold" aria-hidden="true">✓</span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQs (FAQPage schema is generated from the same array that renders them) -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <FAQEnhanced
          faqs={faqs}
          site="mydojo"
          pageUrl="https://mydojo.software/pricing/"
          initiallyExpanded={0}
        />
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="section bg-brand-navy text-white">
    <div class="container-custom">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl font-bold mb-4">Ready to simplify your school?</h2>
        <p class="text-lg text-gray-300 mb-8">
          Belt tracking, scheduling, attendance, and CRM — free while we're in early access.
        </p>
        <a href="https://app.mydojo.software/signup" class="btn-primary text-lg px-8 py-4">Get started free</a>
        <p class="mt-4 text-sm text-gray-400">No credit card • No contract</p>
      </div>
    </div>
  </section>
</BaseLayout>
