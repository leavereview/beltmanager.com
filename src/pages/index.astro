---
// Home page, US English (the site went US-first in Nov 2026; the British copy lives at /uk/).
// US wording: school, belt testing, attendance, schedule, tuition, program.
//
// Rules for this page (John, 7 Nov 2026, carried over from the retired /us/ page):
// - Dollar prices ARE decided (issue #36, John 09/11/2026): Free up to 25 active students;
//   Club $29 (75), School $49 (150), Academy $79 (unlimited); annual $290 / $490 / $790.
//   Same numbers as GBP, not a conversion. Schools joining by March 31, 2027: free until then, then
//   50% off a paid plan for 12 months. Keep in step with pricing.astro.
// - The setup call is 30 minutes (the Calendly event length). Keep the copy in step.
// - The parent app is live on iPhone and Android.
// - No Daxko or "forced migration" claims, no competitor price claims, no user counts, no
//   testimonials, no children in imagery (app screenshots of demo data only), no kiosk claims.
// - Card billing is not available to US schools yet (the app creates GB Stripe accounts and
//   bills in GBP). John (08/11/2026): say US card billing is coming in 2027, no firmer date.
//
// hreflang: this page and /uk/ list each other (en-US / en-GB / x-default).
import { appLink } from '../utils/appLink';
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQEnhanced from '../components/seo/FAQEnhanced.astro';
import { HOME_ALTERNATES } from '../utils/hreflang';

const CALENDLY_URL = 'https://calendly.com/johnpowell-hey/30min?utm_source=home';

// One Offer per plan per currency (same numbers in GBP and USD; John, 09/11/2026).
// Free keeps price "0" for free-tier rich results and has no priceValidUntil.
// Keep in step with pricing.astro.
const PLAN_OFFERS = [
  { id: 'free', name: 'Free', price: '0', desc: 'Up to 25 active students. Every feature included.' },
  { id: 'club', name: 'Club', price: '29', desc: 'Up to 75 active students. Every feature included.' },
  { id: 'school', name: 'School', price: '49', desc: 'Up to 150 active students. Every feature included.' },
  { id: 'academy', name: 'Academy', price: '79', desc: 'Unlimited active students. Every feature included.' }
];
const planOffers = PLAN_OFFERS.flatMap((plan) =>
  ['GBP', 'USD'].map((cur) => ({
    "@type": "Offer",
    "@id": `https://beltmanager.com/#${plan.id}-${cur.toLowerCase()}`,
    "name": `BeltManager ${plan.name}`,
    "description": plan.desc,
    "price": plan.price,
    "priceCurrency": cur,
    "availability": "https://schema.org/InStock",
    "url": "https://beltmanager.com/pricing/",
    "seller": { "@type": "Organization", "name": "BeltManager" }
  }))
);
// SoftwareApplication Schema
const softwareApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": "https://beltmanager.com/#software",
  "name": "BeltManager",
  "alternateName": "BeltManager",
  "description": "Martial arts school software for dojos, karate schools, BJJ academies and MMA gyms: class schedules, attendance that fills itself from program groups, belt testing from attendance, family accounts and a free parent app for iPhone and Android.",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web, iOS, Android",
  "inLanguage": "en-US",
  "offers": planOffers,
  "featureList": [
    "Class Schedules & RSVP",
    "Student Management & Profiles",
    "Belt & Rank Tracking",
    "Belt Testing Eligibility from Attendance",
    "Family Accounts",
    "Tuition Billing (US card billing is coming in 2027)",
    "Attendance Tracking",
    "Parent Portal & Free Parent App",
    "Staff Roles & Permissions",
    "Tournament & Seminar Events",
    "Membership Management",
    "Attendance & Compliance Reports",
    "Multi-location Support",
    "Class Reminders (Email & App Push)"
  ],
  "url": "https://beltmanager.com",
  "applicationSubCategory": "Martial Arts School Management",
  "audience": {
    "@type": "BusinessAudience",
    "audienceType": "Dojos, Karate Schools, BJJ Academies, MMA Gyms, Martial Arts Schools"
  }
};

const offerSchema = {
  "@context": "https://schema.org",
  "@graph": planOffers
};

const features = [
  {
    icon: 'calendar',
    title: 'Class Scheduling',
    description: 'Recurring classes, locations and rooms, session dates and closures, with email and app reminders before each class.'
  },
  {
    icon: 'users',
    title: 'Student Management',
    description: 'Track student progress, belt ranks, attendance, and performance with comprehensive profiles.'
  },
  {
    icon: 'credit-card',
    title: 'Billing & Payments',
    description: 'US card billing is coming in 2027. Until then, record tuition payments by hand.'
  },
  {
    icon: 'chart',
    title: 'Reports & Analytics',
    description: 'Attendance reports with CSV export, at-risk student lists and insurance compliance checks.'
  },
  {
    icon: 'belt',
    title: 'Belt & Rank Tracking',
    description: 'Manage belt progression, belt testing eligibility, belt tests and printable certificates for any style.'
  },
  {
    icon: 'mobile',
    title: 'Free Parent App',
    description: 'Parents RSVP to classes in one tap, follow their child\'s progress and get closure notices. Free on iPhone and Android.'
  }
];

// "How it works" strip (#22). Real screenshots from the demo school, no real families.
const howItWorks = [
  {
    title: 'Add your students once',
    text: "Put each student in a program group, like Kids Karate. From then on they're a regular, expected at every class that group runs.",
    image: '/images/app/karate-belt-testing.webp',
    width: 1600,
    height: 1000,
    crop: 'width: 170%; transform: translate(0, -4%);',
    alt: 'The students list, showing each student\'s belt, groups and guardian',
    caption: 'Students, their belts and the groups they train in.'
  },
  {
    title: 'Families tell you who\'s coming',
    text: "Before class, parents answer Coming or Can't make it in one tap. You open attendance on your phone, already filled in, and tap who's there.",
    image: '/images/app/karate-parent-portal.webp',
    width: 1200,
    height: 1700,
    crop: 'width: 100%;',
    alt: 'The parent portal: a child\'s upcoming classes with Attending and Not attending buttons',
    caption: "The parent's view: one tap per class."
  },
  {
    title: 'See who\'s ready to test',
    text: 'Attendance and time at belt build the list of students ready for belt testing, so your next belt test picks itself.',
    image: '/images/app/dojo-dashboard.webp',
    width: 1600,
    height: 1220,
    crop: 'width: 280%; transform: translate(0, -27%);',
    alt: 'The dashboard: students ready for their next belt test, showing each student\'s current and next belt',
    caption: 'Students ready for their next belt test, on the dashboard.'
  }
];

const stats = [
  { number: 'Unlimited', label: 'Staff & Classes' },
  { number: '$0', label: 'Free up to 25 students' },
  { number: 'All styles', label: 'Karate, BJJ, TKD, MMA' },
  { number: '24/7', label: 'Parent Portal & App' }
];
// The approved headline's three claims, from the retired /us/ page.
const highlights = [
  {
    title: 'Attendance that fills itself',
    text: "Put each student in a program group, like Kids Karate, once. From then on they're a regular, expected at every class that group runs. Parents tap Coming or Can't make it, and you open attendance on your phone already filled in.",
  },
  {
    title: 'A parent app that works',
    text: "Free on iPhone and Android. Parents answer for each class in one tap, see their child's belt and upcoming classes, sign waivers and get class reminders.",
  },
  {
    title: 'Families grouped together',
    text: 'Siblings sit under one family with their parents or guardians, so a parent with three kids signs in once and sees all three.',
  },
  {
    title: 'Belt testing from attendance',
    text: 'Set a minimum time at each belt and a minimum number of classes. BeltManager builds the list of students ready for belt testing, so your next test picks itself.',
  },
];

const faqs = [
  {
    question: 'How much does BeltManager cost for a US school?',
    answer:
      "Schools that join on or before March 31, 2027 use BeltManager free until then, with every feature that's live and no credit card. After that, schools with up to 25 active students stay on a free plan, and larger schools pay $29 a month (Club, up to 75 active students), $49 (School, up to 150) or $79 (Academy, unlimited), with every feature on every plan. Schools that join before then get 50% off a paid plan for 12 months.",
    links: [{ text: 'Pricing', url: '/pricing/' }],
  },
  {
    question: 'Can I import my students from my current software?',
    answer:
      'Yes. BeltManager imports any CSV file: names, dates of birth, parents or guardians, program group and current belt. We have step-by-step guides for exporting from Martialytics, Kicksite and Zen Planner, and the setup call can cover your import.',
    links: [
      { text: 'Switching guides', url: '/switch/' },
      { text: 'Export from Kicksite', url: '/switch/kicksite/' },
    ],
  },
  {
    question: 'Can BeltManager collect tuition by card in the US?',
    answer:
      'Not yet: US card billing is coming in 2027. Until then, keep your current tuition setup while you move attendance, belts and families across.',
    links: [],
  },
  {
    question: 'Is BeltManager a US company?',
    answer:
      "No. BeltManager is made in the UK by John Powell Ltd. Some screens still use UK wording for belt testing and show dates day first, and that's worth knowing before you sign up. The student import reads US month-first dates.",
    links: [{ text: 'About BeltManager', url: '/about/' }],
  },
  {
    question: 'What happens on the setup call?',
    answer:
      "It's a 30-minute video call with John, who builds BeltManager. Bring your student list and your class schedule, and we'll set up your school together: belts, program groups, classes and your first students.",
    links: [],
  },
];
---

<BaseLayout
  title="Martial Arts School Management Software | BeltManager"
  description="Martial arts school software and student database: attendance that fills itself, belt testing from attendance and a free parent app. Free for up to 25 students."
  lang="en-US"
  alternates={HOME_ALTERNATES}
>
  <!-- Structured Data Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify(softwareApplicationSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(offerSchema)} />

  <!-- Hero Section: leads with the aha moment (#22). The visual is a real app screenshot
       (demo school, no real families); swap it for John's screen-recording clip when it exists. -->
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-navy via-brand-navy to-gray-900 text-white">
    <div class="container-custom relative py-16 md:py-24">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="badge-primary mb-6">
            Free for up to 25 students
          </span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6">
            A parent app that works. Families grouped. <span class="text-brand-red">Belt testing from attendance.</span>
          </h1>
          <p class="text-xl md:text-2xl text-gray-300 mb-8 leading-relaxed">
            Software for martial arts schools. Add your students once, and every class knows who's coming. Free import from any spreadsheet.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href={appLink(Astro.url.pathname, 'hero')} class="btn-primary text-lg px-8 py-4" data-ph-capture-attribute-cta="hero-get-started" data-ph-capture-attribute-hero-version="aha-2026-11">
              Get started free
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a href="#how-it-works" class="btn-secondary text-lg px-8 py-4" data-ph-capture-attribute-cta="hero-how-it-works" data-ph-capture-attribute-hero-version="aha-2026-11">
              See how it works
            </a>
          </div>
          <p class="mt-6 text-sm text-gray-400">
            Free for up to 25 students. Paid plans from $29 a month. • No credit card
          </p>
          <p class="mt-3 text-sm text-gray-300">
            Switching? <a href="/switch/" class="underline hover:text-white">Bring your students with you</a>
          </p>
        </div>
        <figure>
          <img
            src="/images/app/mma-timetable.webp"
            width="1600"
            height="1000"
            alt="BeltManager's weekly class schedule: each class shows how many regulars are expected and a link to open attendance (demo data)"
            class="w-full h-auto rounded-xl shadow-2xl ring-1 ring-white/10"
            fetchpriority="high"
            decoding="async"
          />
          <figcaption class="mt-3 text-sm text-gray-400 text-center">
            This week's classes, each already expecting its regulars. Demo school data.
          </figcaption>
        </figure>
      </div>
    </div>
    <!-- Decorative element -->
    <div class="absolute -bottom-1 left-0 right-0">
      <svg class="w-full h-12 text-white" viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M0,0V46.29c47.79,22.2,103.59,32.17,158,28,70.36-5.37,136.33-33.31,206.8-37.5C438.64,32.43,512.34,53.67,583,72.05c69.27,18,138.3,24.88,209.4,13.08,36.15-6,69.85-17.84,104.45-29.34C989.49,25,1113-14.29,1200,52.47V0Z" fill="currentColor" opacity=".25"></path>
        <path d="M0,0V15.81C13,36.92,27.64,56.86,47.69,72.05,99.41,111.27,165,111,224.58,91.58c31.15-10.15,60.09-26.07,89.67-39.8,40.92-19,84.73-46,130.83-49.67,36.26-2.85,70.9,9.42,98.6,31.56,31.77,25.39,62.32,62,103.63,73,40.44,10.79,81.35-6.69,119.13-24.28s75.16-39,116.92-43.05c59.73-5.85,113.28,22.88,168.9,38.84,30.2,8.66,59,6.17,87.09-7.5,22.43-10.89,48-26.93,60.65-49.24V0Z" fill="currentColor" opacity=".5"></path>
        <path d="M0,0V5.63C149.93,59,314.09,71.32,475.83,42.57c43-7.64,84.23-20.12,127.61-26.46,59-8.63,112.48,12.24,165.56,35.4C827.93,77.22,886,95.24,951.2,90c86.53-7,googl172.46-45.71,248.8-84.81V0Z" fill="currentColor"></path>
      </svg>
    </div>
  </section>

  <!-- Highlights: the headline's claims in full (carried over from the retired /us/ page) -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-brand-navy mb-4">Less admin before class, after class and on test day</h2>
        <p class="text-lg text-gray-600">Join a program group once and you're a regular. That one idea does most of the work.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {highlights.map((h) => (
          <div class="card">
            <h3 class="text-xl font-bold text-brand-navy mb-2">{h.title}</h3>
            <p class="text-gray-600">{h.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works: the aha moment in three real screens (#22) -->
  <section id="how-it-works" class="section bg-white scroll-mt-20">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="badge-primary mb-4">How it works</span>
        <h2 class="text-3xl md:text-5xl font-bold text-brand-navy mb-6">
          No more paper attendance sheets
        </h2>
        <p class="text-xl text-gray-600">
          Three screens, from adding a student to their next belt test.
        </p>
      </div>
      <ol class="grid md:grid-cols-3 gap-8">
        {howItWorks.map((step, index) => (
          <li class="card flex flex-col">
            <div class="flex items-center gap-3 mb-4">
              <span class="w-10 h-10 rounded-full bg-brand-red text-white font-bold flex items-center justify-center flex-shrink-0">{index + 1}</span>
              <h3 class="text-xl font-bold text-brand-navy">{step.title}</h3>
            </div>
            <p class="text-gray-600 mb-6">{step.text}</p>
            <figure class="mt-auto">
              <div class="relative aspect-[4/3] overflow-hidden rounded-lg border border-gray-200 bg-gray-50">
                <img
                  src={step.image}
                  width={step.width}
                  height={step.height}
                  alt={`${step.alt} (BeltManager screenshot, demo data)`}
                  class="absolute left-0 top-0 h-auto max-w-none"
                  style={step.crop}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <figcaption class="mt-2 text-sm text-gray-500">{step.caption}</figcaption>
            </figure>
          </li>
        ))}
      </ol>
      <div class="text-center mt-12">
        <a href={appLink(Astro.url.pathname, 'how-it-works')} class="btn-primary" data-ph-capture-attribute-cta="how-it-works-get-started" data-ph-capture-attribute-hero-version="aha-2026-11">
          Get started free
        </a>
      </div>
    </div>
  </section>

  <!-- Trust Badges -->
  <section class="py-12 bg-gray-50 border-b border-gray-100">
    <div class="container-custom">
      <p class="text-center text-sm text-gray-500 uppercase tracking-wider mb-8">Built to scale with your school</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {stats.map((stat) => (
          <div>
            <div class="text-3xl md:text-4xl font-bold text-brand-navy">{stat.number}</div>
            <div class="text-sm text-gray-600 mt-1">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="badge-primary mb-4">Features</span>
        <h2 class="text-3xl md:text-5xl font-bold text-brand-navy mb-6">
          Everything You Need to Run Your Martial Arts School
        </h2>
        <p class="text-xl text-gray-600">
          From class scheduling to student management, we've got you covered with powerful tools designed specifically for martial arts schools.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {features.map((feature) => (
          <div class="card group">
            <div class="w-12 h-12 rounded-xl bg-brand-red-light flex items-center justify-center mb-4 group-hover:bg-brand-red transition-colors">
              <svg class="w-6 h-6 text-brand-red group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                {feature.icon === 'calendar' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />}
                {feature.icon === 'users' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />}
                {feature.icon === 'credit-card' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />}
                {feature.icon === 'chart' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />}
                {feature.icon === 'belt' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />}
                {feature.icon === 'mobile' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />}
              </svg>
            </div>
            <h3 class="text-xl font-bold text-brand-navy mb-2">{feature.title}</h3>
            <p class="text-gray-600">{feature.description}</p>
          </div>
        ))}
      </div>
      
      <div class="text-center mt-12">
        <a href="/martial-arts-software/" class="btn-outline">
          See All Features
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Image Feature Section -->
  <section class="section bg-gray-50">
    <div class="container-custom">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="badge-primary mb-4">For All Martial Arts</span>
          <h2 class="text-3xl md:text-4xl font-bold text-brand-navy mb-6">
            Built for Every Style and Discipline
          </h2>
          <p class="text-lg text-gray-600 mb-6">
            Whether you run a karate dojo, BJJ academy, taekwondo school, or MMA gym, BeltManager adapts to your unique needs with customizable belt systems, class structures, and terminology. Running a traditional dojo? See our <a href="/dojo-management-software/" class="text-brand-red hover:underline">dojo management software</a>.
          </p>
          <ul class="space-y-4 mb-8">
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-brand-red flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span class="text-gray-700"><strong class="text-brand-navy">Karate & Traditional Arts:</strong> Kyu/Dan ranking, kata tracking, tournament and seminar events</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-brand-red flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span class="text-gray-700"><strong class="text-brand-navy">BJJ & Grappling:</strong> IBJJF belt system, stripe tracking, competition achievements</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-brand-red flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span class="text-gray-700"><strong class="text-brand-navy">MMA & Kickboxing:</strong> Multi-discipline belt tracking, competition achievements</span>
            </li>
          </ul>
          <a href="/dojo-management-software/" class="btn-primary">
            Explore Dojo Management Software
          </a>
        </div>
        <div class="relative">
          <img
            src="/images/full-shot-asian-people-practicing-taekwondo.jpg"
            alt="Martial arts students training"
