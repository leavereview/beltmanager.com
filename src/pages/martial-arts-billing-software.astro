---
import { appLink } from '../utils/appLink';
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbsEnhanced from '../components/seo/BreadcrumbsEnhanced.astro';
import FeaturedAnswer from '../components/seo/FeaturedAnswer.astro';
import ComparisonTable from '../components/seo/ComparisonTable.astro';
import FAQEnhanced from '../components/seo/FAQEnhanced.astro';
import AppScreenshot from '../components/AppScreenshot.astro';

const comparisonData = [
  {
    label: 'Recurring Card Billing (from April 2027)',
    values: [true, true, false],
    highlight: true
  },
  {
    label: 'Failed Payment Retries & Reminders',
    values: [true, 'Limited', false],
    highlight: true
  },
  {
    label: 'Sibling Discount',
    values: [true, false, 'Manual calculation'],
    highlight: true
  },
  {
    label: 'One Invoice per Family',
    values: [true, false, 'Separate invoices'],
    highlight: true
  },
  {
    label: 'Record Cash & Bank Payments by Hand',
    values: [true, false, true]
  },
  {
    label: 'Membership Freezes',
    values: [true, false, 'Manual']
  },
  {
    label: 'Optional Late Fee',
    values: [true, false, 'Manual']
  },
  {
    label: 'E-Signed Contracts & Waivers',
    values: [true, false, 'Paper']
  },
  {
    label: 'Revenue Report with CSV Export',
    values: [true, 'Basic', 'Manual exports']
  },
  {
    label: 'Card Details Held by Stripe, Not by You',
    values: [true, true, 'Paper/manual']
  }
];

const faqItems = [
  {
    question: "Is BeltManager billing available now?",
    answer: "Not yet for card payments. BeltManager has a free plan for up to 25 students, and card billing switches on in April 2027 (the Free plan pays a 1% platform fee on card payments; paid plans pay 0%). Until then you can set up memberships and families and record cash or bank-transfer payments by hand, so your records are ready when card billing starts.",
    links: [
      { text: 'See pricing', url: '/pricing/' },
      { text: 'Get started free', url: appLink(Astro.url.pathname, 'faq') }
    ]
  },
  {
    question: "What is martial arts billing software?",
    answer: "Martial arts billing software collects membership fees for a school: recurring charges, family invoices, sibling discounts, failed-payment follow-up and revenue reporting. Unlike a generic payment processor, it knows which students belong to which family and membership.",
    links: [
      { text: 'View all features', url: '/martial-arts-software/' },
      { text: 'See pricing', url: '/pricing/' }
    ]
  },
  {
    question: "How will automated billing work in BeltManager?",
    answer: "From April 2027, you save a family's card through Stripe and BeltManager charges their membership on the due date. Each family gets one invoice covering all their children. Card details are held by Stripe, never by BeltManager.",
    links: [
      { text: 'Scheduling features', url: '/martial-arts-scheduling-software/' },
      { text: 'Contact us', url: '/contact/' }
    ]
  },
  {
    question: "What happens when a payment fails?",
    answer: "BeltManager retries the card two days after the due date and again on day five. On day seven the family gets one friendly email. You're only told on day fourteen if it's still unpaid, and the invoice stays on the Overdue tab. Nothing in this process stops a child from training. You can choose to add a late fee, which the reminder names in advance.",
    links: [
      { text: 'CRM features', url: '/martial-arts-crm/' },
      { text: 'Get started free', url: appLink(Astro.url.pathname, 'faq') }
    ]
  },
  {
    question: "How do family discounts work?",
    answer: "Set a sibling discount percentage for a household. All the children appear on one family invoice, with the discount shown line by line.",
    links: [
      { text: 'Dojo management', url: '/dojo-management-software/' },
      { text: 'See pricing', url: '/pricing/' }
    ]
  },
  {
    question: "What payment methods are supported?",
    answer: "Card payments through Stripe from April 2027, plus cash and bank transfers recorded by hand at any time. Direct debit isn't available yet.",
    links: [
      { text: 'Overview', url: '/martial-arts-software/' },
      { text: 'Contact us', url: '/contact/' }
    ]
  },
  {
    question: "Does BeltManager prorate mid-month changes?",
    answer: "No. BeltManager doesn't prorate: a membership that starts or changes mid-cycle is charged at its normal amount from its billing date.",
    links: [
      { text: 'Scheduling software', url: '/martial-arts-scheduling-software/' },
      { text: 'Get started free', url: appLink(Astro.url.pathname, 'faq') }
    ]
  },
  {
    question: "Can BeltManager handle grading fees?",
    answer: "You can raise a one-off invoice for a grading fee. Grading fees aren't added to the family invoice automatically yet.",
    links: [
      { text: 'Karate features', url: '/karate-school-software/' },
      { text: 'BJJ features', url: '/bjj-gym-software/' }
    ]
  },
  {
    question: "Can members freeze their membership?",
    answer: "Yes. You can freeze a membership for injury, holidays or exams, and billing pauses for the freeze.",
    links: [
      { text: 'Dojo management', url: '/dojo-management-software/' },
      { text: 'See pricing', url: '/pricing/' }
    ]
  },
  {
    question: "Is my payment data secure?",
    answer: "Card payments run through Stripe, which is PCI DSS compliant. BeltManager never sees or stores full card numbers.",
    links: [
      { text: 'Overview', url: '/martial-arts-software/' },
      { text: 'Contact us', url: '/contact/' }
    ]
  }
];

const breadcrumbItems = [
  { label: 'Home', url: 'https://beltmanager.com/' },
  { label: 'Billing Software', url: 'https://beltmanager.com/martial-arts-billing-software/' }
];
---

<BaseLayout
  title="Recurring Billing for Martial Arts Schools"
  description="Family invoices, sibling discounts, freezes and polite failed-payment follow-up. Card billing switches on April 2027; record payments by hand until then. Free for up to 25 students. Paid plans from £29 a month."
>
  <BreadcrumbsEnhanced site="beltmanager" items={breadcrumbItems} />

  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block bg-brand-50 text-brand-700 px-4 py-2 rounded-full text-sm font-semibold mb-6">
          Complete Billing Guide
        </span>
        <h1 class="text-4xl md:text-5xl font-bold text-navy mb-6">
          Martial Arts Billing Software
        </h1>
        <p class="text-xl text-gray-600 mb-8">
          One invoice per family, sibling discounts, freezes and polite failed-payment follow-up. Card billing switches on in April 2027; until then, record payments by hand.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href={appLink(Astro.url.pathname, 'hero')} class="btn-primary">Get started free</a>
          <a href="/pricing/" class="btn-secondary">View Pricing</a>
        </div>
      </div>
    </div>
  </section>

  <FeaturedAnswer question="What is martial arts billing software?">
    Martial arts billing software collects membership fees for a school: recurring charges, one invoice per family, sibling discounts, failed-payment follow-up and revenue reporting. In BeltManager, card billing through Stripe switches on in April 2027; until then, schools record payments by hand.
  </FeaturedAnswer>

  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto prose prose-lg">
        <h2>Billing in BeltManager: What's Live and What's Coming</h2>
        <p>
          BeltManager is free for up to 25 students, with paid plans from £29 a month. Card billing is built, and it switches on in April 2027. When it does, the Free plan pays a 1% platform fee on card payments collected through BeltManager, on top of Stripe's fee; paid plans pay 0%, and cash and standing orders never carry a fee. Until then you can set up memberships and families and record cash or bank-transfer payments by hand. We'd rather say that plainly than have you sign up expecting to take card payments next week.
        </p>
        <p>
          Martial arts pricing is rarely one flat fee. Families have two or three children training, memberships pause for injuries and exams, and a few people always pay late. BeltManager's billing is built around families and memberships, not single transactions.
        </p>

        <AppScreenshot src="/images/app/billing-revenue.webp" width={1600} height={1108} caption="The revenue report: what was collected by month and by membership, with CSV export (switches on with card billing in April 2027)" />

        <h2>Recurring Card Billing</h2>
        <p>
          From April 2027, you save a family's card through Stripe once and BeltManager charges their membership on the due date. Card details are held by Stripe, never by BeltManager or by you.
        </p>

        <AppScreenshot src="/images/app/billing-overdue.webp" width={1600} height={769} caption="Overdue invoices: automatic card retries, a failed-card alert and an optional late fee (switches on with card billing in April 2027)" />

        <h2>Failed Payments, Handled Politely</h2>
        <p>
          When a card fails, BeltManager retries it two days after the due date and again on day five. On day seven the family gets one friendly email. You are only pulled in on day fourteen if it's still unpaid, and the invoice stays on the Overdue tab until it's settled.
        </p>
        <p>
          Nothing in that process stops a child from training. It escalates the conversation, never access. If you want, you can switch on a late fee as a percentage of the invoice; the reminder email names it before it is ever applied.
        </p>

        <AppScreenshot src="/images/app/billing-family-invoice.webp" width={820} height={832} caption="A family invoice: three siblings on one invoice with the 10% sibling discount itemised" />

        <h2>One Invoice per Family, with Sibling Discounts</h2>
        <p>
          Every child in a household goes on one family invoice. Set a sibling discount percentage for the household and it's shown line by line, so parents can see exactly what they're paying for each child.
        </p>

        <h2>Membership Freezes</h2>
        <p>
          Injuries, exams and long holidays happen. Freeze a membership and billing pauses until the freeze ends. If a late fee was due, a freeze means the family gets a fresh warning first.
        </p>

        <h2>Recording Payments by Hand</h2>
        <p>
          Some families will always pay cash or by bank transfer. Record those payments against the invoice so your records stay complete. This works today, before card billing switches on.
        </p>

        <h2>Contracts and Waivers</h2>
        <p>
          Families can sign your contract and waiver documents online in the parent portal, and you can see who has signed. BeltManager doesn't track minimum terms, end dates or auto-renewal on memberships.
        </p>

        <h2>Revenue Reporting</h2>
        <p>
          The revenue report shows what was collected by month and by membership, and exports to CSV for your accountant. It fills in once card billing switches on in April 2027.
        </p>

        <h2>What BeltManager Billing Doesn't Do Yet</h2>
        <p>
          Direct debit isn't available. Grading fees aren't added to family invoices automatically (you can raise a one-off invoice instead). BeltManager doesn't prorate mid-cycle changes, and there's no point of sale for uniforms or equipment.
        </p>

        <h2>Getting Ready for Card Billing</h2>
        <p>
          You don't have to wait until April to get your records straight. Add your families, set up memberships and sibling discounts, and record payments by hand now. When card billing switches on, you save each family's card and BeltManager takes it from there.
        </p>
      </div>
    </div>
  </section>

  <!-- Related Guides -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl font-bold text-navy mb-6">Related Guides</h2>
        <div class="grid md:grid-cols-3 gap-4">
          <a href="/blog/gym-owner-salary-guide/" class="block p-4 bg-light-red rounded-lg hover:shadow-md transition-shadow">
            <h3 class="font-semibold text-navy mb-1">How Much Do Gym Owners Make?</h3>
            <p class="text-sm text-gray-600">Salary and revenue expectations for martial arts school owners</p>
          </a>
          <a href="/blog/cost-to-open-gym/" class="block p-4 bg-light-red rounded-lg hover:shadow-md transition-shadow">
            <h3 class="font-semibold text-navy mb-1">Cost to Open a Gym</h3>
            <p class="text-sm text-gray-600">Full financial breakdown for starting a martial arts school</p>
          </a>
          <a href="/blog/gym-management-software-comparison/" class="block p-4 bg-light-red rounded-lg hover:shadow-md transition-shadow">
            <h3 class="font-semibold text-navy mb-1">Gym Management Software Comparison</h3>
            <p class="text-sm text-gray-600">Compare billing features across leading platforms</p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <ComparisonTable
    title="Martial Arts Billing vs Generic Payment Processing vs Manual Collection"
    headers={['BeltManager (Martial Arts-Specific)', 'Generic Payment Processor', 'Manual Collection']}
    rows={comparisonData}
  />

  <FAQEnhanced
    site="beltmanager"
    pageUrl="https://beltmanager.com/martial-arts-billing-software/"
    title="Frequently Asked Questions About Martial Arts Billing Software"
    faqs={faqItems}
  />

  <section class="section bg-navy text-white">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">
          Get Your Billing Records Ready
        </h2>
        <p class="text-xl mb-8 text-gray-300">
          Set up families and memberships now and record payments by hand. Card billing switches on in April 2027. Get started free today.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href={appLink(Astro.url.pathname, 'bottom')} class="btn-primary">Get started free</a>
          <a href="/pricing/" class="btn-secondary bg-white text-navy hover:bg-gray-100">View Pricing</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    padding: 4rem 0;
  }

  @media (min-width: 768px) {
    .section {
      padding: 6rem 0;
    }
  }

  .prose {
    color: #14161F;
  }

  .prose h2 {
    color: #14161F;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose p {
    margin-bottom: 1.25rem;
    line-height: 1.75;
  }

  .prose a {
    color: #C0420B;
    text-decoration: none;
  }

  .prose a:hover {
    text-decoration: underline;
  }
</style>
