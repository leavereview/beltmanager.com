---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbsEnhanced from '../components/seo/BreadcrumbsEnhanced.astro';
import FeaturedAnswer from '../components/seo/FeaturedAnswer.astro';
import ComparisonTable from '../components/seo/ComparisonTable.astro';
import FAQEnhanced from '../components/seo/FAQEnhanced.astro';
import AppScreenshot from '../components/AppScreenshot.astro';

const comparisonData = [
  {
    label: 'Membership plans per student',
    values: [true, 'Varies', 'Spreadsheets'],
    highlight: true
  },
  {
    label: 'Record cash and bank-transfer payments',
    values: [true, false, 'Manual'],
    highlight: true
  },
  {
    label: 'Accountant-ready revenue CSV',
    values: [true, 'Varies', 'Manual exports'],
    highlight: true
  },
  {
    label: 'Automatic recurring card billing (Stripe)',
    values: ['Coming April 2027', true, false]
  },
  {
    label: 'Failed-payment retries and reminders',
    values: ['Coming April 2027', 'Varies', false]
  },
  {
    label: 'One invoice per family, with sibling discount',
    values: ['Coming April 2027', false, 'Manual calculation']
  },
  {
    label: 'Membership freezes',
    values: ['Coming April 2027', 'Varies', 'Manual']
  }
];

const faqItems = [
  {
    question: "What is martial arts billing software?",
    answer: "Martial arts billing software collects membership fees for a martial arts school. It understands how schools charge: memberships per student, families with several children, and one-off charges. In BeltManager, you can set up membership plans and record payments by hand today. Automatic card billing is coming in April 2027.",
    links: [
      { text: 'View all features', url: '/martial-arts-software/' },
      { text: 'See pricing', url: '/pricing/' }
    ]
  },
  {
    question: "Can BeltManager take payments today?",
    answer: "No. Automatic card billing is built but switches on in April 2027. Until then, set up your membership plans, record payments by hand (cash, bank transfer, or however you collect today), and export an accountant-ready revenue CSV for any date range.",
    links: [
      { text: 'See pricing', url: '/pricing/' },
      { text: 'Contact us', url: '/contact/' }
    ]
  },
  {
    question: "What will happen when a card payment fails?",
    answer: "From April 2027, when card billing is switched on: BeltManager retries the card twice (two and five days after the due date), sends the family one friendly reminder after a week, and only tells you if it's still unpaid after two weeks. An unpaid invoice never stops a child from training.",
    links: [
      { text: 'CRM features', url: '/martial-arts-crm/' },
      { text: 'Get started free', url: 'https://app.beltmanager.com/signin' }
    ]
  },
  {
    question: "Will there be family discounts?",
    answer: "Yes, from April 2027. Each household gets one invoice for all its children, and you can set a sibling discount percentage per household.",
    links: [
      { text: 'Dojo management', url: '/dojo-management-software/' },
      { text: 'See pricing', url: '/pricing/' }
    ]
  },
  {
    question: "What payment methods are supported?",
    answer: "From April 2027, debit and credit cards through Stripe. Today, you record payments by hand. Direct Debit isn't available.",
    links: [
      { text: 'Overview', url: '/martial-arts-software/' },
      { text: 'Contact us', url: '/contact/' }
    ]
  },
  {
    question: "Can I charge grading fees?",
    answer: "Not automatically. Once card billing is on (April 2027) you can raise a one-off invoice for a grading fee by hand. Grading fees aren't added to invoices automatically.",
    links: [
      { text: 'Karate features', url: '/karate-school-software/' },
      { text: 'BJJ features', url: '/bjj-gym-software/' }
    ]
  },
  {
    question: "What billing reports are available?",
    answer: "The revenue report shows what was collected by month and by membership, and you can export an accountant-ready CSV for any date range. There's no direct Xero or QuickBooks connection; send the CSV to your accountant.",
    links: [
      { text: 'CRM features', url: '/martial-arts-crm/' },
      { text: 'Contact us', url: '/contact/' }
    ]
  },
  {
    question: "Is payment data secure?",
    answer: "When card billing switches on, card details are handled by Stripe. BeltManager never sees or stores full card numbers.",
    links: [
      { text: 'Overview', url: '/martial-arts-software/' },
      { text: 'Contact us', url: '/contact/' }
    ]
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};

const breadcrumbItems = [
  { label: 'Home', url: 'https://beltmanager.com/' },
  { label: 'Billing Software', url: 'https://beltmanager.com/martial-arts-billing-software/' }
];
---

<BaseLayout
  title="Membership Billing for Martial Arts Schools"
  description="Set up membership plans and record payments today, with an accountant-ready revenue CSV. Automatic card billing is coming April 2027. Free until 31 March 2027."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <BreadcrumbsEnhanced site="beltmanager" items={breadcrumbItems} />

  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block bg-red-50 text-red-600 px-4 py-2 rounded-full text-sm font-semibold mb-6">
          Automatic card billing: coming April 2027
        </span>
        <h1 class="text-4xl md:text-5xl font-bold text-navy mb-6">
          Martial Arts Billing Software
        </h1>
        <p class="text-xl text-gray-600 mb-8">
          Set up membership plans and record payments today. Automatic card billing, failed-payment reminders and family invoices are coming in April 2027.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="https://app.beltmanager.com/signin" class="btn-primary">Get started free</a>
          <a href="/pricing/" class="btn-secondary">View Pricing</a>
        </div>
      </div>
    </div>
  </section>

  <FeaturedAnswer question="What is martial arts billing software?">
    Martial arts billing software collects membership fees for a martial arts school, handling memberships per student, family invoices and one-off charges. BeltManager lets you set up memberships and record payments by hand today; automatic card billing is coming in April 2027.
  </FeaturedAnswer>

  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto prose prose-lg">
        <h2>Where Billing Is Today</h2>
        <p>
          We'd rather be straight with you. BeltManager's automatic card billing is built, but it switches on in <strong>April 2027</strong>. A school that signs up today can't collect card payments through BeltManager yet.
        </p>
        <p>
          What you can do today: set up your membership plans, put each student on the right one, record payments by hand (cash, bank transfer, or however you collect now), and export an accountant-ready revenue CSV for any date range.
        </p>

        <AppScreenshot src="/images/app/billing-revenue.webp" width={1600} height={1108} caption="The revenue report: what was collected by month and by membership, with CSV export" />

        <h2>Coming April 2027: Automatic Card Billing</h2>
        <p>
          Add a family's card once and BeltManager charges their membership on the due date, through Stripe. Card details are handled by Stripe; BeltManager never stores full card numbers.
        </p>

        <AppScreenshot src="/images/app/billing-overdue.webp" width={1600} height={769} caption="Coming April 2027: overdue invoices, automatic card retries, a failed-card alert and an optional late fee" />

        <h2>Coming April 2027: Failed Payments, Handled Kindly</h2>
        <p>
          When a card payment fails, BeltManager retries it twice, two and five days after the due date. If it's still unpaid after a week, the family gets one friendly reminder. You're only told if it's still unpaid after two weeks. An unpaid invoice never stops a child from training. You can also switch on an optional late fee.
        </p>

        <AppScreenshot src="/images/app/billing-family-invoice.webp" width={820} height={832} caption="Coming April 2027: three siblings on one family invoice with a 10% sibling discount itemised" />

        <h2>Coming April 2027: Family Invoices and Sibling Discounts</h2>
        <p>
          Each household gets one invoice for all its children, with each child's membership itemised. Set a sibling discount percentage for the household and it's applied for you. You can also freeze a membership, for example over an injury, without cancelling it.
        </p>

        <h2>What BeltManager Billing Doesn't Do</h2>
        <p>
          So you can plan around it: there's no Direct Debit, no point-of-sale or shop, no pro-rata billing for mid-month starts, no fixed-term contracts with end dates or auto-renewal, and grading fees aren't added to invoices automatically. There's no direct Xero or QuickBooks connection; send the revenue CSV to your accountant instead.
        </p>

        <h2>Cost</h2>
        <p>
          BeltManager is free until 31 March 2027, with no subscription, no commission and no per-student charges. When card billing switches on, Stripe's own card processing fees will apply. Pricing for BeltManager after 31 March 2027 will be announced with notice.
        </p>
      </div>
    </div>
  </section>

  <!-- Related Guides -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl font-bold text-navy mb-6">Related Guides</h2>
        <div class="grid md:grid-cols-3 gap-4">
          <a href="/blog/gym-owner-salary-guide/" class="block p-4 bg-light-red rounded-lg hover:shadow-md transition-shadow">
            <h3 class="font-semibold text-navy mb-1">How Much Do Gym Owners Make?</h3>
            <p class="text-sm text-gray-600">Salary and revenue expectations for martial arts school owners</p>
          </a>
          <a href="/blog/cost-to-open-gym/" class="block p-4 bg-light-red rounded-lg hover:shadow-md transition-shadow">
            <h3 class="font-semibold text-navy mb-1">Cost to Open a Gym</h3>
            <p class="text-sm text-gray-600">Full financial breakdown for starting a martial arts school</p>
          </a>
          <a href="/blog/gym-management-software-comparison/" class="block p-4 bg-light-red rounded-lg hover:shadow-md transition-shadow">
            <h3 class="font-semibold text-navy mb-1">Gym Management Software Comparison</h3>
            <p class="text-sm text-gray-600">Compare billing features across leading platforms</p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <ComparisonTable
    title="BeltManager Billing vs Generic Payment Processing vs Manual Collection"
    headers={['BeltManager (Martial Arts-Specific)', 'Generic Payment Processor', 'Manual Collection']}
    rows={comparisonData}
  />

  <FAQEnhanced
    site="beltmanager"
    pageUrl="https://beltmanager.com/martial-arts-billing-software/"
    title="Frequently Asked Questions About Martial Arts Billing Software"
    faqs={faqItems}
  />

  <section class="section bg-navy text-white">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">
          Get Set Up Now, Ready for April 2027
        </h2>
        <p class="text-xl mb-8 text-gray-300">
          Set up your memberships and students today, free until 31 March 2027. Card billing switches on in April 2027.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="https://app.beltmanager.com/signin" class="btn-primary">Get started free</a>
          <a href="/pricing/" class="btn-secondary bg-white text-navy hover:bg-gray-100">View Pricing</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    padding: 4rem 0;
  }

  @media (min-width: 768px) {
    .section {
      padding: 6rem 0;
    }
  }

  .prose {
    color: #1a1a2e;
  }

  .prose h2 {
    color: #1a1a2e;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose p {
    margin-bottom: 1.25rem;
    line-height: 1.75;
  }

  .prose a {
    color: #e94560;
    text-decoration: none;
  }

  .prose a:hover {
    text-decoration: underline;
  }
</style>
