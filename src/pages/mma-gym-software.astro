---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbsEnhanced from '../components/seo/BreadcrumbsEnhanced.astro';
import FeaturedAnswer from '../components/seo/FeaturedAnswer.astro';
import ComparisonTable from '../components/seo/ComparisonTable.astro';
import FAQEnhanced from '../components/seo/FAQEnhanced.astro';
import AppScreenshot from '../components/AppScreenshot.astro';

const comparisonData = [
  {
    label: 'Multi-Discipline Timetable',
    values: [true, false, 'Manual'],
    highlight: true
  },
  {
    label: 'Separate Belt System per Discipline',
    values: [true, false, false],
    highlight: true
  },
  {
    label: 'BJJ Belts and Stripes',
    values: [true, true, false],
    highlight: true
  },
  {
    label: 'Competition Results as Achievements',
    values: [true, 'Varies', 'Manual']
  },
  {
    label: 'Tournament and Seminar Events',
    values: [true, 'Varies', 'Manual']
  },
  {
    label: 'Open Mat as a Class',
    values: [true, true, false]
  },
  {
    label: 'All-Access and Single-Discipline Plans',
    values: [true, 'Varies', false]
  },
  {
    label: 'Monthly Price',
    values: ['Free until 31 March 2027', 'Varies', '£0']
  }
];

const faqItems = [
  {
    question: "What is MMA gym software?",
    answer: "MMA gym software is a management platform for mixed martial arts gyms. It runs a timetable across several disciplines (BJJ, Muay Thai, wrestling, boxing, MMA), tracks progression in each art, and handles members and memberships. BeltManager does this, with a separate belt system per discipline and one record per student.",
    links: [
      { text: 'View all features', url: '/martial-arts-software/' },
      { text: 'See pricing', url: '/pricing/' }
    ]
  },
  {
    question: "How does BeltManager handle multiple disciplines?",
    answer: "Each discipline can have its own classes and its own belt or grade system, for example BJJ belts with stripes alongside Muay Thai grades. A student who trains in several arts has one record, with a belt in each.",
    links: [
      { text: 'Multi-discipline features', url: '/martial-arts-software/' },
      { text: 'BJJ belt tracking', url: '/bjj-gym-software/' }
    ]
  },
  {
    question: "Can BeltManager track fighter development?",
    answer: "Only partly. You can record competition results and medals as achievements, list fights and tournaments as events, add per-student notes after a session, and run your fight team as its own group. There are no fight records, sparring logs, weight-cut tracking or fight-camp planning.",
    links: [
      { text: 'All features', url: '/martial-arts-software/' }
    ]
  },
  {
    question: "What membership options does BeltManager support?",
    answer: "Set up as many membership plans as you need, such as an all-access plan alongside single-discipline plans. Today you record payments by hand; automatic card billing is coming in April 2027. There are no punch cards, private-coaching packages or pro-rata billing.",
    links: [
      { text: 'Membership management', url: '/martial-arts-software/' },
      { text: 'Billing features', url: '/martial-arts-billing-software/' }
    ]
  },
  {
    question: "Does BeltManager track BJJ belt ranks?",
    answer: "Yes. Set up BJJ belts from white to black, with stripes, a minimum time at belt and number of sessions. BeltManager shows who is ready, records each promotion, prints a rank certificate, and sends the student a promotion notice.",
    links: [
      { text: 'Belt tracking', url: '/bjj-gym-software/' },
      { text: 'BJJ belt guide', url: '/blog/bjj-belts-order-complete-guide/' }
    ]
  },
  {
    question: "How much does MMA gym software cost?",
    answer: "When we checked competitors' published pricing in November 2026, the main martial arts platforms ranged from about $49 to $350 a month, depending on member numbers and features. BeltManager is free until 31 March 2027, with no subscription and no per-member fees.",
    links: [
      { text: 'View pricing', url: '/pricing/' },
      { text: 'Feature comparison', url: '/martial-arts-software/' }
    ]
  },
  {
    question: "What reports are available?",
    answer: "An attendance report by class and student for any date range, with CSV export; at-risk and inactive member lists; an insurance compliance report; and an accountant-ready revenue CSV.",
    links: [
      { text: 'Reporting features', url: '/martial-arts-software/' },
      { text: 'CRM features', url: '/martial-arts-crm/' }
    ]
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<BaseLayout
  title="MMA Gym Software (2026)"
  description="Run your MMA gym with a multi-discipline timetable, a belt system per discipline, and flexible memberships. Free until 31 March 2027."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <!-- Breadcrumbs -->
  <BreadcrumbsEnhanced
    site="beltmanager"
    items={[
      { label: 'Home', href: '/' },
      { label: 'MMA Gym Software', href: '/mma-gym-software/' }
    ]}
  />

  <!-- Hero Section -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block px-4 py-2 mb-4 text-sm font-semibold text-brand-red bg-brand-red-light rounded-full">Complete Guide</span>
        <h1 class="text-4xl md:text-5xl font-bold text-brand-navy mb-4">MMA Gym Software</h1>
        <p class="text-xl text-gray-600">
          Management software for mixed martial arts gyms. A multi-discipline timetable, a belt system for each discipline, and flexible membership plans.
        </p>
      </div>
    </div>
  </section>

  <!-- Featured Answer -->
  <FeaturedAnswer question="What is MMA gym software?">
    MMA gym software is a management platform for mixed martial arts gyms. It runs a timetable across several disciplines (BJJ, Muay Thai, wrestling, boxing, MMA), tracks progression in each art, and handles members and memberships for gyms serving both recreational members and competitors.
  </FeaturedAnswer>

  <!-- Main Content -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto prose prose-lg">

        <h2>Management for Mixed Martial Arts Gyms</h2>

        <p>
          Mixed martial arts gyms bring several combat disciplines under one roof: striking, wrestling and submission grappling, for fighters preparing for competition and for recreational members who just love to train.
        </p>

        <p>
          Running several disciplines at once adds admin that single-style schools don't have. BeltManager keeps one record per member while each discipline keeps its own classes and progression.
        </p>

        <AppScreenshot src="/images/app/mma-timetable.webp" width={1600} height={1000} caption="The weekly timetable for one venue: Muay Thai, Wrestling, MMA, BJJ and karate classes with their expected regulars" />

        <h3>Multi-Discipline Training Structure</h3>

        <p>A typical MMA gym offers instruction across several combat disciplines:</p>

        <ul>
          <li><strong>Brazilian Jiu-Jitsu:</strong> Gi and no-gi sessions with belt progression</li>
          <li><strong>Muay Thai or Kickboxing:</strong> Striking fundamentals through advanced techniques</li>
          <li><strong>Wrestling or Grappling:</strong> Takedowns, control, and ground positioning</li>
          <li><strong>Boxing:</strong> Footwork, head movement, and punching combinations</li>
          <li><strong>MMA-Specific Classes:</strong> Integrated training combining all disciplines</li>
        </ul>

        <p>
          Each discipline may have its own progression system. BJJ follows belt ranks from white through black. Striking arts may use grades or none at all. Wrestling often has no formal ranking. BeltManager lets each discipline keep its own system, or none, while every member has one record.
        </p>

        <h3>Recreational Members and Competitors</h3>

        <p>
          <strong>Recreational members</strong> want fitness, self-defence skills and community. They come to regular classes and progress through the grades.
        </p>

        <p>
          <strong>Competitors</strong> need more: fight preparation, sparring and weight management. BeltManager covers the basics for them (their own group, events and competition achievements) but doesn't do fight records, sparring logs or weight tracking.
        </p>

      </div>
    </div>
  </section>

  <!-- Comparison Table -->
  <section class="section bg-gray-50">
    <div class="container-custom">
      <div class="max-w-5xl mx-auto">
        <ComparisonTable
          title="BeltManager vs Single-Discipline Software vs Spreadsheets"
          headers={['BeltManager (Multi-Discipline)', 'BJJ-Only Software', 'Spreadsheets']}
          rows={comparisonData}
        />
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto prose prose-lg">

        <h2>What BeltManager Does for MMA Gyms</h2>

        <h3>1. Multi-Discipline Classes</h3>
        <ul>
          <li>Classes for each discipline (BJJ, striking, wrestling, MMA) on one timetable</li>
          <li>Venues and rooms for gyms with more than one mat area</li>
          <li>Open mat and sparring sessions as regular classes</li>
          <li>Minimum/maximum belt and age range on each class group (warns, doesn't block)</li>
          <li>Instructor-to-student ratio checks for your insurer</li>
        </ul>

        <AppScreenshot src="/images/app/mma-memberships.webp" width={1600} height={1000} caption="Memberships: an all-access plan covering every adult discipline alongside single-discipline plans" />

        <h3>2. Progression in Each Discipline</h3>
        <ul>
          <li>BJJ belt progression (white, blue, purple, brown, black) with stripes</li>
          <li>Your own grades for striking arts, or none</li>
          <li>Kids belt systems alongside adult ones</li>
          <li>Readiness for the next belt, printable certificates, and promotion notices</li>
        </ul>

        <h3>3. Competitors</h3>
        <ul>
          <li>A group for your fight team, with its own classes</li>
          <li>Fights, tournaments and seminars listed as events</li>
          <li>Medals and results recorded as achievements</li>
          <li>Per-student session notes from coaches</li>
        </ul>

        <h3>4. Memberships</h3>
        <ul>
          <li>All-access memberships covering every discipline</li>
          <li>Single-discipline memberships (BJJ only, striking only)</li>
          <li>Record payments by hand today</li>
          <li>Coming April 2027: automatic card billing and family invoices with sibling discounts</li>
        </ul>

        <h3>What BeltManager Doesn't Do (Yet)</h3>
        <p>
          There are no fight records, sparring logs, weight-cut tracking, fight-camp planning, private-coaching packages, drop-in punch cards, waitlists, or segmented messaging.
        </p>

        <h2>Operational Considerations</h2>

        <h3>Check-In and Attendance</h3>
        <ul>
          <li>Registers on a tablet or phone that keep working offline</li>
          <li>Walk-ins added on the spot</li>
          <li>Tablet kiosk check-in, locked with a PIN</li>
          <li>Trial classes tracked through Leads</li>
          <li>Attendance report with CSV export</li>
        </ul>

        <h2>Related Resources</h2>

        <ul>
          <li><a href="/martial-arts-software/">Martial Arts Software Overview</a> — Complete platform comparison</li>
          <li><a href="/bjj-gym-software/">BJJ Gym Software</a> — BJJ-specific features</li>
          <li><a href="/blog/types-of-martial-arts/">Types of Martial Arts</a> — Compare different disciplines</li>
          <li><a href="/martial-arts-crm/">Martial Arts CRM</a> — Lead and member management</li>
          <li><a href="/blog/best-martial-arts-software/">Best Martial Arts Software</a> — Detailed comparisons</li>
        </ul>

      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <FAQEnhanced
    site="beltmanager"
    pageUrl="https://beltmanager.com/mma-gym-software/"
    title="Frequently Asked Questions About MMA Gym Software"
    faqs={faqItems}
  />

  <!-- CTA Section -->
  <section class="section bg-brand-red text-white">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-bold mb-4">Ready to Try BeltManager in Your Gym?</h2>
        <p class="text-xl mb-8 opacity-95">
          One timetable for every discipline, a belt system for each, and flexible memberships.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="https://app.beltmanager.com/signin" class="btn-primary-large bg-white text-brand-red hover:bg-gray-100">Get started free</a>
          <a href="/pricing/" class="btn-secondary-large border-white text-white hover:bg-white hover:bg-opacity-10">View Pricing</a>
        </div>
        <p class="mt-6 text-sm opacity-90">Free until 31 March 2027 • No credit card • No contract</p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .section {
    padding: 4rem 0;
  }

  .prose {
    max-width: none;
  }

  .prose h2 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--brand-navy);
    margin-top: 3rem;
    margin-bottom: 1.5rem;
  }

  .prose h3 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--brand-navy);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose p {
    margin-bottom: 1.5rem;
    color: #475569;
    line-height: 1.7;
  }

  .prose ul {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
    color: #475569;
  }

  .prose strong {
    color: var(--brand-navy);
    font-weight: 600;
  }

  .prose a {
    color: var(--brand-red);
    text-decoration: none;
  }

  .prose a:hover {
    text-decoration: underline;
  }

  .btn-primary-large,
  .btn-secondary-large {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    border-radius: 8px;
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-primary-large:hover,
  .btn-secondary-large:hover {
    transform: translateY(-2px);
  }

  .btn-secondary-large {
    border: 2px solid;
  }

  @media (max-width: 768px) {
    .section {
      padding: 3rem 0;
    }

    .prose h2 {
      font-size: 1.5rem;
    }

    .prose h3 {
      font-size: 1.25rem;
    }
  }
</style>
