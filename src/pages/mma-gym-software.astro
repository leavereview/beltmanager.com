---
import { appLink } from '../utils/appLink';
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbsEnhanced from '../components/seo/BreadcrumbsEnhanced.astro';
import FeaturedAnswer from '../components/seo/FeaturedAnswer.astro';
import ComparisonTable from '../components/seo/ComparisonTable.astro';
import FAQEnhanced from '../components/seo/FAQEnhanced.astro';
import AppScreenshot from '../components/AppScreenshot.astro';

const comparisonData = [
  {
    label: 'Multi-Discipline Timetable',
    values: [true, false, false],
    highlight: true
  },
  {
    label: 'Separate Belt Ladder per Discipline',
    values: [true, false, false],
    highlight: true
  },
  {
    label: 'BJJ Belts & Stripes',
    values: [true, true, false],
    highlight: true
  },
  {
    label: 'Competition Results as Achievements',
    values: [true, false, false]
  },
  {
    label: 'Open Mat as a Regular Group',
    values: [true, true, false]
  },
  {
    label: 'All-Access & Single-Discipline Memberships',
    values: [true, true, false]
  },
  {
    label: 'Message a Class or the Whole Gym',
    values: [true, true, false]
  },
  {
    label: 'Monthly Price',
    values: ['Free', '£120', '£0']
  }
];

const faqItems = [
  {
    question: "What is MMA gym software?",
    answer: "MMA gym software is a management platform for mixed martial arts facilities. It handles a timetable across several disciplines (BJJ, Muay Thai, wrestling, boxing, MMA), progression in each art, memberships, attendance and communication for gyms serving both recreational members and competitors.",
    links: [
      { text: 'View all features', url: '/martial-arts-software/' },
      { text: 'See pricing', url: '/pricing/' }
    ]
  },
  {
    question: "How does BeltManager handle multiple disciplines?",
    answer: "Each discipline is a style with its own belt or grade ladder, and each class is a group on the weekly timetable. A student can train in several disciplines and see every progression on one profile. Disciplines without formal ranks, like wrestling, can simply run classes without a ladder.",
    links: [
      { text: 'Multi-discipline features', url: '/martial-arts-software/' },
      { text: 'BJJ belt tracking', url: '/bjj-gym-software/' }
    ]
  },
  {
    question: "Does BeltManager track fighter development?",
    answer: "Not in depth. You can record competition results such as medals as achievements, keep notes on a student after each session and list tournaments as events. BeltManager doesn't track fight records, sparring logs or weight cuts.",
    links: [
      { text: 'All features', url: '/martial-arts-software/' }
    ]
  },
  {
    question: "What membership options does BeltManager support?",
    answer: "You can set up all-access memberships covering every discipline alongside single-discipline plans, with sibling discounts for families. Card billing switches on in April 2027; until then you record payments by hand. BeltManager doesn't prorate mid-cycle changes, sell punch cards or sell private coaching packages yet.",
    links: [
      { text: 'Membership management', url: '/martial-arts-software/' },
      { text: 'Billing features', url: '/martial-arts-billing-software/' }
    ]
  },
  {
    question: "How is MMA software different from BJJ software?",
    answer: "While both handle grappling needs like belt and stripe tracking, MMA software also has to run striking classes (Muay Thai, boxing, kickboxing), wrestling and integrated MMA training on one timetable, and show attendance across every discipline in the gym.",
    links: [
      { text: 'MMA vs BJJ software', url: '/martial-arts-software/' },
      { text: 'BJJ-specific features', url: '/bjj-gym-software/' }
    ]
  },
  {
    question: "Does BeltManager track BJJ belt ranks?",
    answer: "Yes. BJJ belts from white through black with stripes on each belt, minimum time and sessions at each belt, a ready-to-grade list and promotion history. Striking disciplines can have their own grade ladder alongside.",
    links: [
      { text: 'Belt tracking', url: '/bjj-gym-software/' },
      { text: 'BJJ belt guide', url: '/blog/bjj-belts-order-complete-guide/' }
    ]
  },
  {
    question: "Can BeltManager manage fight camps?",
    answer: "No. There is no fight camp planning, sparring partner matching or weigh-in tracking. You can list tournaments as events and run a competition team as its own class group.",
    links: [
      { text: 'All features', url: '/martial-arts-software/' }
    ]
  },
  {
    question: "How much does MMA gym software cost?",
    answer: "MMA gym software typically costs £80-200 per month depending on gym size and features. Pricing models include flat-rate (unlimited members) or per-member (£1-3 per active member). BeltManager is free until 31 March 2027, with no subscription and no per-member fees.",
    links: [
      { text: 'View pricing', url: '/pricing/' },
      { text: 'Feature comparison', url: '/martial-arts-software/' }
    ]
  },
  {
    question: "Can recreational members and competitors use the same system?",
    answer: "Yes. Everyone sits in one student database. Put your competition team in its own group, and you can message just that group while general timetable changes reach everyone.",
    links: [
      { text: 'Member management', url: '/martial-arts-software/' },
      { text: 'CRM features', url: '/martial-arts-crm/' }
    ]
  },
  {
    question: "What reports does BeltManager include for MMA gyms?",
    answer: "An attendance report by class and by student with CSV export, a list of members who have missed their recent classes, and an insurance compliance report. Revenue reporting comes with card billing in April 2027.",
    links: [
      { text: 'Reporting features', url: '/martial-arts-software/' },
      { text: 'CRM analytics', url: '/martial-arts-crm/' }
    ]
  }
];
---

<BaseLayout
  title="MMA Gym Software (2026)"
  description="Run your MMA gym with a multi-discipline timetable, a belt ladder per discipline and flexible memberships. Free until 31 March 2027."
>
  <!-- Breadcrumbs -->
  <BreadcrumbsEnhanced
    site="beltmanager"
    items={[
      { label: 'Home', href: '/' },
      { label: 'MMA Gym Software', href: '/mma-gym-software/' }
    ]}
  />

  <!-- Hero Section -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block px-4 py-2 mb-4 text-sm font-semibold text-brand-red bg-brand-red-light rounded-full">Complete Guide</span>
        <h1 class="text-4xl md:text-5xl font-bold text-brand-navy mb-4">MMA Gym Software</h1>
        <p class="text-xl text-gray-600">
          Management software for mixed martial arts gyms. A multi-discipline timetable, progression in every art, registers on your phone and flexible membership options for MMA facilities.
        </p>
      </div>
    </div>
  </section>

  <!-- Featured Answer -->
  <FeaturedAnswer question="What is MMA gym software?">
    MMA gym software is a management platform for mixed martial arts facilities. It handles a timetable across several disciplines (BJJ, Muay Thai, wrestling, boxing, MMA), progression in each art, memberships, attendance and communication for gyms serving both recreational members and competitors.
  </FeaturedAnswer>

  <!-- Main Content -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto prose prose-lg">

        <h2>Management Solutions for Mixed Martial Arts Academies</h2>

        <p>
          Mixed martial arts gyms operate at the intersection of multiple combat disciplines: striking, wrestling, and submission grappling converge in training programs that prepare fighters for competition while serving recreational practitioners seeking comprehensive martial arts education.
        </p>

        <p>
          This dual mission—developing competitive athletes alongside recreational members—creates operational complexity that single-discipline schools rarely encounter. MMA gym software addresses these challenges with a timetable, progression tracking and memberships designed for multi-discipline environments.
        </p>

        <AppScreenshot src="/images/app/mma-timetable.webp" width={1600} height={1000} caption="The weekly timetable for one venue: Muay Thai, Wrestling, MMA, BJJ and karate classes with their expected regulars" />

        <h3>Multi-Discipline Training Structure</h3>

        <p>A typical MMA gym offers instruction across several combat disciplines:</p>

        <ul>
          <li><strong>Brazilian Jiu-Jitsu:</strong> Gi and no-gi sessions with belt progression</li>
          <li><strong>Muay Thai or Kickboxing:</strong> Striking fundamentals through advanced techniques</li>
          <li><strong>Wrestling or Grappling:</strong> Takedowns, control, and ground positioning</li>
          <li><strong>Boxing:</strong> Footwork, head movement, and punching combinations</li>
          <li><strong>MMA-Specific Classes:</strong> Integrated training combining all disciplines</li>
        </ul>

        <p>
          Each discipline may have its own progression system. BJJ follows belt ranks from white through black. Striking arts may use different advancement structures. Wrestling typically lacks formal ranking altogether. Software must accommodate these parallel systems while maintaining unified student records.
        </p>

        <h3>Recreational vs Competition Focus</h3>

        <p>MMA gyms serve two distinct populations with different needs:</p>

        <p>
          <strong>Recreational Members</strong> want fitness, self-defense skills, and community without competition aspirations. They attend regular classes, progress through curricula, and value the training experience itself.
        </p>

        <p>
          <strong>Competition Fighters</strong> train more often, often across several disciplines, and need their own sessions. Their membership patterns differ significantly from recreational members.
        </p>

        <p>
          In BeltManager, both sit in one student database. A competition team can be its own group with its own sessions and messages. BeltManager doesn't include fight records, sparring logs, weight-cut tracking or fight camp planning.
        </p>

      </div>
    </div>
  </section>

  <!-- Comparison Table -->
  <section class="section bg-gray-50">
    <div class="container-custom">
      <div class="max-w-5xl mx-auto">
        <ComparisonTable
          title="MMA Software vs Single-Discipline vs Manual Tracking"
          headers={['BeltManager (MMA-Specific)', 'BJJ-Only Software', 'Spreadsheets']}
          rows={comparisonData}
        />
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto prose prose-lg">

        <h2>Essential MMA Gym Software Features</h2>

        <h3>1. Multi-Discipline Class Management</h3>
        <ul>
          <li>Separate class groups by discipline (BJJ, striking, wrestling, MMA)</li>
          <li>Belt and age ranges per group</li>
          <li>One weekly timetable across every discipline, per venue</li>
          <li>Open mat and sparring sessions as regular groups</li>
          <li>Expected regulars shown on every class</li>
          <li>Instructor-to-student ratio warnings</li>
        </ul>

        <AppScreenshot src="/images/app/mma-memberships.webp" width={1600} height={1000} caption="Memberships: an all-access plan covering every adult discipline alongside single-discipline plans" />

        <h3>2. Competitors</h3>
        <ul>
          <li>Competition team as its own class group</li>
          <li>Competition results recorded as achievements and patches</li>
          <li>Tournaments and seminars listed as events</li>
          <li>Per-student notes after each session</li>
          <li>Technique lists with video links</li>
        </ul>

        <h3>3. Multiple Progression Systems</h3>
        <ul>
          <li>BJJ belt progression (white, blue, purple, brown, black)</li>
          <li>Stripe tracking for interim BJJ achievements</li>
          <li>Striking grades (for example beginner, intermediate, advanced)</li>
          <li>Kids program ranks across disciplines</li>
          <li>Ready-to-grade list from attendance and time at grade</li>
          <li>Custom progression tracks per discipline</li>
        </ul>

        <h3>4. Membership Flexibility</h3>
        <ul>
          <li>All-access memberships covering every discipline</li>
          <li>Single-discipline memberships (BJJ only, striking only)</li>
          <li>Competition team memberships</li>
          <li>Family memberships with sibling discounts</li>
          <li>Membership freezes for injuries</li>
          <li>Card billing from April 2027; record payments by hand until then</li>
        </ul>

        <h2>Operational Considerations</h2>

        <h3>Check-In and Attendance</h3>
        <p>MMA facilities need flexible check-in accommodating various training patterns:</p>
        <ul>
          <li>A register for every session, so members training twice a day are counted twice</li>
          <li>Walk-ins added to the register on the spot</li>
          <li>Tablet kiosk mode with a PIN</li>
          <li>Trial class tracking for prospects</li>
        </ul>

        <h3>Communication Segmentation</h3>
        <p>Different member segments need targeted communications:</p>
        <ul>
          <li>Messages to the competition team group only</li>
          <li>Automatic notices when a class is cancelled, moved or closed</li>
          <li>Discipline-specific news (BJJ seminars, striking workshops) sent to those classes</li>
          <li>Whole-gym announcements by email and app push</li>
        </ul>

        <h2>Related Resources</h2>

        <ul>
          <li><a href="/martial-arts-software/">Martial Arts Software Overview</a> — Complete platform comparison</li>
          <li><a href="/bjj-gym-software/">BJJ Gym Software</a> — BJJ-specific features</li>
          <li><a href="/blog/types-of-martial-arts/">Types of Martial Arts</a> — Compare different disciplines</li>
          <li><a href="/martial-arts-crm/">Martial Arts CRM</a> — Lead and member management</li>
          <li><a href="/blog/best-martial-arts-software/">Best Martial Arts Software</a> — Detailed comparisons</li>
        </ul>

      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <FAQEnhanced
    site="beltmanager"
    pageUrl="https://beltmanager.com/mma-gym-software/"
    title="Frequently Asked Questions About MMA Gym Software"
    faqs={faqItems}
  />

  <!-- CTA Section -->
  <section class="section bg-brand-red text-white">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-bold mb-4">Ready to Streamline Your MMA Gym?</h2>
        <p class="text-xl mb-8 opacity-95">
          One timetable across every discipline, a belt ladder for each and flexible membership options. Free until 31 March 2027.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={appLink(Astro.url.pathname, 'bottom')} class="btn-primary-large bg-white text-brand-red hover:bg-gray-100">Get started free</a>
          <a href="/pricing/" class="btn-secondary-large border-white text-white hover:bg-white hover:bg-opacity-10">View Pricing</a>
        </div>
        <p class="mt-6 text-sm opacity-90">Free until 31 March 2027 • No credit card • No contract</p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .section {
    padding: 4rem 0;
  }

  .prose {
    max-width: none;
  }

  .prose h2 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--brand-navy);
    margin-top: 3rem;
    margin-bottom: 1.5rem;
  }

  .prose h3 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--brand-navy);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose p {
    margin-bottom: 1.5rem;
    color: #475569;
    line-height: 1.7;
  }

  .prose ul {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
    color: #475569;
  }

  .prose strong {
    color: var(--brand-navy);
    font-weight: 600;
  }

  .prose a {
    color: var(--brand-red);
    text-decoration: none;
  }

  .prose a:hover {
    text-decoration: underline;
  }

  .btn-primary-large,
  .btn-secondary-large {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    border-radius: 8px;
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-primary-large:hover,
  .btn-secondary-large:hover {
    transform: translateY(-2px);
  }

  .btn-secondary-large {
    border: 2px solid;
  }

  @media (max-width: 768px) {
    .section {
      padding: 3rem 0;
    }

    .prose h2 {
      font-size: 1.5rem;
    }

    .prose h3 {
      font-size: 1.25rem;
    }
  }
</style>
