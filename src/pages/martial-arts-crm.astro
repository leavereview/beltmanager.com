---
import { appLink } from '../utils/appLink';
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbsEnhanced from '../components/seo/BreadcrumbsEnhanced.astro';
import FeaturedAnswer from '../components/seo/FeaturedAnswer.astro';
import ComparisonTable from '../components/seo/ComparisonTable.astro';
import FAQEnhanced from '../components/seo/FAQEnhanced.astro';

const comparisonData = [
  {
    label: 'Online Join Form into Your Leads',
    values: [true, 'Add-on', false],
    highlight: true
  },
  {
    label: 'Trial Class Workflow',
    values: [true, false, false],
    highlight: true
  },
  {
    label: 'At-Risk Student List from Attendance',
    values: [true, false, false],
    highlight: true
  },
  {
    label: 'Message a Family, a Class or the Whole School',
    values: [true, true, 'Manual']
  },
  {
    label: 'Lead Source Recorded',
    values: [true, true, false]
  },
  {
    label: 'Follow-Up Dates & Contact Log',
    values: [true, true, false]
  },
  {
    label: 'Convert an Enquiry into a Student',
    values: [true, false, false]
  },
  {
    label: 'Family Relationship Tracking',
    values: [true, false, false]
  },
  {
    label: 'Belt & Attendance History per Student',
    values: [true, false, false]
  }
];

const faqItems = [
  {
    question: "What is a martial arts CRM?",
    answer: "A martial arts CRM (Customer Relationship Management) system tracks prospects and students through their journey: enquiry, trial class, joining and years of training. Unlike a generic sales CRM, it understands trial classes, families with several children training, belt progression and attendance.",
    links: [
      { text: 'CRM features', url: '/martial-arts-software/' },
      { text: 'See pricing', url: '/pricing/' }
    ]
  },
  {
    question: "How does BeltManager help convert enquiries into students?",
    answer: "Enquiries from your online join form, or added by hand after a phone call, land in Leads. Each one moves through New, Contacted, Trial booked, Attended and then Converted or Lost, with a cold, warm or hot rating, a follow-up date and a log of every contact. Converting an enquiry creates the student record. BeltManager doesn't send automatic follow-up emails to enquirers yet, so the follow-up itself is yours.",
    links: [
      { text: 'Lead management', url: '/martial-arts-software/' },
      { text: 'Marketing guide', url: '/blog/martial-arts-marketing-tips/' }
    ]
  },
  {
    question: "What's the difference between martial arts CRM and general CRM?",
    answer: "Martial arts CRM understands trial classes, belt progression, family accounts, multi-year student relationships and attendance. General CRMs like Salesforce track deals and one-time sales.",
    links: [
      { text: 'Martial arts features', url: '/martial-arts-software/' },
      { text: 'Compare software', url: '/blog/best-martial-arts-software/' }
    ]
  },
  {
    question: "Can BeltManager identify students at risk of quitting?",
    answer: "Yes. The Retention screen lists members who have missed the last few classes their group held (three by default, and you can change it). A second list shows members who have left and the date they last trained, so you can get in touch before they are gone for good.",
    links: [
      { text: 'Retention features', url: '/martial-arts-software/' },
      { text: 'Retention strategies', url: '/blog/member-retention-strategies/' }
    ]
  },
  {
    question: "Can I message families from BeltManager?",
    answer: "Yes. Send a message to one family, one or more classes, or the whole school. Families get it by email, and as a push notification if they use the free parent app, and you can see each family's delivery status. BeltManager doesn't send text messages (SMS).",
    links: [
      { text: 'All features', url: '/martial-arts-software/' }
    ]
  },
  {
    question: "How much does martial arts CRM cost?",
    answer: "Martial arts CRM is usually included in martial arts management software rather than sold separately. BeltManager includes its leads and retention tools and is free until 31 March 2027.",
    links: [
      { text: 'View pricing', url: '/pricing/' },
      { text: 'Feature comparison', url: '/martial-arts-software/' }
    ]
  },
  {
    question: "Does BeltManager track lead sources?",
    answer: "Each enquiry records where it came from. There isn't a marketing ROI report yet.",
    links: [
      { text: 'Marketing guide', url: '/blog/martial-arts-marketing-tips/' }
    ]
  },
  {
    question: "How long does setup take?",
    answer: "Leads and retention work as soon as your school is set up: add your classes and students, and share your join form link on your website or social media.",
    links: [
      { text: 'Get started free', url: appLink(Astro.url.pathname, 'faq') }
    ]
  }
];
---

<BaseLayout
  title="CRM for Martial Arts Schools: Leads & Retention"
  description="Free until 31 March 2027. Track enquiries from first contact to trial and joining, and spot at-risk students before they quit. Built for martial arts schools."
>
  <!-- Breadcrumbs -->
  <BreadcrumbsEnhanced
    site="beltmanager"
    items={[
      { label: 'Home', href: '/' },
      { label: 'Martial Arts CRM', href: '/martial-arts-crm/' }
    ]}
  />

  <!-- Hero Section -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block px-4 py-2 mb-4 text-sm font-semibold text-brand-red bg-brand-red-light rounded-full">Complete Guide</span>
        <h1 class="text-4xl md:text-5xl font-bold text-brand-navy mb-4">Martial Arts CRM</h1>
        <p class="text-xl text-gray-600">
          Lead management and student retention tools for martial arts schools. Track every enquiry to a trial and a new student, and spot members drifting away before they quit.
        </p>
      </div>
    </div>
  </section>

  <!-- Featured Answer -->
  <FeaturedAnswer question="What is a martial arts CRM?">
    A martial arts CRM (Customer Relationship Management) system tracks prospects and students through their journey: enquiry, trial class, joining and ongoing training. It manages trial classes, records follow-ups, identifies students at risk of leaving and understands belt progression and family relationships, unlike a generic sales CRM.
  </FeaturedAnswer>

  <!-- Main Content -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto prose prose-lg">

        <h2>Lead Management and Student Relationship Tools</h2>

        <p>
          Every martial arts school faces the same fundamental challenge: converting interested prospects into enrolled students, then nurturing those students into long-term members. A martial arts CRM system provides the infrastructure to manage both sides of this equation systematically.
        </p>

        <p>
          Unlike generic CRM platforms designed for sales teams or retail businesses, martial arts CRM functionality addresses the specific journey from initial inquiry through trial class, enrollment, and ongoing retention. These tools recognize that a martial arts student relationship spans years rather than single transactions.
        </p>

        <aside class="not-prose my-8 rounded-lg border border-gray-200 bg-gray-50 p-6">
          <p class="font-semibold text-brand-navy mb-2">How BeltManager handles enquiries</p>
          <p class="text-gray-700">Enquiries from your school's online join form, or added by hand after a phone call, land in Leads. Each one moves through New, Contacted, Trial booked, Attended and then Converted or Lost, with a separate cold, warm or hot rating, a follow-up date and a log of every contact. Converting an enquiry creates the student record, so nothing is typed twice.</p>
        </aside>

        <h3>CRM Functions in Martial Arts</h3>

        <p><strong>Lead Management:</strong></p>
        <p>
          Handles the pre-enrollment phase—capturing inquiries, nurturing prospects, scheduling trials, and converting interested parties into paying students. This front-end function directly impacts school growth.
        </p>

        <p><strong>Student Relationship Management:</strong></p>
        <p>
          Addresses the post-enrollment phase—tracking engagement, identifying retention risks, managing communications, and building the long-term relationships that create lifetime students.
        </p>

        <p>
          Effective martial arts CRM integrates both functions, creating continuity from first contact through years of training.
        </p>

      </div>
    </div>
  </section>

  <!-- Comparison Table -->
  <section class="section bg-gray-50">
    <div class="container-custom">
      <div class="max-w-5xl mx-auto">
        <ComparisonTable
          title="Martial Arts CRM vs Generic CRM vs Manual Tracking"
          headers={['BeltManager (Martial Arts CRM)', 'Generic CRM', 'Spreadsheets/Email']}
          rows={comparisonData}
        />
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto prose prose-lg">

        <h2>CRM Features in BeltManager</h2>

        <h3>1. Lead Management</h3>
        <ul>
          <li>Online join form for your website and social media</li>
          <li>Add phone and walk-in enquiries by hand</li>
          <li>Pipeline stages: New, Contacted, Trial booked, Attended, Converted or Lost</li>
          <li>Cold, warm or hot rating and a follow-up date on every enquiry</li>
          <li>A log of every contact</li>
          <li>Where each enquiry came from</li>
        </ul>

        <h3>2. Trial Classes</h3>
        <ul>
          <li>Families can pick a trial class on the join form</li>
          <li>Record whether the trial was attended</li>
          <li>Convert an enquiry into a student without retyping anything</li>
        </ul>

        <aside class="not-prose my-8 rounded-lg border border-gray-200 bg-gray-50 p-6">
          <p class="font-semibold text-brand-navy mb-2">How BeltManager spots students drifting away</p>
          <p class="text-gray-700">The Retention screen lists members at risk: anyone who has missed the last few classes their group held (three by default, and you can change it) or whose family has stopped paying. A second list shows members who have left and the date they last trained, so you can have the conversation before they are gone for good.</p>
        </aside>

        <h3>3. Student Engagement</h3>
        <ul>
          <li>At-risk list built from attendance</li>
          <li>Leavers list with the date each person last trained</li>
          <li>Attendance report by class and student, with CSV export</li>
          <li>Belt history, achievements and grading readiness per student</li>
        </ul>

        <h3>4. Communication</h3>
        <ul>
          <li>Message one family, one or more classes, or the whole school</li>
          <li>Email, plus push notifications in the free parent app</li>
          <li>Delivery status for each family</li>
          <li>Messages logged on the student and household pages</li>
        </ul>

        <h3>Not Available Yet</h3>
        <ul>
          <li>Automatic replies and follow-up emails to enquirers</li>
          <li>Text messages (SMS)</li>
          <li>Lead-source and marketing ROI reports</li>
        </ul>

        <h2>Related Resources</h2>

        <ul>
          <li><a href="/martial-arts-software/">Martial Arts Software Overview</a> — Complete platform features</li>
          <li><a href="/blog/martial-arts-marketing-tips/">Marketing Tips</a> — Lead generation strategies</li>
          <li><a href="/blog/member-retention-strategies/">Retention Strategies</a> — Keep students training longer</li>
          <li><a href="/blog/lead-generation-mma-gyms/">Lead Generation Guide</a> — MMA gym marketing</li>
          <li><a href="/martial-arts-billing-software/">Billing Software</a> — Payment processing integration</li>
        </ul>

      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <FAQEnhanced
    site="beltmanager"
    pageUrl="https://beltmanager.com/martial-arts-crm/"
    title="Frequently Asked Questions About Martial Arts CRM"
    faqs={faqItems}
  />

  <!-- CTA Section -->
  <section class="section bg-brand-red text-white">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-bold mb-4">Ready to Improve Your Lead Conversion?</h2>
        <p class="text-xl mb-8 opacity-95">
          Track every enquiry from first contact to new student, and see who is drifting away before they leave.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={appLink(Astro.url.pathname, 'bottom')} class="btn-primary-large bg-white text-brand-red hover:bg-gray-100">Get started free</a>
          <a href="/pricing/" class="btn-secondary-large border-white text-white hover:bg-white hover:bg-opacity-10">View Pricing</a>
        </div>
        <p class="mt-6 text-sm opacity-90">Free until 31 March 2027 • No credit card • No contract</p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .section {
    padding: 4rem 0;
  }

  .prose {
    max-width: none;
  }

  .prose h2 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--brand-navy);
    margin-top: 3rem;
    margin-bottom: 1.5rem;
  }

  .prose h3 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--brand-navy);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose p {
    margin-bottom: 1.5rem;
    color: #475569;
    line-height: 1.7;
  }

  .prose ul {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
    color: #475569;
  }

  .prose strong {
    color: var(--brand-navy);
    font-weight: 600;
  }

  .prose a {
    color: var(--brand-red);
    text-decoration: none;
  }

  .prose a:hover {
    text-decoration: underline;
  }

  .btn-primary-large,
  .btn-secondary-large {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    border-radius: 8px;
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-primary-large:hover,
  .btn-secondary-large:hover {
    transform: translateY(-2px);
  }

  .btn-secondary-large {
    border: 2px solid;
  }

  @media (max-width: 768px) {
    .section {
      padding: 3rem 0;
    }

    .prose h2 {
      font-size: 1.5rem;
    }

    .prose h3 {
      font-size: 1.25rem;
    }
  }
</style>
