---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbsEnhanced from '../components/seo/BreadcrumbsEnhanced.astro';
import FeaturedAnswer from '../components/seo/FeaturedAnswer.astro';
import ComparisonTable from '../components/seo/ComparisonTable.astro';
import FAQEnhanced from '../components/seo/FAQEnhanced.astro';

const comparisonData = [
  {
    label: 'Online join form for your website',
    values: [true, 'Varies', false],
    highlight: true
  },
  {
    label: 'Trial class stages (booked, attended)',
    values: [true, false, false],
    highlight: true
  },
  {
    label: 'At-risk and inactive student lists',
    values: [true, false, false],
    highlight: true
  },
  {
    label: 'Follow-up dates with an overdue reminder to you',
    values: [true, true, false]
  },
  {
    label: 'Contact log per enquiry',
    values: [true, true, 'Email threads']
  },
  {
    label: 'Convert an enquiry into a student record',
    values: [true, false, 'Retype it']
  },
  {
    label: 'Family and guardian records',
    values: [true, false, false]
  }
];

const faqItems = [
  {
    question: "What is a martial arts CRM?",
    answer: "A martial arts CRM (customer relationship management) system tracks prospects and students through their whole journey, from first enquiry through trial class, joining, and years of training. Unlike a generic sales CRM, it understands trial classes, families and belt progression. In BeltManager, that means a Leads list for enquiries and a Retention screen for students who are drifting away.",
    links: [
      { text: 'All features', url: '/martial-arts-software/' },
      { text: 'See pricing', url: '/pricing/' }
    ]
  },
  {
    question: "How does BeltManager help convert enquiries into students?",
    answer: "Every enquiry, whether it comes from your online join form or a phone call you log by hand, lands in one Leads list. Each moves through New, Contacted, Trial booked, Attended, and then Converted or Lost. Set a follow-up date and BeltManager reminds you when it's overdue. Converting an enquiry creates the student record, so nothing is typed twice. BeltManager doesn't send automated messages to enquirers; the follow-up is yours.",
    links: [
      { text: 'All features', url: '/martial-arts-software/' },
      { text: 'Marketing guide', url: '/blog/martial-arts-marketing-tips/' }
    ]
  },
  {
    question: "What's the difference between a martial arts CRM and a general CRM?",
    answer: "A martial arts CRM understands trial classes, families with several children, belt progression and attendance. General CRMs track deals and one-off sales. A martial arts student relationship lasts years, so the CRM has to sit alongside your registers and belt records.",
    links: [
      { text: 'Martial arts features', url: '/martial-arts-software/' },
      { text: 'Compare software', url: '/blog/best-martial-arts-software/' }
    ]
  },
  {
    question: "Can BeltManager spot students at risk of quitting?",
    answer: "Yes. The Retention screen lists members who have missed the last few classes their group held (three by default, and you can change it) or whose family has overdue invoices. A second list shows members who have left and the date they last trained.",
    links: [
      { text: 'All features', url: '/martial-arts-software/' },
      { text: 'Retention strategies', url: '/blog/member-retention-strategies/' }
    ]
  },
  {
    question: "Does BeltManager send automated follow-up messages?",
    answer: "Not to enquirers. You set a follow-up date on each enquiry, and BeltManager reminds you when one is overdue. Sending the message, and making it personal, is up to you.",
    links: [
      { text: 'All features', url: '/martial-arts-software/' }
    ]
  },
  {
    question: "How much does a martial arts CRM cost?",
    answer: "A CRM is usually included in martial arts management software rather than sold separately, though some platforms keep it for their higher tiers. BeltManager includes Leads and the Retention screen, and is free until 31 March 2027.",
    links: [
      { text: 'View pricing', url: '/pricing/' },
      { text: 'Feature comparison', url: '/martial-arts-software/' }
    ]
  }
];
---

<BaseLayout
  title="CRM for Martial Arts Schools: Leads & Retention"
  description="Free until 31 March 2027. Capture enquiries with an online join form, track trial classes, and spot at-risk students before they quit. Built for martial arts schools."
>
  <!-- Breadcrumbs -->
  <BreadcrumbsEnhanced
    site="beltmanager"
    items={[
      { label: 'Home', href: '/' },
      { label: 'Martial Arts CRM', href: '/martial-arts-crm/' }
    ]}
  />

  <!-- Hero Section -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block px-4 py-2 mb-4 text-sm font-semibold text-brand-red bg-brand-red-light rounded-full">Complete Guide</span>
        <h1 class="text-4xl md:text-5xl font-bold text-brand-navy mb-4">Martial Arts CRM</h1>
        <p class="text-xl text-gray-600">
          Lead management and student retention for martial arts schools. Capture enquiries, track trial classes, and spot students who are drifting away.
        </p>
      </div>
    </div>
  </section>

  <!-- Featured Answer -->
  <FeaturedAnswer question="What is a martial arts CRM?">
    A martial arts CRM (customer relationship management) system tracks prospects and students through their whole journey, from first enquiry through trial class, joining and ongoing training. Unlike generic sales CRMs, it understands trial classes, families and belt progression, and it helps you spot students at risk of leaving.
  </FeaturedAnswer>

  <!-- Main Content -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto prose prose-lg">

        <h2>Lead Management and Student Relationship Tools</h2>

        <p>
          Every martial arts school faces the same two jobs: turning interested enquiries into students, then keeping those students training for years. A martial arts CRM helps with both.
        </p>

        <p>
          Unlike generic CRM platforms designed for sales teams or retail businesses, a martial arts CRM follows the journey from first enquiry through trial class, joining, and ongoing training. A martial arts student relationship lasts years, not a single sale.
        </p>

        <aside class="not-prose my-8 rounded-lg border border-gray-200 bg-gray-50 p-6">
          <p class="font-semibold text-brand-navy mb-2">How BeltManager handles enquiries</p>
          <p class="text-gray-700">Enquiries from your school's online join form, or added by hand after a phone call, land in Leads. Each one moves through New, Contacted, Trial booked, Attended and then Converted or Lost, with a separate cold, warm or hot rating, a follow-up date and a log of every contact. Converting an enquiry creates the student record, so nothing is typed twice.</p>
        </aside>

        <h3>CRM Functions in Martial Arts</h3>

        <p><strong>Lead management:</strong></p>
        <p>
          The time before someone joins: capturing enquiries, following up, booking a trial class, and turning interest into a new student.
        </p>

        <p><strong>Student relationship management:</strong></p>
        <p>
          The time after they join: watching attendance, spotting students who are drifting away, and keeping families informed.
        </p>

      </div>
    </div>
  </section>

  <!-- Comparison Table -->
  <section class="section bg-gray-50">
    <div class="container-custom">
      <div class="max-w-5xl mx-auto">
        <ComparisonTable
          title="Martial Arts CRM vs Generic CRM vs Manual Tracking"
          headers={['BeltManager (Martial Arts CRM)', 'Generic CRM', 'Spreadsheets/Email']}
          rows={comparisonData}
        />
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto prose prose-lg">

        <h2>What BeltManager's CRM Does</h2>

        <h3>1. Leads</h3>
        <ul>
          <li>An online join form for your website</li>
          <li>Add enquiries by hand after a phone call or visit</li>
          <li>Stages from New through Trial booked and Attended to Converted or Lost</li>
          <li>A cold, warm or hot rating on each enquiry</li>
          <li>Follow-up dates, with a reminder to you when one is overdue</li>
          <li>A log of every contact</li>
        </ul>

        <h3>2. Trial Classes</h3>
        <ul>
          <li>Mark a trial as booked, then attended</li>
          <li>Convert to a student in a few clicks, carrying the details across</li>
          <li>Photo consent captured on the join form</li>
        </ul>

        <aside class="not-prose my-8 rounded-lg border border-gray-200 bg-gray-50 p-6">
          <p class="font-semibold text-brand-navy mb-2">How BeltManager spots students drifting away</p>
          <p class="text-gray-700">The Retention screen lists members at risk: anyone who has missed the last few classes their group held (three by default, and you can change it) or whose family has overdue invoices. A second list shows members who have left and the date they last trained, so you can have the conversation before they are gone for good.</p>
        </aside>

        <h3>3. Keeping Students Engaged</h3>
        <ul>
          <li>At-risk and inactive student lists</li>
          <li>Attendance report by class and student, with CSV export</li>
          <li>Belt progress and grading readiness on every student record</li>
          <li>Achievements and belt promotions, with a notice to the family</li>
        </ul>

        <h3>4. Keeping Families Informed</h3>
        <ul>
          <li>Class reminders and RSVP requests by email and app push</li>
          <li>Automatic notices when a class is cancelled, moved or closed</li>
          <li>A free parent app and web portal</li>
        </ul>

        <h3>What It Doesn't Do (Yet)</h3>
        <p>
          BeltManager doesn't send automated follow-up messages to enquirers, and there's no bulk or segmented messaging, SMS, or marketing ROI report today.
        </p>

        <h2>Related Resources</h2>

        <ul>
          <li><a href="/martial-arts-software/">Martial Arts Software Overview</a> — Complete platform features</li>
          <li><a href="/blog/martial-arts-marketing-tips/">Marketing Tips</a> — Lead generation strategies</li>
          <li><a href="/blog/member-retention-strategies/">Retention Strategies</a> — Keep students training longer</li>
          <li><a href="/blog/lead-generation-mma-gyms/">Lead Generation Guide</a> — MMA gym marketing</li>
          <li><a href="/martial-arts-billing-software/">Billing Software</a> — Memberships today, card billing from April 2027</li>
        </ul>

      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <FAQEnhanced
    site="beltmanager"
    pageUrl="https://beltmanager.com/martial-arts-crm/"
    title="Frequently Asked Questions About Martial Arts CRM"
    faqs={faqItems}
  />

  <!-- CTA Section -->
  <section class="section bg-brand-red text-white">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-bold mb-4">Ready to Keep Track of Every Enquiry?</h2>
        <p class="text-xl mb-8 opacity-95">
          Capture enquiries with your online join form, track trial classes, and spot students who are drifting away.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="https://app.beltmanager.com/signin" class="btn-primary-large bg-white text-brand-red hover:bg-gray-100">Get started free</a>
          <a href="/pricing/" class="btn-secondary-large border-white text-white hover:bg-white hover:bg-opacity-10">View Pricing</a>
        </div>
        <p class="mt-6 text-sm opacity-90">Free until 31 March 2027 • No credit card • No contract</p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .section {
    padding: 4rem 0;
  }

  .prose {
    max-width: none;
  }

  .prose h2 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--brand-navy);
    margin-top: 3rem;
    margin-bottom: 1.5rem;
  }

  .prose h3 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--brand-navy);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose p {
    margin-bottom: 1.5rem;
    color: #475569;
    line-height: 1.7;
  }

  .prose ul {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
    color: #475569;
  }

  .prose strong {
    color: var(--brand-navy);
    font-weight: 600;
  }

  .prose a {
    color: var(--brand-red);
    text-decoration: none;
  }

  .prose a:hover {
    text-decoration: underline;
  }

  .btn-primary-large,
  .btn-secondary-large {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    border-radius: 8px;
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-primary-large:hover,
  .btn-secondary-large:hover {
    transform: translateY(-2px);
  }

  .btn-secondary-large {
    border: 2px solid;
  }

  @media (max-width: 768px) {
    .section {
      padding: 3rem 0;
    }

    .prose h2 {
      font-size: 1.5rem;
    }

    .prose h3 {
      font-size: 1.25rem;
    }
  }
</style>
