---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbsEnhanced from '../../components/seo/BreadcrumbsEnhanced.astro';
import FeaturedAnswer from '../../components/seo/FeaturedAnswer.astro';
import FAQEnhanced from '../../components/seo/FAQEnhanced.astro';

// All competitor pricing below is taken from the vendor's own public pricing page.
// Kicksite re-verified against kicksite.com/pricing in August 2026; the remainder
// verified July 2026 as part of the martial arts software roundup. Currencies are
// as each vendor lists them — most price in USD, which matters for UK schools.
const platforms = [
  {
    name: 'Kicksite',
    href: '/compare/kicksite/',
    positioning: 'Martial-arts-specific, priced by active student count',
    price: '$49/mo (0–25 students), rising to $199/mo (101+)',
    trial: '30 days, via a booked demo',
    bestFor: 'Small schools that want purpose-built rank tracking and predictable per-student tiers.',
    gap: 'Cost steps up sharply as you grow; every tier requires a demo call to start.',
  },
  {
    name: 'Zen Planner',
    href: '/compare/zen-planner/',
    positioning: 'The established all-in-one for gyms and martial arts schools',
    price: '$99/mo (Studio) up to $348/mo (Ultimate)',
    trial: 'None listed',
    bestFor: 'Larger schools wanting a mature, broad platform with a long track record.',
    gap: 'Most expensive option here, no listed free trial, and cancellation terms worth confirming first.',
  },
];

const faqItems = [
  {
    question: 'What is the best martial arts school management software?',
    answer:
      'There is no universal answer — it turns on your school size and whether you need belt progression as a first-class concept or just a gym CRM. Kicksite is the cheapest purpose-built option at $49/month for up to 25 students. Zen Planner is the most established but starts at $99/month and reaches $348/month. Gymdesk sits between at $75/month for up to 50 members. BeltManager is free until 31 March 2027 during early access and treats rank progression as core rather than a custom field. Pricing verified against vendor sites, July–August 2026.',
    links: [{ text: 'Full software roundup', url: '/blog/best-martial-arts-software/' }],
  },
  {
    question: 'How much does martial arts software cost per month?',
    answer:
      'Published 2026 entry prices run from $49/month (Kicksite, up to 25 students) to $249/month (Spark Membership, flat rate). Most purpose-built platforms sit between $69 and $99/month for a school of about 50 students. Note that almost all of them price in US dollars, so UK schools should factor in the exchange rate and any card fees. Clubworx has a genuinely free tier for up to 20 active members, and BeltManager is free until 31 March 2027.',
    links: [{ text: 'BeltManager pricing', url: '/pricing/' }],
  },
  {
    question: 'Do I need martial-arts-specific software, or will gym software do?',
    answer:
      'The dividing line is belt progression. Purpose-built platforms treat rank, grading eligibility and testing cycles as core objects; general gym software usually treats a belt as a custom field you maintain by hand. If you grade students, that difference shows up every testing cycle. If you run classes with no ranking system, general gym software will serve you perfectly well and is often cheaper.',
    links: [{ text: 'Gym software vs dojo software', url: '/blog/gym-management-software-comparison/' }],
  },
  {
    question: 'Why should I trust a comparison written by a competitor?',
    answer:
      'Read it sceptically — we sell one of the products. What we offer instead of neutrality is verifiability: every competitor price on these pages comes from that vendor\'s own published pricing page and is dated, and we state plainly where a competitor is more established or better suited than we are. Where a vendor does not publish something, we say so rather than filling the gap. Check the figures yourself against the vendor sites.',
    links: [],
  },
];

const schemaMarkup = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Martial Arts Software Comparisons',
  description:
    'Honest side-by-side comparisons of martial arts school management software: BeltManager vs Kicksite, Zen Planner and others. Vendor-verified pricing.',
  url: 'https://beltmanager.com/compare/',
  publisher: { '@type': 'Organization', name: 'BeltManager' },
};
---

<BaseLayout
  title="Compare Martial Arts School Software"
  description="Honest side-by-side comparisons of martial arts management software. Vendor-verified pricing for Kicksite, Zen Planner and BeltManager."
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaMarkup)} />

  <BreadcrumbsEnhanced
    site="beltmanager"
    items={[
      { label: 'Home', href: '/' },
      { label: 'Compare', href: '/compare/' },
    ]}
  />

  <section class="relative overflow-hidden bg-gradient-to-br from-brand-navy to-gray-900 text-white py-16">
    <div class="container-custom relative">
      <div class="max-w-3xl">
        <span class="inline-block bg-brand-red/20 text-brand-red-light px-3 py-1 rounded-full text-sm mb-4">Platform Comparisons</span>
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Compare Martial Arts School Software</h1>
        <p class="text-xl text-gray-300 mb-8">
          Side-by-side against the platforms dojo owners actually shortlist. Every competitor price comes from that vendor's own pricing page — and we say where they beat us.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="https://app.beltmanager.com/signin" class="btn-primary text-lg px-8 py-4">Try BeltManager Free</a>
          <a href="/blog/best-martial-arts-software/" class="btn-secondary text-lg px-8 py-4">Read the Full Roundup</a>
        </div>
      </div>
    </div>
  </section>

  <FeaturedAnswer question="Which martial arts software should a school owner choose?">
    For a school under 25 students, Kicksite is the cheapest purpose-built option at $49/month, though every tier starts with a demo call. For a larger, established school wanting a mature platform, Zen Planner is the safe choice at $99/month rising to $348/month for its Ultimate tier, with no free trial listed. BeltManager is free until 31 March 2027 during early access, with belt progression built in as a core concept rather than a custom field. The decision usually comes down to whether you grade students and how fast you expect to grow. Verified against vendor pricing pages, July–August 2026.
  </FeaturedAnswer>

  <section class="section bg-white">
    <div class="container-custom max-w-5xl">
      <h2 class="text-3xl font-bold text-brand-navy mb-3">Head-to-head comparisons</h2>
      <p class="text-gray-600 mb-10">Each page covers features, published pricing, where the competitor genuinely wins, and who we think we suit better.</p>

      <div class="grid md:grid-cols-2 gap-6">
        {platforms.map((p) => (
          <a href={p.href} class="card p-6 hover:shadow-lg transition-shadow group block">
            <h3 class="font-bold text-brand-navy text-xl mb-1 group-hover:text-brand-red transition-colors">
              BeltManager vs {p.name}
            </h3>
            <p class="text-gray-500 text-sm mb-4">{p.positioning}</p>
            <dl class="text-sm space-y-2 mb-4">
              <div class="flex gap-2">
                <dt class="font-semibold text-gray-700 w-24 flex-shrink-0">Price</dt>
                <dd class="text-gray-600">{p.price}</dd>
              </div>
              <div class="flex gap-2">
                <dt class="font-semibold text-gray-700 w-24 flex-shrink-0">Trial</dt>
                <dd class="text-gray-600">{p.trial}</dd>
              </div>
              <div class="flex gap-2">
                <dt class="font-semibold text-gray-700 w-24 flex-shrink-0">Best for</dt>
                <dd class="text-gray-600">{p.bestFor}</dd>
              </div>
              <div class="flex gap-2">
                <dt class="font-semibold text-gray-700 w-24 flex-shrink-0">Gaps</dt>
                <dd class="text-gray-600">{p.gap}</dd>
              </div>
            </dl>
            <span class="text-brand-red font-semibold text-sm">Read the comparison &rarr;</span>
          </a>
        ))}
      </div>

      <p class="text-gray-500 text-sm mt-8">
        Want the wider field including Martialytics, Gymdesk, Clubworx and Spark Membership? The
        <a href="/blog/best-martial-arts-software/" class="text-brand-red hover:underline"> full martial arts software roundup</a> compares six named platforms on published 2026 pricing, and
        <a href="/free-martial-arts-software/" class="text-brand-red hover:underline">free martial arts software</a> covers what the no-cost tiers actually include.
      </p>
    </div>
  </section>

  <section class="section bg-gray-50">
    <div class="container-custom max-w-4xl">
      <h2 class="text-2xl font-bold text-brand-navy mb-6">What actually separates these platforms</h2>
      <div class="space-y-5 text-gray-700">
        <p>
          Every platform here will take a booking, run a class register and charge a card. Those are table stakes. Three things genuinely differ, and they are the ones worth deciding on.
        </p>
        <p>
          <strong>Whether belt progression is a real concept.</strong> Purpose-built tools model rank, stripes, grading eligibility and testing cycles directly. General gym software makes a belt a custom text field you maintain yourself — which works until your first grading with sixty students. See
          <a href="/martial-arts-software/" class="text-brand-red hover:underline">martial arts management software</a> for what that looks like in practice.
        </p>
        <p>
          <strong>How pricing scales.</strong> Student-count tiers such as Kicksite's look cheap at 20 students and rather less so at 101. Flat-rate tiers cost more on day one and stop mattering as you grow. Model your expected size in eighteen months, not today.
        </p>
        <p>
          <strong>Currency and cancellation.</strong> Almost all of these platforms price in US dollars, which is a real cost for a UK school. And cancellation terms vary far more than the marketing pages suggest — confirm them in writing before you migrate student data, whichever platform you pick. Our
          <a href="/martial-arts-billing-software/" class="text-brand-red hover:underline">billing guide</a> covers what to check on payment terms.
        </p>
      </div>
    </div>
  </section>

  <section class="section bg-brand-navy text-white text-center">
    <div class="container-custom">
      <h2 class="text-3xl font-bold mb-3">Try BeltManager — Free Until 31 March 2027</h2>
      <p class="text-white/80 text-lg mb-8 max-w-xl mx-auto">No subscription, no per-student fees, no demo call required. Set your school up and run a real week of classes before deciding.</p>
      <a href="https://app.beltmanager.com/signin" class="inline-block bg-brand-red text-white px-10 py-4 rounded-xl font-semibold text-lg hover:bg-red-700 transition-colors">
        Get started free &rarr;
      </a>
      <p class="text-white/50 text-sm mt-3">Free until 31 March 2027 &middot; No card required</p>
    </div>
  </section>

  <FAQEnhanced
    faqs={faqItems}
    title="Choosing Martial Arts Software — Common Questions"
    site="beltmanager"
    pageUrl="https://beltmanager.com/compare/"
  />
</BaseLayout>
