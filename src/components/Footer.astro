---
// Footer.astro
const currentYear = new Date().getFullYear();

const footerLinks = {
  software: [
    { label: 'Martial Arts Software', href: '/martial-arts-software/' },
    { label: 'Dojo Management', href: '/dojo-management-software/' },
    { label: 'Karate School Software', href: '/karate-school-software/' },
    { label: 'BJJ Gym Software', href: '/bjj-gym-software/' },
    { label: 'MMA Gym Software', href: '/mma-gym-software/' },
    { label: 'Martial Arts CRM', href: '/martial-arts-crm/' },
    { label: 'Scheduling Software', href: '/martial-arts-scheduling-software/' },
    { label: 'Billing Software', href: '/martial-arts-billing-software/' },
    { label: 'Compare Platforms', href: '/compare/' },
  ],
  popular: [
    { label: 'Karate Belt Order Guide', href: '/blog/karate-belt-order-complete-guide/' },
    { label: 'Types of Martial Arts', href: '/blog/types-of-martial-arts/' },
    { label: 'Best Martial Arts Software', href: '/blog/best-martial-arts-software/' },
    { label: 'BJJ Belts Order Guide', href: '/blog/bjj-belts-order-complete-guide/' },
    { label: 'Adult Karate Classes', href: '/blog/adult-karate-classes-guide/' },
    { label: 'Martial Arts Self Defense', href: '/blog/best-martial-arts-self-defense/' },
  ],
  resources: [
    { label: 'Blog', href: '/blog/' },
    { label: 'Revenue Calculator', href: '/dojo-revenue-calculator/' },
    { label: 'Pricing', href: '/pricing/' },
    { label: 'About', href: '/about/' },
    { label: 'Contact', href: '/contact/' },
  ],
  legal: [
    { label: 'Privacy Policy', href: '/privacy-policy/' },
    { label: 'Terms of Service', href: '/terms/' },
  ]
};
---

<footer class="bg-brand-navy text-white">
  <div class="container-custom py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-12">
      <!-- Brand Column -->
      <div class="lg:col-span-1">
        <a href="/" class="inline-block mb-6">
          <img src="/logo.svg" alt="BeltManager" class="h-10 brightness-0 invert" />
        </a>
        <p class="text-gray-400 text-sm leading-relaxed mb-6">
          The complete martial arts management platform. Streamline your dojo operations with powerful scheduling, billing, and student management tools.
        </p>
        <div class="flex gap-4">
          <a href="https://www.linkedin.com/company/beltmanager" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors" aria-label="LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
            </svg>
          </a>
          <a href="https://www.facebook.com/beltmanager" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors" aria-label="Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.413c0-3.026 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.971h-1.513c-1.491 0-1.956.93-1.956 1.886v2.264h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z" />
            </svg>
          </a>
          <a href="https://www.instagram.com/beltmanager/" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors" aria-label="Instagram">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
            </svg>
          </a>
          <a href="https://www.youtube.com/@beltmanager" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors" aria-label="YouTube">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Software Links -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider mb-4">Software</h3>
        <ul class="space-y-3">
          {footerLinks.software.slice(0, 6).map((link) => (
            <li>
              <a href={link.href} class="text-gray-400 hover:text-white transition-colors text-sm">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Popular Articles -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider mb-4">Popular Articles</h3>
        <ul class="space-y-3">
          {footerLinks.popular.map((link) => (
            <li>
              <a href={link.href} class="text-gray-400 hover:text-white transition-colors text-sm">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Resources Links -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider mb-4">Resources</h3>
        <ul class="space-y-3">
          {footerLinks.resources.map((link) => (
            <li>
              <a href={link.href} class="text-gray-400 hover:text-white transition-colors text-sm">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Newsletter / CTA -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider mb-4">Get Started</h3>
        <p class="text-gray-400 text-sm mb-4">
          Ready to transform your martial arts school? BeltManager is free until 31 March 2027 — no subscription, no commission.
        </p>
        <a href="https://app.beltmanager.com/signin" class="btn-primary text-sm">
          Get started free
        </a>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-gray-800 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-gray-400 text-sm">
        &copy; {currentYear} BeltManager. All rights reserved.
      </p>
      <div class="flex gap-6">
        {footerLinks.legal.map((link) => (
          <a href={link.href} class="text-gray-400 hover:text-white transition-colors text-sm">
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
