---
import { SWITCH_GUIDES } from './guides';

interface Props {
  /** The current guide's href, left out of the list. */
  current: string;
}

const { current } = Astro.props;
const others = SWITCH_GUIDES.filter((g) => g.href !== current);
---

<section class="section bg-white">
  <div class="container-custom max-w-4xl">
    <h2 class="text-2xl font-bold text-brand-navy mb-6">Other switching guides</h2>
    <div class="grid md:grid-cols-3 gap-6">
      {others.map((g) => (
        <a href={g.href} class="card p-6 hover:shadow-lg transition-shadow group">
          <h3 class="font-bold text-brand-navy mb-2 group-hover:text-brand-red transition-colors">{g.tool}</h3>
          <p class="text-gray-600 text-sm">{g.blurb}</p>
        </a>
      ))}
    </div>
    <p class="mt-6 text-gray-700">
      <a href="/switch/" class="text-brand-red hover:underline">All switching guides</a>
    </p>
  </div>
</section>
